<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>IMDP.Infrastructure</RootNamespace>
    <AssemblyName>IMDP.Infrastructure</AssemblyName>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SqlSugarCore" Version="5.1.4.150" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="5.2.2" />
    <PackageReference Include="System.IO.Ports" Version="10.0.0" />
    <PackageReference Include="NLog" Version="5.3.4" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="System.Management" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\IMDP.Domain\IMDP.Domain.csproj" />
    <ProjectReference Include="..\IMDP.Base\IMDP.Base.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="MesServices\" />
  </ItemGroup>

  <!-- MES 交互组件（与 AutoFrock 同款 BenQGuru eMES）：构建时复制到输出目录，供 MesService 运行时动态加载 -->
  <ItemGroup>
    <None Include="BenQGuru.eMES.EqInterface.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- Iot 交互组件（与 AutoFrock 同款 vsIotMesComm）：供 MesService.GetIotMeterMesParam/GetIotMeterSimAccessNo 运行时动态加载 -->
    <None Include="vsIotMesComm.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
