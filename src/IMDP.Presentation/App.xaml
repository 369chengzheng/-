    <!-- =============================================================================
     文件名：App.xaml
     功能描述：应用程序资源字典。
               合并 MaterialDesign 主题资源，定义面包屑按钮/分隔符/当前项样式，
               定义管理页公共颜色与控件样式，并注册内置转换器。
     ============================================================================= -->
<prism:PrismApplication x:Class="IMDP.Presentation.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <Application.Resources>
        <ResourceDictionary>
            <!-- ===== 合并外部主题字典（MaterialDesign3 浅色主题 + 默认控件样式） ===== -->
            <ResourceDictionary.MergedDictionaries>
                <materialDesign:BundledTheme BaseTheme="Light"
                             PrimaryColor="Blue"
                             SecondaryColor="Lime"
                             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes" />
                <!--  HandyControl 主题（Growl 提示等自有控件所需；置于 MaterialDesign 之前，
                      保证后合并的 MaterialDesign 样式优先，不改变现有界面外观）  -->
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/SkinDefault.xaml" />
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/Theme.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign3.Defaults.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- ===== 智造检测平台公共颜色 ===== -->
            <SolidColorBrush x:Key="ImdpShellBrush" Color="#123A82"/>
            <SolidColorBrush x:Key="ImdpPageBackgroundBrush" Color="#F1F2F4"/>
            <SolidColorBrush x:Key="ImdpSurfaceBrush" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="ImdpPrimaryActionBrush" Color="#1554C5"/>
            <SolidColorBrush x:Key="ImdpDangerActionBrush" Color="#EB4D43"/>
            <SolidColorBrush x:Key="ImdpTextBrush" Color="#202938"/>
            <SolidColorBrush x:Key="ImdpMutedTextBrush" Color="#5D6878"/>
            <SolidColorBrush x:Key="ImdpBorderBrush" Color="#D5DDE8"/>
            <SolidColorBrush x:Key="ImdpAlternateRowBrush" Color="#F6F7F9"/>

            <!-- 内置 Boolean 到 Visibility 转换器（供各视图通过 Key 引用） -->
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

            <!-- 面包屑按钮样式：透明背景、无边框、悬停/按下变色 -->
            <Style x:Key="BreadcrumbButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{DynamicResource PrimaryHueMidBrush}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <TextBlock Text="{TemplateBinding Content}"
                                       SnapsToDevicePixels="True"/>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource PrimaryHueDarkBrush}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource PrimaryHueLightBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 面包屑分隔符样式：半透明、带左右间距 -->
            <Style x:Key="BreadcrumbSeparatorStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBody}"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Margin" Value="4,0,4,0"/>
                <Setter Property="Opacity" Value="0.5"/>
            </Style>

            <!-- 面包屑当前项样式：常规字重、正文颜色 -->
            <Style x:Key="BreadcrumbCurrentStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBody}"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="FontWeight" Value="Normal"/>
            </Style>

            <!-- 管理类页面的白色功能分区 -->
            <Style x:Key="ManagementSurfaceStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource ImdpSurfaceBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource ImdpBorderBrush}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
            </Style>

            <!-- 管理类页面的主要操作按钮 -->
            <Style x:Key="ManagementActionButtonStyle"
                   TargetType="Button"
                   BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Width" Value="100"/>
                <Setter Property="Height" Value="40"/>
                <Setter Property="Margin" Value="10,0,0,0"/>
                <Setter Property="Padding" Value="12,0"/>
                <Setter Property="Background" Value="{StaticResource ImdpPrimaryActionBrush}"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="FontWeight" Value="Normal"/>
            </Style>

            <!-- 删除等破坏性操作使用红色强调 -->
            <Style x:Key="ManagementDangerButtonStyle"
                   TargetType="Button"
                   BasedOn="{StaticResource ManagementActionButtonStyle}">
                <Setter Property="Background" Value="{StaticResource ImdpDangerActionBrush}"/>
            </Style>

            <!-- ===== 语义色操作按钮（产品插件页面共用）：查询=蓝 / 维护=绿 / 删除=红 ===== -->

            <!-- 语义色按钮基样式：白字、无边框、圆角、悬停加深 -->
            <Style x:Key="SemanticButtonBaseStyle" TargetType="Button">
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Padding" Value="12,0"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border
                                x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                SnapsToDevicePixels="True">
                                <ContentPresenter
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Margin="{TemplateBinding Padding}"
                                    RecognizesAccessKey="True"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.88"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.75"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 查询按钮：蓝色（主操作色） -->
            <Style x:Key="SemanticQueryButtonStyle" TargetType="Button" BasedOn="{StaticResource SemanticButtonBaseStyle}">
                <Setter Property="Background" Value="#1554C5"/>
            </Style>

            <!-- 维护/保存按钮：绿色（成功操作色） -->
            <Style x:Key="SemanticSuccessButtonStyle" TargetType="Button" BasedOn="{StaticResource SemanticButtonBaseStyle}">
                <Setter Property="Background" Value="#2E9E5B"/>
            </Style>

            <!-- 删除按钮：红色（危险操作色） -->
            <Style x:Key="SemanticDangerButtonStyle" TargetType="Button" BasedOn="{StaticResource SemanticButtonBaseStyle}">
                <Setter Property="Background" Value="#EB4D43"/>
            </Style>

            <!-- 管理类页面表格：全宽、横纵网格线和交替行底色 -->
            <Style x:Key="ManagementDataGridStyle"
                   TargetType="DataGrid"
                   BasedOn="{StaticResource {x:Type DataGrid}}">
                <Setter Property="Background" Value="{StaticResource ImdpSurfaceBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource ImdpBorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource ImdpBorderBrush}"/>
                <Setter Property="VerticalGridLinesBrush" Value="{StaticResource ImdpBorderBrush}"/>
                <Setter Property="GridLinesVisibility" Value="All"/>
                <Setter Property="HeadersVisibility" Value="Column"/>
                <Setter Property="RowBackground" Value="{StaticResource ImdpSurfaceBrush}"/>
                <Setter Property="AlternatingRowBackground" Value="{StaticResource ImdpAlternateRowBrush}"/>
                <Setter Property="MinRowHeight" Value="34"/>
                <Setter Property="ColumnHeaderHeight" Value="36"/>
                <Setter Property="CanUserAddRows" Value="False"/>
                <Setter Property="CanUserDeleteRows" Value="False"/>
                <Setter Property="IsReadOnly" Value="True"/>
                <Setter Property="SelectionMode" Value="Single"/>
                <Setter Property="AutoGenerateColumns" Value="False"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
            </Style>

            <!-- 分页按钮统一样式,原每个界面“上一页”“下一页”样式文字显示不全：各分页页面共用，尺寸调整只需修改此处 -->
            <Style x:Key="PaginationButtonStyle"
                TargetType="Button"
                BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Width" Value="75"/>
                <Setter Property="Height" Value="28"/>
                <Setter Property="Margin" Value="4,0"/>
            </Style>

            <!-- ===== 产品插件页面共享增强样式（分区标题/Kind徽章/参数行/等宽字体） ===== -->

            <!-- 分区标题行：左侧 4px 主色竖条由使用方通过内部 Border 实现，此处约束标题行排版 -->
            <Style x:Key="SectionHeaderTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="16"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Foreground" Value="{StaticResource ImdpTextBrush}"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>

            <!-- 分区标题图标：主色 18px -->
            <Style x:Key="SectionHeaderIconStyle" TargetType="materialDesign:PackIcon">
                <Setter Property="Width" Value="18"/>
                <Setter Property="Height" Value="18"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Foreground" Value="{StaticResource ImdpPrimaryActionBrush}"/>
            </Style>

            <!-- 分区标题右侧附属文本（如统计数）：次要灰字 -->
            <Style x:Key="SectionHeaderHintStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Foreground" Value="{StaticResource ImdpMutedTextBrush}"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Margin" Value="12,0,0,0"/>
            </Style>

            <!-- Kind 徽章通用基样式：小圆角 Tag -->
            <Style x:Key="KindBadgeBaseStyle" TargetType="Border">
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Padding" Value="8,2"/>
                <Setter Property="Margin" Value="0,0,8,0"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
            </Style>

            <!-- Kind 徽章文本通用基样式 -->
            <Style x:Key="KindBadgeTextBaseStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>

            <!-- Kind 徽章：范围型（蓝） -->
            <Style x:Key="KindBadgeRangeStyle" TargetType="Border" BasedOn="{StaticResource KindBadgeBaseStyle}">
                <Setter Property="Background" Value="#E3F2FD"/>
                <Setter Property="TextBlock.Foreground" Value="#1565C0"/>
            </Style>

            <!-- Kind 徽章：状态型（绿） -->
            <Style x:Key="KindBadgeStatusStyle" TargetType="Border" BasedOn="{StaticResource KindBadgeBaseStyle}">
                <Setter Property="Background" Value="#E8F5E9"/>
                <Setter Property="TextBlock.Foreground" Value="#2E7D32"/>
            </Style>

            <!-- Kind 徽章：测试方式型（橙） -->
            <Style x:Key="KindBadgeTestModeStyle" TargetType="Border" BasedOn="{StaticResource KindBadgeBaseStyle}">
                <Setter Property="Background" Value="#FFF3E0"/>
                <Setter Property="TextBlock.Foreground" Value="#E65100"/>
            </Style>

            <!-- Kind 徽章：具体值型（紫） -->
            <Style x:Key="KindBadgeValueStyle" TargetType="Border" BasedOn="{StaticResource KindBadgeBaseStyle}">
                <Setter Property="Background" Value="#F3E5F5"/>
                <Setter Property="TextBlock.Foreground" Value="#6A1B9A"/>
            </Style>

            <!-- 参数行 Border：悬停高亮；交替行底色由 ItemsControl AlternationCount + 触发器实现 -->
            <Style x:Key="ParameterRowBorderStyle" TargetType="Border">
                <Setter Property="BorderBrush" Value="{StaticResource ImdpBorderBrush}"/>
                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                <Setter Property="Padding" Value="4,6"/>
                <Setter Property="Margin" Value="4,0"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#F5F8FF"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- 参数行交替底色样式：配合 ItemsControl 的 AlternationCount=2 使用（基于 ItemsControl.AlternationIndex） -->
            <Style x:Key="ParameterRowAlternationStyle" TargetType="Border" BasedOn="{StaticResource ParameterRowBorderStyle}">
                <Style.Triggers>
                    <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                        <Setter Property="Background" Value="{StaticResource ImdpAlternateRowBrush}"/>
                    </Trigger>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#F5F8FF"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- MES 代码等宽字体：区分配置代码与普通文本 -->
            <Style x:Key="MonospaceTextStyle" TargetType="TextBox">
                <Setter Property="FontFamily" Value="Consolas"/>
                <Setter Property="FontSize" Value="13"/>
            </Style>

            <!-- 方案编辑与只读预览共用布局；组宽含末尾12间距，无参数项仅保留名称与MES列。 -->
            <GridLength x:Key="PlanNameColumnWidth">126</GridLength>
            <GridLength x:Key="PlanMesColumnWidth">80</GridLength>
            <sys:Double x:Key="PlanGroupWidth">412</sys:Double>
            <sys:Double x:Key="PlanComplexGroupWidth">824</sys:Double>
            <sys:Double x:Key="PlanCompactGroupWidth">220</sys:Double>
            <Thickness x:Key="PlanFieldSpacing">0,0,12,0</Thickness>
            <Style x:Key="PlanGroupStyle" TargetType="Grid">
                <Setter Property="Width" Value="{StaticResource PlanGroupWidth}"/>
                <Setter Property="MaxWidth" Value="{Binding ViewportWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}"/>
                <Setter Property="HorizontalAlignment" Value="Left"/>
                <Setter Property="VerticalAlignment" Value="Top"/>
            </Style>
            <Style x:Key="PlanComplexGroupStyle" TargetType="Grid" BasedOn="{StaticResource PlanGroupStyle}">
                <Setter Property="Width" Value="{StaticResource PlanComplexGroupWidth}"/>
            </Style>
            <Style x:Key="PlanCompactGroupStyle" TargetType="Grid" BasedOn="{StaticResource PlanGroupStyle}">
                <Setter Property="Width" Value="{StaticResource PlanCompactGroupWidth}"/>
            </Style>
            <Style x:Key="PlanParameterRowStyle" TargetType="Border">
                <Setter Property="Margin" Value="0,0,12,4"/>
                <Setter Property="Padding" Value="0,2"/>
                <Setter Property="MinHeight" Value="46"/>
            </Style>
            <Style x:Key="PlanFunctionCheckBoxStyle" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
                <Setter Property="Margin" Value="0,0,6,0"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="ContentTemplate">
                    <Setter.Value>
                        <DataTemplate>
                            <TextBlock Text="{Binding StringFormat={}{0}:}" TextWrapping="Wrap"/>
                        </DataTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="PlanParameterInputStyle" TargetType="TextBox" BasedOn="{StaticResource MaterialDesignFloatingHintTextBox}">
                <Setter Property="MinHeight" Value="36"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
            </Style>
            <Style x:Key="PlanParameterComboStyle" TargetType="ComboBox" BasedOn="{StaticResource MaterialDesignFloatingHintComboBox}">
                <Setter Property="MinHeight" Value="36"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="DisplayMemberPath" Value="Value"/>
                <Setter Property="SelectedValuePath" Value="Key"/>
            </Style>
            <Style x:Key="PlanParameterPasswordStyle" TargetType="PasswordBox" BasedOn="{StaticResource {x:Type PasswordBox}}">
                <Setter Property="MinHeight" Value="36"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="materialDesign:HintAssist.IsFloating" Value="True"/>
            </Style>

            <!-- 子参数显示契约：Value、Hint、InputWidth、IsChoice、Options、SelectedValue、
                 IsBoolean、IsChecked、CheckedText；仅接收显示数据，不依赖具体产品或协议。 -->
            <DataTemplate x:Key="PlanPreviewTextValueTemplate">
                <TextBox Text="{Binding Value, Mode=OneWay}" ToolTip="{Binding Value}" IsReadOnly="True"
                         Style="{StaticResource PlanParameterInputStyle}" MinHeight="22" Padding="0,0,0,4"/>
            </DataTemplate>
            <DataTemplate x:Key="PlanPreviewChoiceValueTemplate">
                <ComboBox ItemsSource="{Binding Options}" SelectedValue="{Binding SelectedValue, Mode=OneWay}"
                          Style="{StaticResource PlanParameterComboStyle}" MinHeight="22" Padding="0,0,0,4"
                          IsHitTestVisible="False" Focusable="False" IsTabStop="False" ToolTip="{Binding Value}"/>
            </DataTemplate>
            <DataTemplate x:Key="PlanPreviewBooleanValueTemplate">
                <CheckBox Content="{Binding CheckedText}" IsChecked="{Binding IsChecked, Mode=OneWay}"
                          IsHitTestVisible="False" Focusable="False" IsTabStop="False" VerticalAlignment="Center"/>
            </DataTemplate>
            <DataTemplate x:Key="PlanPreviewParameterTemplate">
                <!-- 直接使用字段定义宽度，避免绑定父容器实际宽度形成测量循环。 -->
                <Grid MinHeight="36" Width="{Binding InputWidth}" Margin="{StaticResource PlanFieldSpacing}">
                    <Grid.RowDefinitions><RowDefinition Height="14"/><RowDefinition Height="22"/></Grid.RowDefinitions>
                    <!-- 与MES字段共用固定标签位置，已选下拉值不与浮动提示重叠。 -->
                    <TextBlock Text="{Binding Hint}" FontSize="10" Foreground="{StaticResource ImdpMutedTextBrush}" VerticalAlignment="Center">
                        <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers>
                            <DataTrigger Binding="{Binding IsBoolean}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                        </Style.Triggers></Style></TextBlock.Style>
                    </TextBlock>
                    <!-- 只实例化当前参数类型的控件，避免为每个值创建三套控件后再隐藏。 -->
                    <ContentPresenter Content="{Binding}">
                        <ContentPresenter.Style>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Grid.Row" Value="1"/>
                                <Setter Property="ContentTemplate" Value="{StaticResource PlanPreviewTextValueTemplate}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsChoice}" Value="True">
                                        <Setter Property="ContentTemplate" Value="{StaticResource PlanPreviewChoiceValueTemplate}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsBoolean}" Value="True">
                                        <Setter Property="Grid.Row" Value="0"/>
                                        <Setter Property="Grid.RowSpan" Value="2"/>
                                        <Setter Property="ContentTemplate" Value="{StaticResource PlanPreviewBooleanValueTemplate}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ContentPresenter.Style>
                    </ContentPresenter>
                </Grid>
            </DataTemplate>

            <!-- 只读项目契约：Name、MesCode、Parameters（上述子参数显示数据）、IsComplex。 -->
            <DataTemplate x:Key="PlanPreviewItemTemplate">
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid" BasedOn="{StaticResource PlanGroupStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsComplex}" Value="True">
                                    <Setter Property="Width" Value="{StaticResource PlanComplexGroupWidth}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Parameters.Count}" Value="0">
                                    <Setter Property="Width" Value="{StaticResource PlanCompactGroupWidth}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Border Style="{StaticResource PlanParameterRowStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="{StaticResource PlanNameColumnWidth}"/>
                                <ColumnDefinition Width="{StaticResource PlanMesColumnWidth}"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox Style="{StaticResource PlanFunctionCheckBoxStyle}" Content="{Binding Name}" ToolTip="{Binding Name}"
                                      IsChecked="True" IsHitTestVisible="False" Focusable="False" IsTabStop="False"/>
                            <!-- 只读MES使用固定的提示位置，保持浮动提示完成后的外观。 -->
                            <Grid Grid.Column="1" Margin="0,0,12,0" VerticalAlignment="Center" MinHeight="36">
                                <Grid.RowDefinitions><RowDefinition Height="14"/><RowDefinition Height="22"/></Grid.RowDefinitions>
                                <TextBlock Text="MES码" FontSize="10" Foreground="{StaticResource ImdpMutedTextBrush}" VerticalAlignment="Center"/>
                                <TextBox Grid.Row="1" Text="{Binding MesCode, Mode=OneWay}" ToolTip="{Binding MesCode}" IsReadOnly="True">
                                    <TextBox.Style>
                                        <Style TargetType="TextBox" BasedOn="{StaticResource PlanParameterInputStyle}">
                                            <Setter Property="MinHeight" Value="22"/>
                                            <Setter Property="Padding" Value="0,0,0,4"/>
                                        </Style>
                                    </TextBox.Style>
                                </TextBox>
                            </Grid>
                            <ItemsControl Grid.Column="2" ItemsSource="{Binding Parameters}" ItemTemplate="{StaticResource PlanPreviewParameterTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </Grid>
                    </Border>
                </Grid>
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</prism:PrismApplication>
