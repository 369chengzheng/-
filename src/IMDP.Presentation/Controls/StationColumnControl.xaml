<!-- =============================================================================
     文件名：StationColumnControl.xaml
     功能描述：工位列控件 — 在板卡/整机检测界面中以单列形式展示一个工位。
               包含工位名称、串口选择、状态显示与产品 SN 扫码输入。
     ============================================================================= -->
<UserControl x:Class="IMDP.Presentation.Controls.StationColumnControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             d:DesignHeight="400" d:DesignWidth="120">
    <Border BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="1" Margin="2">
        <StackPanel>
            <!-- 工位名称 -->
            <TextBlock Text="{Binding StationName}"
                       FontWeight="Bold" FontSize="13"
                       HorizontalAlignment="Center" Margin="0,4,0,4"/>

            <!-- 串口选择下拉框 -->
            <ComboBox ItemsSource="{Binding AvailablePorts}"
                      SelectedItem="{Binding SelectedPort}"
                      materialDesign:HintAssist.Hint="串口"
                      Margin="4,0,4,4" FontSize="11"/>

            <!-- 工位状态文本（如"就绪""检测中""完成"等） -->
            <TextBlock Text="{Binding StatusDisplay}"
                       FontSize="11" HorizontalAlignment="Center" Margin="4,0,4,4"/>

            <!-- 产品 SN 扫码输入框（回车提交） -->
            <TextBox materialDesign:HintAssist.Hint="扫码SN"
                     Text="{Binding ProductSn, UpdateSourceTrigger=PropertyChanged}"
                     KeyDown="OnSnKeyDown"
                     Margin="4,0,4,4" FontSize="11"/>
        </StackPanel>
    </Border>
</UserControl>
