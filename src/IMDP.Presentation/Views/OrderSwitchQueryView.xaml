<!-- =============================================================================
     文件名：OrderSwitchQueryView.xaml
     功能描述：工单切换日志查询视图（4.17 模块）。以分页表格形式展示生产工单状态切换记录，
               支持按制令单号（模糊匹配）+ 操作员（模糊匹配）+ 操作时间范围查询，
               列字段严格参考数据库表 OrderSwitchs，并提供按操作时间正序/倒序排序切换。
     ============================================================================= -->
<UserControl x:Class="IMDP.Presentation.Views.OrderSwitchQueryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="1000"
             Background="{StaticResource ImdpPageBackgroundBrush}">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="46"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 面包屑导航区：独立白色横条 -->
        <Border Grid.Row="0"
                Margin="0,0,0,10"
                Padding="28,0"
                Style="{StaticResource ManagementSurfaceStyle}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="首页"
                        Command="{Binding GoHomeCommand}"
                        Style="{StaticResource BreadcrumbButtonStyle}"/>
                <TextBlock Margin="3,0"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource ImdpTextBrush}"
                           Text="&gt;"/>
                <TextBlock VerticalAlignment="Center"
                           Foreground="{StaticResource ImdpTextBrush}"
                           FontSize="14"
                           Text="工单切换日志查询"/>
            </StackPanel>
        </Border>

        <!-- 查询条件区：制令单号、操作员与操作日期范围 -->
        <Border Grid.Row="1"
                Margin="0,0,0,10"
                Padding="28,18"
                Style="{StaticResource ManagementSurfaceStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                    <StackPanel Margin="0,0,28,0" Orientation="Horizontal">
                        <TextBlock Width="72"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource ImdpTextBrush}"
                                   Text="制令单号："/>
                        <TextBox Width="180"
                                 Height="40"
                                 VerticalContentAlignment="Center"
                                 materialDesign:HintAssist.Hint="制令单号模糊查询"
                                 Text="{Binding OrderNumberKeyword, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,28,0" Orientation="Horizontal">
                        <TextBlock Width="60"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource ImdpTextBrush}"
                                   Text="操作员："/>
                        <TextBox Width="160"
                                 Height="40"
                                 VerticalContentAlignment="Center"
                                 materialDesign:HintAssist.Hint="操作员模糊查询"
                                 Text="{Binding OperatorKeyword, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Width="72"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource ImdpTextBrush}"
                                   Text="操作时间："/>
                        <DatePicker Width="140"
                                    Height="40"
                                    VerticalContentAlignment="Center"
                                    SelectedDate="{Binding StartTime}"/>
                        <TextBlock Margin="10,0"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource ImdpTextBrush}"
                                   Text="至"/>
                        <DatePicker Width="140"
                                    Height="40"
                                    VerticalContentAlignment="Center"
                                    SelectedDate="{Binding EndTime}"/>
                    </StackPanel>
                </WrapPanel>

                <Button Grid.Column="1"
                        Margin="30,0,0,0"
                        VerticalAlignment="Center"
                        Command="{Binding QueryCommand}"
                        Style="{StaticResource ManagementActionButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Width="18" Height="18" Margin="0,0,8,0" Kind="Magnify"/>
                        <TextBlock VerticalAlignment="Center" Text="查询"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- 工单切换记录：加载菜单可换行，因此本页使用自动行高 -->
        <Border Grid.Row="2"
                Padding="28"
                Style="{StaticResource ManagementSurfaceStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <DataGrid Grid.Row="0"
                          ItemsSource="{Binding Records}"
                          Style="{StaticResource ManagementDataGridStyle}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="制令单号" Binding="{Binding OrderNumber}" Width="11*" MinWidth="130"/>
                        <DataGridTextColumn Header="软件物料号" Binding="{Binding MaterialNumber}" Width="12*" MinWidth="140"/>
                        <DataGridTextColumn Header="加载菜单" Binding="{Binding LoadedMenusDisplay}" Width="22*" MinWidth="260">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Margin" Value="0,4"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="TextWrapping" Value="Wrap"/>
                                    <Setter Property="ToolTip" Value="{Binding LoadedMenusJson}"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="操作员" Binding="{Binding CreatedBy}" Width="8*" MinWidth="90"/>
                        <DataGridTextColumn Header="操作时间" Binding="{Binding CreatedTime, StringFormat=yyyy-MM-dd HH:mm:ss}" Width="14*" MinWidth="165"/>
                        <DataGridTextColumn Header="机器名" Binding="{Binding ComputerName}" Width="13*" MinWidth="150"/>
                        <DataGridTextColumn Header="系统用户名" Binding="{Binding UserName}" Width="10*" MinWidth="110"/>
                        <DataGridTextColumn Header="应用名称" Binding="{Binding AppName}" Width="9*" MinWidth="100"/>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- 分页仍保留原有首页/上一页/下一页/末页逻辑 -->
                <StackPanel Grid.Row="1"
                            Margin="0,16,0,0"
                            HorizontalAlignment="Left"
                            Orientation="Horizontal">
                    <TextBlock Margin="0,0,12,0" VerticalAlignment="Center">
                        <Run Text="共 "/><Run Text="{Binding TotalCount}"/><Run Text=" 条   "/>
                        <Run Text="{Binding TotalPages, Mode=OneWay}"/><Run Text=" 页   第 "/>
                        <Run Text="{Binding PageIndex}"/><Run Text=" 页"/>
                    </TextBlock>
                    <Button Content="首页" Command="{Binding FirstPageCommand}" Style="{StaticResource PaginationButtonStyle}"/>
                    <Button Content="上一页" Command="{Binding PreviousPageCommand}" Style="{StaticResource PaginationButtonStyle}"/>
                    <Button Content="下一页" Command="{Binding NextPageCommand}" Style="{StaticResource PaginationButtonStyle}"/>
                    <Button Content="末页" Command="{Binding LastPageCommand}" Style="{StaticResource PaginationButtonStyle}"/>
                    <ComboBox Width="60"
                              Height="28"
                              Margin="8,0,0,0"
                              VerticalContentAlignment="Center"
                              ItemsSource="{Binding PageSizeOptions}"
                              SelectedItem="{Binding PageSize}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
