<!--
    =============================================================================
    文件名：VersionView.xaml
    功能描述：版本迭代视图。以表格形式展示版本号、发布日期与更新内容
    （多行显示，按发布日期倒序），供用户查看版本迭代记录。
    布局采用分层卡片式：导航条、版本迭代列表各自独立白色横条，
    页面背景为浅灰色（与 UserManageView 风格一致）。
    =============================================================================
-->
<UserControl
    x:Class="IMDP.Presentation.Views.VersionView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="clr-namespace:IMDP.Presentation.ViewModels"
    d:DataContext="{d:DesignInstance Type=viewmodels:VersionViewModel}"
    d:DesignHeight="600"
    d:DesignWidth="1000"
    Background="{StaticResource ImdpPageBackgroundBrush}"
    mc:Ignorable="d">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="46" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  卡片1 导航条：首页 > 版本迭代，独立白色横条  -->
        <Border
            Grid.Row="0"
            Margin="0,0,0,10"
            Padding="28,0"
            Style="{StaticResource ManagementSurfaceStyle}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button
                    Command="{Binding GoHomeCommand}"
                    Content="首页"
                    Style="{StaticResource BreadcrumbButtonStyle}" />
                <TextBlock
                    Margin="3,0"
                    VerticalAlignment="Center"
                    Foreground="{StaticResource ImdpTextBrush}"
                    Text="&gt;" />
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="14"
                    Foreground="{StaticResource ImdpTextBrush}"
                    Text="版本迭代" />
            </StackPanel>
        </Border>

        <!--  卡片2 版本迭代列表：版本号、发布日期、更新内容（多行显示，按发布日期倒序）  -->
        <Border
            Grid.Row="1"
            Padding="28"
            Style="{StaticResource ManagementSurfaceStyle}">
            <DockPanel>
                <TextBlock
                    Margin="0,0,0,12"
                    DockPanel.Dock="Top"
                    FontSize="16"
                    FontWeight="Bold"
                    Foreground="{StaticResource ImdpTextBrush}"
                    Text="版本迭代列表" />
                <DataGrid
                    AutoGenerateColumns="False"
                    CanUserAddRows="False"
                    CanUserDeleteRows="False"
                    HeadersVisibility="Column"
                    IsReadOnly="True"
                    ItemsSource="{Binding VersionRecords}"
                    Style="{StaticResource ManagementDataGridStyle}">
                    <DataGrid.Columns>
                        <!--  版本号列：可点击，点击后触发升级更新窗口（4.2）传入目标版本号  -->
                        <DataGridTemplateColumn Width="120" Header="版本号">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button
                                        HorizontalAlignment="Left"
                                        Command="{Binding DataContext.SelectVersionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Content="{Binding Version}"
                                        Cursor="Hand"
                                        Foreground="#1976D2"
                                        Style="{StaticResource BreadcrumbButtonStyle}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn
                            Width="140"
                            Binding="{Binding ReleaseDate, StringFormat=yyyy-MM-dd}"
                            Header="发布日期" />
                        <DataGridTemplateColumn Width="*" Header="更新内容">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <!--  更新内容多行显示（ReleaseNotes 中以 \n 分隔）  -->
                                    <TextBlock
                                        Padding="4"
                                        Text="{Binding ReleaseNotes}"
                                        TextWrapping="Wrap" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
