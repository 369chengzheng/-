<!-- =============================================================================
     文件名：UpdateQueryView.xaml
     功能描述：升级日志查询视图（4.16 模块）。以分页表格形式展示应用升级记录，
               支持按版本号（模糊匹配）+ 更新内容关键词 + 升级时间范围查询，
               列字段严格参考数据库表 AppUpdateRecords，并提供导出 Excel 功能。
     ============================================================================= -->
<UserControl x:Class="IMDP.Presentation.Views.UpdateQueryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="1000"
             Background="{DynamicResource MaterialDesignPaper}">
    <DockPanel Margin="16">
        <!-- 面包屑导航区：首页 > 升级日志查询 -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
            <Button Content="首页" Style="{StaticResource BreadcrumbButtonStyle}"
                    Command="{Binding GoHomeCommand}"/>
            <materialDesign:PackIcon Kind="ChevronRight" Width="16" Height="16"
                                     Foreground="{DynamicResource MaterialDesignBody}" Opacity="0.5"/>
            <TextBlock Text="升级日志查询" Style="{StaticResource BreadcrumbCurrentStyle}"/>
        </StackPanel>
        <!-- 数据展示区：查询条件 + 升级记录列表与分页栏 -->
        <materialDesign:Card Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <!-- 查询条件区：版本号 + 更新内容关键词 + 升级时间范围 + 查询/重置/导出按钮 -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                    <TextBlock Text="版本号:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox Width="140" Height="32" Margin="0,0,16,0" VerticalContentAlignment="Center"
                             Text="{Binding VersionKeyword, UpdateSourceTrigger=PropertyChanged}"
                             materialDesign:HintAssist.Hint="版本号模糊查询"/>
                    <TextBlock Text="更新内容:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox Width="160" Height="32" Margin="0,0,16,0" VerticalContentAlignment="Center"
                             Text="{Binding ReleaseNotesKeyword, UpdateSourceTrigger=PropertyChanged}"
                             materialDesign:HintAssist.Hint="更新内容关键词"/>
                    <TextBlock Text="升级时间:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <DatePicker Width="140" Height="32" Margin="0,0,4,0" SelectedDate="{Binding StartTime}"/>
                    <TextBlock Text="至" VerticalAlignment="Center" Margin="4,0"/>
                    <DatePicker Width="140" Height="32" Margin="4,0,16,0" SelectedDate="{Binding EndTime}"/>
                    <Button Content="查询" Command="{Binding QueryCommand}" Width="80" Height="32" Margin="8,0,0,0"/>
                </StackPanel>
                <!-- 升级记录数据表格，列字段绑定至 AppUpdateRecordDto 属性 -->
                <DataGrid Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                          ItemsSource="{Binding Records}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="升级前版本号" Binding="{Binding CurrentVersion}" Width="120"/>
                        <DataGridTextColumn Header="升级后版本号" Binding="{Binding TargetVersion}" Width="120"/>
                        <DataGridTextColumn Header="更新内容" Binding="{Binding ReleaseNotes}" Width="200">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="升级状态" Binding="{Binding UpdateStatus}" Width="100"/>
                        <DataGridTextColumn Header="升级开始时间" Binding="{Binding UpdateTime, StringFormat=yyyy-MM-dd HH:mm:ss}" Width="160"/>
                        <DataGridTextColumn Header="升级完成时间" Binding="{Binding CompletedTime, StringFormat=yyyy-MM-dd HH:mm:ss}" Width="160"/>
                        <DataGridTextColumn Header="错误信息" Binding="{Binding ErrorMessage}" Width="200">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="机器名" Binding="{Binding ComputerName}" Width="140"/>
                        <DataGridTextColumn Header="系统用户名" Binding="{Binding UserName}" Width="120"/>
                        <DataGridTextColumn Header="应用名称" Binding="{Binding AppName}" Width="120"/>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- 分页栏 -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                    <TextBlock VerticalAlignment="Center" Margin="0,0,12,0">
                        <Run Text="共 "/><Run Text="{Binding TotalCount}"/><Run Text=" 条   "/>
                        <Run Text="{Binding TotalPages, Mode=OneWay}"/><Run Text=" 页   第 "/>
                        <Run Text="{Binding PageIndex}"/><Run Text=" 页"/>
                    </TextBlock>
                    <Button Content="首页" Command="{Binding FirstPageCommand}" Style="{StaticResource PaginationButtonStyle}"/>
                    <Button Content="上一页" Command="{Binding PreviousPageCommand}" Style="{StaticResource PaginationButtonStyle}"/>
                    <Button Content="下一页" Command="{Binding NextPageCommand}" Style="{StaticResource PaginationButtonStyle}"/>
                    <Button Content="末页" Command="{Binding LastPageCommand}" Style="{StaticResource PaginationButtonStyle}"/>
                    <ComboBox Width="60" Height="28" Margin="8,0,0,0" VerticalContentAlignment="Center"
                              ItemsSource="{Binding PageSizeOptions}" SelectedItem="{Binding PageSize}"/>
                </StackPanel>
            </Grid>
        </materialDesign:Card>
    </DockPanel>
</UserControl>
