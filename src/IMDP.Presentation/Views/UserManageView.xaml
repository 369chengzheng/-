<!-- =============================================================================
     文件名：UserManageView.xaml
     功能描述：用户管理视图。提供按工号/姓名/角色查询、新增、修改、删除用户等功能，
               以分页表格形式展示用户列表，仅系统管理员和管理员可见。提供面包屑导航回到首页。
     ============================================================================= -->
<UserControl x:Class="IMDP.Presentation.Views.UserManageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="1000"
             Background="{StaticResource ImdpPageBackgroundBrush}">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="46"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 面包屑导航区：独立白色横条 -->
        <Border Grid.Row="0"
                Margin="0,0,0,10"
                Padding="28,0"
                Style="{StaticResource ManagementSurfaceStyle}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="首页"
                        Command="{Binding GoHomeCommand}"
                        Style="{StaticResource BreadcrumbButtonStyle}"/>
                <TextBlock Margin="3,0"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource ImdpTextBrush}"
                           Text="&gt;"/>
                <TextBlock VerticalAlignment="Center"
                           Foreground="{StaticResource ImdpTextBrush}"
                           FontSize="14"
                           Text="用户管理"/>
            </StackPanel>
        </Border>

        <!-- 查询条件和操作按钮：较宽时同行展示，较窄时查询条件自动换行 -->
        <Border Grid.Row="1"
                Margin="0,0,0,10"
                Padding="28,18"
                Style="{StaticResource ManagementSurfaceStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                    <StackPanel Margin="0,0,28,0" Orientation="Horizontal">
                        <TextBlock Width="44"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource ImdpTextBrush}"
                                   Text="工号："/>
                        <TextBox Width="180"
                                 Height="40"
                                 VerticalContentAlignment="Center"
                                 materialDesign:HintAssist.Hint="工号"
                                 Text="{Binding WorkNumber, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,28,0" Orientation="Horizontal">
                        <TextBlock Width="44"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource ImdpTextBrush}"
                                   Text="姓名："/>
                        <TextBox Width="180"
                                 Height="40"
                                 VerticalContentAlignment="Center"
                                 materialDesign:HintAssist.Hint="姓名"
                                 Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Width="44"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource ImdpTextBrush}"
                                   Text="角色："/>
                        <ComboBox Width="140"
                                  Height="40"
                                  VerticalContentAlignment="Center"
                                  ItemsSource="{Binding RoleOptions}"
                                  SelectedItem="{Binding SelectedRole, Mode=TwoWay}"/>
                    </StackPanel>
                </WrapPanel>

                <StackPanel Grid.Column="1"
                            Margin="20,0,0,0"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                    <Button Command="{Binding QueryCommand}"
                            Style="{StaticResource ManagementActionButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Width="18" Height="18" Margin="0,0,8,0" Kind="Magnify"/>
                            <TextBlock VerticalAlignment="Center" Text="查询"/>
                        </StackPanel>
                    </Button>
                    <Button Content="维护"
                            Command="{Binding MaintainCommand}"
                            Style="{StaticResource ManagementActionButtonStyle}"/>
                    <Button Content="密码重置"
                            Command="{Binding ResetPasswordCommand}"
                            Style="{StaticResource ManagementActionButtonStyle}"/>
                    <Button Command="{Binding DeleteCommand}"
                            Style="{StaticResource ManagementDangerButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Width="18" Height="18" Margin="0,0,8,0" Kind="DeleteOutline"/>
                            <TextBlock VerticalAlignment="Center" Text="删除"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 用户列表：表格列按比例铺满，分页暂时保留原有四按钮逻辑 -->
        <Border Grid.Row="2"
                Padding="28"
                Style="{StaticResource ManagementSurfaceStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <DataGrid Grid.Row="0"
                          RowHeight="34"
                          ItemsSource="{Binding Users}"
                          SelectedItem="{Binding SelectedUser, Mode=TwoWay}"
                          Style="{StaticResource ManagementDataGridStyle}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="工号" Binding="{Binding WorkNumber}" Width="9*" MinWidth="90"/>
                        <DataGridTextColumn Header="姓名" Binding="{Binding Name}" Width="10*" MinWidth="100"/>
                        <DataGridTextColumn Header="角色" Binding="{Binding RoleDisplayName}" Width="11*" MinWidth="110"/>
                        <DataGridTextColumn Header="创建人" Binding="{Binding CreatedBy}" Width="10*" MinWidth="100"/>
                        <DataGridTextColumn Header="创建时间" Binding="{Binding CreatedTime, StringFormat=yyyy-MM-dd HH:mm}" Width="14*" MinWidth="150"/>
                        <DataGridTextColumn Header="更新人" Binding="{Binding UpdatedBy}" Width="11*" MinWidth="110"/>
                        <DataGridTextColumn Header="更新时间" Binding="{Binding UpdatedTime, StringFormat=yyyy-MM-dd HH:mm}" Width="14*" MinWidth="150"/>
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel Grid.Row="1"
                            Margin="0,16,0,0"
                            HorizontalAlignment="Left"
                            Orientation="Horizontal">
                    <TextBlock Margin="0,0,12,0" VerticalAlignment="Center">
                        <Run Text="共 "/><Run Text="{Binding TotalCount}"/><Run Text=" 条   "/>
                        <Run Text="{Binding TotalPages, Mode=OneWay}"/><Run Text=" 页   第 "/>
                        <Run Text="{Binding PageIndex}"/><Run Text=" 页"/>
                    </TextBlock>
                    <Button Content="首页" Command="{Binding FirstPageCommand}" Style="{StaticResource PaginationButtonStyle}"/>
                    <Button Content="上一页" Command="{Binding PreviousPageCommand}" Style="{StaticResource PaginationButtonStyle}"/>
                    <Button Content="下一页" Command="{Binding NextPageCommand}" Style="{StaticResource PaginationButtonStyle}"/>
                    <Button Content="末页" Command="{Binding LastPageCommand}" Style="{StaticResource PaginationButtonStyle}"/>
                    <ComboBox Width="60"
                              Height="28"
                              Margin="8,0,0,0"
                              VerticalContentAlignment="Center"
                              ItemsSource="{Binding PageSizeOptions}"
                              SelectedItem="{Binding PageSize}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
