<!-- =============================================================================
     文件名：BoardConfigHistoryView.xaml
     功能描述：模块检测方案配置历史视图
               用于展示模块（板）检测方案的配置变更历史记录，
               支持按操作类型、产品编号、操作时间、操作人等维度浏览，
               并提供分页导航能力。
     ============================================================================= -->
<UserControl x:Class="IMDP.Presentation.Views.BoardConfigHistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="1000"
             Background="{DynamicResource MaterialDesignPaper}">
    <!-- 主容器：使用 DockPanel 进行顶部面包屑 + 内容区布局 -->
    <DockPanel Margin="16">
        <!-- 面包屑导航：首页 > 模块检测方案配置历史 -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
            <Button Content="首页" Style="{StaticResource BreadcrumbButtonStyle}"
                    Command="{Binding GoHomeCommand}"/>
            <materialDesign:PackIcon Kind="ChevronRight" Width="16" Height="16"
                                     Foreground="{DynamicResource MaterialDesignBody}" Opacity="0.5"/>
            <TextBlock Text="模块检测方案配置历史" Style="{StaticResource BreadcrumbCurrentStyle}"/>
        </StackPanel>
        <!-- 内容卡片：包含查询条件、数据表格与分页栏 -->
        <materialDesign:Card Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <!-- 查询条件区：产品类别（必选）+ 产品编码 + 维护时间范围 + 查询按钮 -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                    <TextBlock Text="产品类别:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox Width="140" Height="32" Margin="0,0,16,0" VerticalContentAlignment="Center"
                              ItemsSource="{Binding ProductCategoryOptions}"
                              SelectedItem="{Binding SelectedCategory}"
                              materialDesign:HintAssist.Hint="请选择产品类别"/>
                    <TextBlock Text="产品编码:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox Width="160" Height="32" Margin="0,0,16,0" VerticalContentAlignment="Center"
                             Text="{Binding ProductCodeKeyword, UpdateSourceTrigger=PropertyChanged}"
                             materialDesign:HintAssist.Hint="产品编码模糊查询"/>
                    <TextBlock Text="维护时间:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <DatePicker Width="140" Height="32" Margin="0,0,4,0" SelectedDate="{Binding StartTime}"/>
                    <TextBlock Text="至" VerticalAlignment="Center" Margin="4,0"/>
                    <DatePicker Width="140" Height="32" Margin="4,0,16,0" SelectedDate="{Binding EndTime}"/>
                    <Button Content="查询" Command="{Binding QueryCommand}" Width="80" Height="32" Margin="8,0,0,0"/>
                </StackPanel>
                <!-- 配置历史数据列表，列字段绑定至 ViewModel 属性 -->
                <DataGrid Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="产品类别" Binding="{Binding Category}" Width="100"/>
                        <DataGridTextColumn Header="操作类型" Binding="{Binding OperationType}" Width="100"/>
                        <DataGridTextColumn Header="产品编号" Binding="{Binding ProductCode}" Width="150"/>
                        <DataGridTextColumn Header="操作时间" Binding="{Binding UpdatedTime, StringFormat=yyyy-MM-dd HH:mm}" Width="150"/>
                        <DataGridTextColumn Header="操作人" Binding="{Binding UpdatedBy}" Width="100"/>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- 分页 -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                    <TextBlock VerticalAlignment="Center" Margin="0,0,12,0">
                        <Run Text="共 "/><Run Text="{Binding TotalCount}"/><Run Text=" 条   "/>
                        <Run Text="{Binding TotalPages, Mode=OneWay}"/><Run Text=" 页   第 "/>
                        <Run Text="{Binding PageIndex}"/><Run Text=" 页"/>
                    </TextBlock>
                    <Button Content="首页" Command="{Binding FirstPageCommand}" Style="{StaticResource PaginationButtonStyle}"/>
                    <Button Content="上一页" Command="{Binding PreviousPageCommand}" Style="{StaticResource PaginationButtonStyle}"/>
                    <Button Content="下一页" Command="{Binding NextPageCommand}" Style="{StaticResource PaginationButtonStyle}"/>
                    <Button Content="末页" Command="{Binding LastPageCommand}" Style="{StaticResource PaginationButtonStyle}"/>
                    <ComboBox Width="60" Height="28" Margin="8,0,0,0" VerticalContentAlignment="Center"
                              ItemsSource="{Binding PageSizeOptions}" SelectedItem="{Binding PageSize}"/>
                </StackPanel>
            </Grid>
        </materialDesign:Card>
    </DockPanel>
</UserControl>
