<!-- =============================================================================
     文件名：LoginQueryView.xaml
     功能描述：登录日志查询视图（4.15 模块）。以分页表格形式展示用户登录记录，
               支持按工号（精确匹配）+ 登录时间范围查询，列字段严格参考数据库表 Logins。
     ============================================================================= -->
<UserControl x:Class="IMDP.Presentation.Views.LoginQueryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="1000"
             Background="{DynamicResource MaterialDesignPaper}">
    <DockPanel Margin="16">
        <!-- 面包屑导航区：首页 > 登录日志查询 -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
            <Button Content="首页" Style="{StaticResource BreadcrumbButtonStyle}"
                    Command="{Binding GoHomeCommand}"/>
            <materialDesign:PackIcon Kind="ChevronRight" Width="16" Height="16"
                                     Foreground="{DynamicResource MaterialDesignBody}" Opacity="0.5"/>
            <TextBlock Text="登录日志查询" Style="{StaticResource BreadcrumbCurrentStyle}"/>
        </StackPanel>
        <!-- 数据展示区：查询条件 + 登录记录列表与分页栏 -->
        <materialDesign:Card Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <!-- 查询条件区：工号（精确匹配）+ 登录时间范围 + 查询/重置按钮 -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                    <TextBlock Text="工号:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox Width="160" Height="32" Margin="0,0,16,0" VerticalContentAlignment="Center"
                             Text="{Binding WorkNumberKeyword, UpdateSourceTrigger=PropertyChanged}"
                             materialDesign:HintAssist.Hint="工号精确匹配"/>
                    <TextBlock Text="登录时间:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <DatePicker Width="140" Height="32" Margin="0,0,4,0" SelectedDate="{Binding StartTime}"/>
                    <TextBlock Text="至" VerticalAlignment="Center" Margin="4,0"/>
                    <DatePicker Width="140" Height="32" Margin="4,0,16,0" SelectedDate="{Binding EndTime}"/>
                    <Button Content="查询" Command="{Binding QueryCommand}" Width="80" Height="32" Margin="8,0,0,0"/>
                </StackPanel>
                <!-- 登录记录数据表格，列字段绑定至 LoginRecordDto 属性 -->
                <DataGrid Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                          ItemsSource="{Binding Records}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="工位" Binding="{Binding Station}" Width="130"/>
                        <DataGridTextColumn Header="工号" Binding="{Binding WorkNumber}" Width="120"/>
                        <DataGridTextColumn Header="IP地址" Binding="{Binding IpAddress}" Width="120"/>
                        <DataGridTextColumn Header="登录类型" Binding="{Binding LoginType}" Width="90"/>
                        <DataGridTextColumn Header="登录结果" Binding="{Binding LoginResult}" Width="90"/>
                        <DataGridTextColumn Header="失败原因" Binding="{Binding ErrorInfo}" Width="200"/>
                        <DataGridTextColumn Header="软件版本号" Binding="{Binding SoftVer}" Width="120"/>
                        <DataGridTextColumn Header="登录时间" Binding="{Binding LoginTime, StringFormat=yyyy-MM-dd HH:mm:ss}" Width="170"/>
                        <DataGridTextColumn Header="登出时间" Binding="{Binding LogoutTime, StringFormat=yyyy-MM-dd HH:mm:ss}" Width="160"/>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- 分页栏 -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                    <TextBlock VerticalAlignment="Center" Margin="0,0,12,0">
                        <Run Text="共 "/><Run Text="{Binding TotalCount}"/><Run Text=" 条   "/>
                        <Run Text="{Binding TotalPages, Mode=OneWay}"/><Run Text=" 页   第 "/>
                        <Run Text="{Binding PageIndex}"/><Run Text=" 页"/>
                    </TextBlock>
                    <Button Content="首页" Command="{Binding FirstPageCommand}" Style="{StaticResource PaginationButtonStyle}"/>
                    <Button Content="上一页" Command="{Binding PreviousPageCommand}" Style="{StaticResource PaginationButtonStyle}"/>
                    <Button Content="下一页" Command="{Binding NextPageCommand}" Style="{StaticResource PaginationButtonStyle}"/>
                    <Button Content="末页" Command="{Binding LastPageCommand}" Style="{StaticResource PaginationButtonStyle}"/>
                    <ComboBox Width="60" Height="28" Margin="8,0,0,0" VerticalContentAlignment="Center"
                              ItemsSource="{Binding PageSizeOptions}" SelectedItem="{Binding PageSize}"/>
                </StackPanel>
            </Grid>
        </materialDesign:Card>
    </DockPanel>
</UserControl>
