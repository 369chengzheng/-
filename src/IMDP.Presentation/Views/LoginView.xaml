<!--
    =============================================================================
    文件名：LoginView.xaml
    功能描述：登录视图。提供工位、工号、密码输入及离线登录选项，
    采用蓝色渐变背景与居中卡片布局，用于用户身份认证。
    =============================================================================
-->
<UserControl
    x:Class="IMDP.Presentation.Views.LoginView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="600"
    d:DesignWidth="800"
    Background="{DynamicResource MaterialDesignPaper}"
    mc:Ignorable="d">
    <Grid>
        <!--  背景：蓝色渐变画刷  -->
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Offset="0" Color="#1a237e" />
                <GradientStop Offset="0.5" Color="#0d47a1" />
                <GradientStop Offset="1" Color="#1565c0" />
            </LinearGradientBrush>
        </Grid.Background>

        <!--  登录卡片：居中显示，包含标题、输入框与按钮  -->
        <materialDesign:Card
            Width="400"
            Height="420"
            Padding="32"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">
            <StackPanel>
                <!--  标题区：系统名称  -->
                <TextBlock
                    Margin="0,0,0,8"
                    HorizontalAlignment="Center"
                    FontSize="28"
                    FontWeight="Bold"
                    Text="智造检测平台" />
                <TextBlock
                    Margin="0,0,0,32"
                    HorizontalAlignment="Center"
                    FontSize="14"
                    Foreground="{DynamicResource MaterialDesignBodyLight}"
                    Text="IMDP" />

                <!--  输入区：工位、工号、密码  -->
                <TextBox
                    Margin="0,0,0,16"
                    materialDesign:HintAssist.Hint="工位"
                    Text="{Binding Station, UpdateSourceTrigger=PropertyChanged}" />

                <TextBox
                    Margin="0,0,0,16"
                    materialDesign:HintAssist.Hint="工号"
                    Text="{Binding WorkNumber, UpdateSourceTrigger=PropertyChanged}" />

                <PasswordBox
                    Margin="0,0,0,16"
                    materialDesign:HintAssist.Hint="密码"
                    materialDesign:PasswordBoxAssist.Password="{Binding Password, UpdateSourceTrigger=PropertyChanged}" />

                <!--  离线登录选项  -->
                <CheckBox
                    Margin="0,0,0,24"
                    Content="离线登录"
                    IsChecked="{Binding IsOfflineLogin}" />

                <!--  按钮区：登录与取消  -->
                <Button
                    Height="40"
                    Margin="0,0,0,8"
                    Background="{DynamicResource PrimaryHueMidBrush}"
                    Command="{Binding LoginCommand}"
                    Content="登录"
                    IsDefault="True" />

                <Button
                    Height="36"
                    Command="{Binding CancelCommand}"
                    Content="取消" />
            </StackPanel>
        </materialDesign:Card>
    </Grid>
</UserControl>