<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      internalLogLevel="Warn"
      internalLogFile="${basedir}/Logs/nlog-internal.log">

  <!-- 公共 layout 变量（避免重复定义） -->
  <variable name="StandardLayout"
            value="${date:format=yyyy-MM-dd HH\:mm\:ss.fff} [${uppercase:${level}}] [${threadid}] [${callsite:className=true:methodName=true:skipFrame=0}] - ${message}${onexception:${newline}${exception:format=ToString}}" />

  <targets>
    <!-- 统一日志输出（含串口通信日志）：
         - 活动文件固定为 IMDP日期-1.log，当天所有日志统一写入该文件；
         - 文件超过 30MB（31457280 字节）后，旧内容改名为 IMDP日期-2.log、-3.log…归档，
           新日志继续写入 -1.log（序号越大越旧，进程重启后序号自动接续）；
         - fileName 含 ${date:format=yyyyMMdd}，跨天自动切换到新日期文件，无需 archiveEvery；
         - maxArchiveFiles=50 为单日归档上限（约 1.5GB），超出后删除最旧归档。 -->
    <target xsi:type="File"
            name="file"
            fileName="${basedir}/Logs/IMDP${date:format=yyyyMMdd}-1.log"
            archiveFileName="${basedir}/Logs/IMDP${date:format=yyyyMMdd}-{#}.log"
            archiveNumbering="Sequence"
            archiveAboveSize="31457280"
            maxArchiveFiles="50"
            layout="${StandardLayout}"
            encoding="utf-8"
            keepFileOpen="true"
            concurrentWrites="true" />
  </targets>

  <rules>
    <!-- 所有日志（含 IMDP.Infrastructure.Serial.* 串口通信日志）统一输出到同一文件 -->
    <logger name="*" minlevel="Debug" writeTo="file" />
  </rules>
</nlog>
