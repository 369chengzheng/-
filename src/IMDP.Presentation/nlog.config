<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      internalLogLevel="Warn"
      internalLogFile="${basedir}/Logs/nlog-internal.log">

  <!-- 公共 layout 变量（避免重复定义） -->
  <variable name="StandardLayout"
            value="${date:format=yyyy-MM-dd HH\:mm\:ss.fff} [${uppercase:${level}}] [${threadid}] [${callsite:className=true:methodName=true:skipFrame=0}] - ${message}${onexception:${newline}${exception:format=ToString}}" />

  <targets>
    <!-- 文件输出（按日期分割，永久保存不归档上限） -->
    <target xsi:type="File"
            name="file"
            fileName="${basedir}/Logs/log_${date:format=yyyyMMdd}.txt"
            archiveFileName="${basedir}/Logs/Archive/log_{#}.txt"
            archiveNumbering="Date"
            archiveEvery="Day"
            archiveDateFormat="yyyyMMdd"
            layout="${StandardLayout}"
            encoding="utf-8"
            keepFileOpen="true"
            concurrentWrites="true" />

    <!-- 串口通信专用日志 -->
    <target xsi:type="File"
            name="serialLog"
            fileName="${basedir}/Logs/serial_${date:format=yyyyMMdd}.txt"
            archiveFileName="${basedir}/Logs/Archive/serial_{#}.txt"
            archiveNumbering="Date"
            archiveEvery="Day"
            archiveDateFormat="yyyyMMdd"
            layout="${date:format=yyyy-MM-dd HH\:mm\:ss.fff} [${uppercase:${level}}] [${threadid}] - ${message}"
            encoding="utf-8"
            keepFileOpen="true"
            concurrentWrites="true" />
  </targets>

  <rules>
    <!-- 串口通信日志单独输出到串口日志文件 -->
    <logger name="IMDP.Infrastructure.Serial.*" minlevel="Debug" writeTo="serialLog" final="true" />

    <!-- 默认：所有日志输出到文件（不输出到控制台/数据库） -->
    <logger name="*" minlevel="Debug" writeTo="file" />
  </rules>
</nlog>
