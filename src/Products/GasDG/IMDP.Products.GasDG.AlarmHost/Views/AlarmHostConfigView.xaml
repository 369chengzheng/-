<UserControl x:Class="IMDP.Products.GasDG.AlarmHost.Views.AlarmHostConfigView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             prism:ViewModelLocator.AutoWireViewModel="True">
    <UserControl.Resources>
        <!-- 仅本插件：紧凑检测项横排，沿用平台配置页的控件和语义色。 -->
        <Style x:Key="ParameterRow" TargetType="Border">
            <Setter Property="Margin" Value="0,0,12,4"/>
            <Setter Property="Padding" Value="0,2"/>
            <Setter Property="MinHeight" Value="46"/>
        </Style>
        <Style x:Key="ParameterInput" TargetType="TextBox" BasedOn="{StaticResource MaterialDesignFloatingHintTextBox}">
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="ParameterCombo" TargetType="ComboBox" BasedOn="{StaticResource MaterialDesignFloatingHintComboBox}">
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="DisplayMemberPath" Value="Value"/>
            <Setter Property="SelectedValuePath" Value="Key"/>
        </Style>
        <Style x:Key="ParameterPassword" TargetType="PasswordBox" BasedOn="{StaticResource {x:Type PasswordBox}}">
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="materialDesign:HintAssist.IsFloating" Value="True"/>
        </Style>
        <Style x:Key="RowHint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource ImdpMutedTextBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="DraftActionButton" TargetType="Button" BasedOn="{StaticResource SemanticButtonBaseStyle}">
            <Setter Property="Width" Value="86"/><Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="0,0,8,0"/><Setter Property="FontSize" Value="12"/>
            <Setter Property="Background" Value="#EEF4FF"/><Setter Property="Foreground" Value="{StaticResource ImdpPrimaryActionBrush}"/>
        </Style>
        <Style x:Key="SchemeCellText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="ToolTip" Value="{Binding RelativeSource={RelativeSource Self}, Path=Text}"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource ImdpPageBackgroundBrush}">
        <Grid x:Name="PageRoot" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition x:Name="ParameterRowDefinition" Height="4*" MinHeight="72" MaxHeight="480"/>
                <RowDefinition Height="*" MinHeight="150"/>
            </Grid.RowDefinitions>

            <!-- 文档图四区之一：面包屑独立，不混入操作按钮。 -->
            <Border x:Name="HeaderPanel" Style="{StaticResource ManagementSurfaceStyle}" Padding="20,8" Height="46" Margin="0,0,0,10">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Button Content="首页" Command="{Binding GoHomeCommand}" Style="{StaticResource BreadcrumbButtonStyle}"/>
                    <TextBlock Grid.Column="1" Text=" > " Style="{StaticResource BreadcrumbSeparatorStyle}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="{Binding BreadcrumbTitle}" ToolTip="{Binding BreadcrumbTitle}" Style="{StaticResource BreadcrumbCurrentStyle}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- 查询区：两个方案定位字段靠左，三个原操作靠右；窄屏换到下一行。 -->
            <Border x:Name="QueryPanel" Grid.Row="1" Style="{StaticResource ManagementSurfaceStyle}" Padding="20,12" Margin="0,0,0,10">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid x:Name="QueryLayout" SizeChanged="QueryLayoutSizeChanged">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <WrapPanel x:Name="QueryFields" SizeChanged="QueryFieldsSizeChanged" VerticalAlignment="Center" IsEnabled="{Binding HasValidContext}">
                            <Grid Margin="0,0,20,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="72"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="产品编码:" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" x:Name="ProductCodeInput" Style="{StaticResource ParameterInput}" ToolTip="产品编码（必填）" Text="{Binding Draft.ProductCode, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>
                            <Grid Margin="0,0,20,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="72"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="客户编码:" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" x:Name="CustomerCodeInput" Style="{StaticResource ParameterInput}" ToolTip="客户编码（必填）" Text="{Binding Draft.CustomerCode, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>
                        </WrapPanel>
                        <StackPanel x:Name="QueryActions" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                            <Button x:Name="QueryButton" Command="{Binding QueryCommand}" Width="100" Height="44" Margin="0,0,10,0" Style="{StaticResource SemanticQueryButtonStyle}" ToolTip="{Binding PersistenceToolTip}" ToolTipService.ShowOnDisabled="True">
                                <StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="Magnify" Width="20" Height="20" Margin="0,0,8,0"/><TextBlock Text="查询" VerticalAlignment="Center"/></StackPanel>
                            </Button>
                            <Button x:Name="MaintainButton" Command="{Binding MaintainCommand}" Width="100" Height="44" Margin="0,0,10,0" Style="{StaticResource SemanticSuccessButtonStyle}" ToolTip="{Binding PersistenceToolTip}" ToolTipService.ShowOnDisabled="True">
                                <StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="WrenchOutline" Width="20" Height="20" Margin="0,0,8,0"/><TextBlock Text="维护" VerticalAlignment="Center"/></StackPanel>
                            </Button>
                            <Button x:Name="DeleteButton" Command="{Binding DeleteCommand}" Width="100" Height="44" Style="{StaticResource SemanticDangerButtonStyle}" ToolTip="{Binding PersistenceToolTip}" ToolTipService.ShowOnDisabled="True">
                                <StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="DeleteOutline" Width="20" Height="20" Margin="0,0,8,0"/><TextBlock Text="删除" VerticalAlignment="Center"/></StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                    <TextBlock x:Name="StageNoticeText" Grid.Row="1" Text="{Binding PersistenceNotice}" Foreground="#865D15" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0">
                        <TextBlock.Style><Style TargetType="TextBlock">
                            <Style.Triggers><DataTrigger Binding="{Binding PersistenceNotice}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
                        </Style></TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>

            <!-- 参数区：工位数量留在方案内，紧凑项目横排；折叠只收起参数正文。 -->
            <Border x:Name="ParameterSection" Grid.Row="2" Style="{StaticResource ManagementSurfaceStyle}" Padding="20,8" Margin="0,0,0,10" IsEnabled="{Binding HasValidContext}">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="工位数量:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox x:Name="StationCountInput" Width="70" Style="{StaticResource ParameterInput}" Text="{Binding Draft.StationCount, UpdateSourceTrigger=PropertyChanged}" ToolTip="默认 4；填写正整数，实际工位执行尚未接入"/>
                        </StackPanel>
                        <Button x:Name="ToggleParametersButton" Grid.Column="2" Command="{Binding ToggleParametersCommand}" Width="32" Height="28" Padding="4" Background="Transparent" Foreground="{StaticResource ImdpMutedTextBrush}" Style="{StaticResource SemanticButtonBaseStyle}" ToolTip="{Binding ToggleParametersToolTip}">
                            <materialDesign:PackIcon Width="20" Height="20">
                                <materialDesign:PackIcon.Style>
                                    <Style TargetType="materialDesign:PackIcon">
                                        <Setter Property="Kind" Value="ChevronUp"/>
                                        <Style.Triggers><DataTrigger Binding="{Binding IsParametersExpanded}" Value="False"><Setter Property="Kind" Value="ChevronDown"/></DataTrigger></Style.Triggers>
                                    </Style>
                                </materialDesign:PackIcon.Style>
                            </materialDesign:PackIcon>
                        </Button>
                    </Grid>
                    <Grid x:Name="ParameterPanel" Grid.Row="1" Visibility="{Binding IsParametersExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ScrollViewer x:Name="ParameterScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" ScrollChanged="ParameterScrollChanged">
                    <StackPanel>
                        <WrapPanel x:Name="SettingRows">
                            <Border Style="{StaticResource ParameterRow}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="126"/><ColumnDefinition Width="80"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <CheckBox Content="表具编号:" IsChecked="{Binding Draft.EnableMeterNumber}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBox Grid.Column="1" x:Name="MeterNumberMesInput" Style="{StaticResource ParameterInput}" materialDesign:HintAssist.Hint="MES码"
                                         Text="{Binding Draft.MeterNumberMesCode, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Draft.EnableMeterNumber}" Margin="0,0,12,0"/>
                                <Grid Grid.Column="2" IsEnabled="{Binding Draft.EnableMeterNumber}"><TextBlock Text="执行时扫码" Style="{StaticResource RowHint}"/></Grid>
                            </Grid>
                        </Border>
<Border Style="{StaticResource ParameterRow}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="126"/><ColumnDefinition Width="80"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <CheckBox Content="表具时间:" IsChecked="{Binding Draft.EnableMeterTime}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBox Grid.Column="1" x:Name="MeterTimeMesInput" Style="{StaticResource ParameterInput}" materialDesign:HintAssist.Hint="MES码"
                                         Text="{Binding Draft.MeterTimeMesCode, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Draft.EnableMeterTime}" Margin="0,0,12,0"/>
                                <Grid Grid.Column="2" IsEnabled="{Binding Draft.EnableMeterTime}"><TextBlock Text="执行时生成" Style="{StaticResource RowHint}"/></Grid>
                            </Grid>
                        </Border>
<Border Style="{StaticResource ParameterRow}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="126"/><ColumnDefinition Width="80"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <CheckBox Content="生产状态:" IsChecked="{Binding Draft.EnableProductionStatus}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBox Grid.Column="1" x:Name="ProductionStatusMesInput" Style="{StaticResource ParameterInput}" materialDesign:HintAssist.Hint="MES码"
                                         Text="{Binding Draft.ProductionStatusMesCode, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Draft.EnableProductionStatus}" Margin="0,0,12,0"/>
                                <Grid Grid.Column="2" IsEnabled="{Binding Draft.EnableProductionStatus}"><ComboBox x:Name="ProductionStatusInput" Style="{StaticResource ParameterCombo}" ItemsSource="{Binding ProductionStatusOptions}" SelectedValue="{Binding Draft.ProductionStatus}" materialDesign:HintAssist.Hint="目标状态"/></Grid>
                            </Grid>
                        </Border>
<Border Style="{StaticResource ParameterRow}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="126"/><ColumnDefinition Width="80"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <CheckBox Content="是否带阀:" IsChecked="{Binding Draft.EnableHasValve}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBox Grid.Column="1" x:Name="HasValveMesInput" Style="{StaticResource ParameterInput}" materialDesign:HintAssist.Hint="MES码"
                                         Text="{Binding Draft.HasValveMesCode, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Draft.EnableHasValve}" Margin="0,0,12,0"/>
                                <Grid Grid.Column="2" IsEnabled="{Binding Draft.EnableHasValve}"><CheckBox Content="有阀" IsChecked="{Binding Draft.HasValve}" VerticalAlignment="Center"/></Grid>
                            </Grid>
                        </Border>
<Border Style="{StaticResource ParameterRow}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="126"/><ColumnDefinition Width="80"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <CheckBox Content="寿命时间:" IsChecked="{Binding Draft.EnableLifetime}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBox Grid.Column="1" x:Name="LifetimeMesInput" Style="{StaticResource ParameterInput}" materialDesign:HintAssist.Hint="MES码"
                                         Text="{Binding Draft.LifetimeMesCode, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Draft.EnableLifetime}" Margin="0,0,12,0"/>
                                <Grid Grid.Column="2" IsEnabled="{Binding Draft.EnableLifetime}"><TextBox x:Name="LifetimeInput" Style="{StaticResource ParameterInput}" Text="{Binding Draft.LifetimeSeconds, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="秒"/></Grid>
                            </Grid>
                        </Border>
<Border Style="{StaticResource ParameterRow}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="126"/><ColumnDefinition Width="80"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <CheckBox Content="报警浓度阈值:" IsChecked="{Binding Draft.EnableAlarmThreshold}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBox Grid.Column="1" x:Name="AlarmThresholdMesInput" Style="{StaticResource ParameterInput}" materialDesign:HintAssist.Hint="MES码"
                                         Text="{Binding Draft.AlarmThresholdMesCode, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Draft.EnableAlarmThreshold}" Margin="0,0,12,0"/>
                                <Grid Grid.Column="2" IsEnabled="{Binding Draft.EnableAlarmThreshold}"><TextBox x:Name="AlarmThresholdInput" Style="{StaticResource ParameterInput}" Text="{Binding Draft.AlarmThreshold, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="%LEL"/></Grid>
                            </Grid>
                        </Border>
<Border Style="{StaticResource ParameterRow}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="126"/><ColumnDefinition Width="80"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <CheckBox Content="报警恢复阈值:" IsChecked="{Binding Draft.EnableAlarmRecoveryThreshold}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBox Grid.Column="1" x:Name="AlarmRecoveryThresholdMesInput" Style="{StaticResource ParameterInput}" materialDesign:HintAssist.Hint="MES码"
                                         Text="{Binding Draft.AlarmRecoveryThresholdMesCode, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Draft.EnableAlarmRecoveryThreshold}" Margin="0,0,12,0"/>
                                <Grid Grid.Column="2" IsEnabled="{Binding Draft.EnableAlarmRecoveryThreshold}"><TextBox Style="{StaticResource ParameterInput}" Text="{Binding Draft.AlarmRecoveryThreshold, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="%LEL"/></Grid>
                            </Grid>
                        </Border>
                        </WrapPanel>
                        <WrapPanel x:Name="ComplexRows">
                        <Border Style="{StaticResource ParameterRow}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="126"/><ColumnDefinition Width="80"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <CheckBox Content="主服务器:" IsChecked="{Binding Draft.EnableMainServer}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBox Grid.Column="1" x:Name="MainServerMesInput" Style="{StaticResource ParameterInput}" materialDesign:HintAssist.Hint="MES码"
                                         Text="{Binding Draft.MainServerMesCode, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Draft.EnableMainServer}" Margin="0,0,12,0"/>
                                <Grid Grid.Column="2" IsEnabled="{Binding Draft.EnableMainServer}"><Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions>
                                    <ComboBox Style="{StaticResource ParameterCombo}" ItemsSource="{Binding AddressTypeOptions}" SelectedValue="{Binding Draft.AddressType}" materialDesign:HintAssist.Hint="地址类型" Margin="0,0,12,0"/>
                                    <TextBox Grid.Column="1" x:Name="ServerAddressInput" Style="{StaticResource ParameterInput}" Text="{Binding Draft.ServerAddress, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="IP 或域名" Margin="0,0,12,0"/>
                                    <TextBox Grid.Column="2" Style="{StaticResource ParameterInput}" Text="{Binding Draft.ServerPort, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="端口"/>
                                </Grid></Grid>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource ParameterRow}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="126"/><ColumnDefinition Width="80"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <CheckBox Content="主卡网络:" IsChecked="{Binding Draft.EnableMainNetwork}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBox Grid.Column="1" x:Name="MainNetworkMesInput" Style="{StaticResource ParameterInput}" materialDesign:HintAssist.Hint="MES码"
                                         Text="{Binding Draft.MainNetworkMesCode, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Draft.EnableMainNetwork}" Margin="0,0,12,0"/>
                                <Grid Grid.Column="2" IsEnabled="{Binding Draft.EnableMainNetwork}"><Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBox Style="{StaticResource ParameterInput}" Text="{Binding Draft.NetworkUserName, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="网络账号" ToolTip="网络账号，与平台操作员和 Windows 用户名不同" Margin="0,0,12,0"/>
                                    <PasswordBox Grid.Column="1" x:Name="NetworkPasswordInput" PasswordChanged="NetworkPasswordChanged" Style="{StaticResource ParameterPassword}" materialDesign:HintAssist.Hint="网络密码" Margin="0,0,12,0"/>
                                    <TextBox Grid.Column="2" Style="{StaticResource ParameterInput}" Text="{Binding Draft.NetworkApn, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="APN"/>
                                </Grid></Grid>
                            </Grid>
                        </Border>
                        </WrapPanel>
                        <Border x:Name="ReportRow" Style="{StaticResource ParameterRow}" Width="{Binding ActualWidth, ElementName=ComplexRows}" MaxWidth="1100" HorizontalAlignment="Left" Margin="0,0,0,4">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="126"/><ColumnDefinition Width="80"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <CheckBox Content="主电上报:" IsChecked="{Binding Draft.EnableMainPowerReport}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBox Grid.Column="1" x:Name="MainPowerReportMesInput" Style="{StaticResource ParameterInput}" materialDesign:HintAssist.Hint="MES码"
                                         Text="{Binding Draft.MainPowerReportMesCode, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Draft.EnableMainPowerReport}" Margin="0,0,12,0"/>
                                <Grid Grid.Column="2" IsEnabled="{Binding Draft.EnableMainPowerReport}"><StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <ComboBox x:Name="ReportTypeInput" Style="{StaticResource ParameterCombo}" ItemsSource="{Binding ReportTypeOptions}" SelectedValue="{Binding Draft.ReportType}" materialDesign:HintAssist.Hint="上报类型" ToolTip="{Binding Draft.ReportHint}" Margin="0,0,12,0"/>
                                        <UniformGrid x:Name="OrdinaryReportFields" Grid.Column="1" Rows="1" Visibility="{Binding Draft.UsesOrdinarySchedule, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <TextBox Style="{StaticResource ParameterInput}" Text="{Binding Draft.ReportCycle, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="周期" Margin="0,0,8,0"/>
<TextBox Style="{StaticResource ParameterInput}" Text="{Binding Draft.ReportDay, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="日" Margin="0,0,8,0"/>
<TextBox Style="{StaticResource ParameterInput}" Text="{Binding Draft.ReportHour, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="时" Margin="0,0,8,0"/>
<TextBox Style="{StaticResource ParameterInput}" Text="{Binding Draft.ReportMinute, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="分" Margin="0,0,8,0"/>
                                        </UniformGrid>
                                        <UniformGrid x:Name="SpecifiedReportFields" Grid.Column="1" Rows="1" Visibility="{Binding Draft.UsesSpecifiedSchedule, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <TextBox Style="{StaticResource ParameterInput}" Text="{Binding Draft.Slot1, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="时段1" Margin="0,0,8,0" MaxLength="4"/>
<TextBox Style="{StaticResource ParameterInput}" Text="{Binding Draft.Slot2, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="时段2" Margin="0,0,8,0" MaxLength="4"/>
<TextBox Style="{StaticResource ParameterInput}" Text="{Binding Draft.Slot3, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="时段3" Margin="0,0,8,0" MaxLength="4"/>
<TextBox Style="{StaticResource ParameterInput}" Text="{Binding Draft.Slot4, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="时段4" Margin="0,0,8,0" MaxLength="4"/>
<TextBox Style="{StaticResource ParameterInput}" Text="{Binding Draft.Slot5, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="时段5" Margin="0,0,8,0" MaxLength="4"/>
                                        </UniformGrid>
                                    </Grid>
                                </StackPanel></Grid>
                            </Grid>
                        </Border>

                        <Border x:Name="InspectionHeader" BorderBrush="{StaticResource ImdpBorderBrush}" BorderThickness="0,1,0,0" Margin="0,8,0,8" Visibility="{Binding IsInspectionPlan, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        <WrapPanel x:Name="InspectionRows" Visibility="{Binding IsInspectionPlan, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Border Style="{StaticResource ParameterRow}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="126"/><ColumnDefinition Width="80"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <CheckBox Content="IMEI 号:" ToolTip="检验时读取" IsChecked="{Binding Draft.EnableImei}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBox Grid.Column="1" x:Name="ImeiMesInput" Style="{StaticResource ParameterInput}" materialDesign:HintAssist.Hint="MES码"
                                         Text="{Binding Draft.ImeiMesCode, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Draft.EnableImei}" Margin="0,0,12,0"/>
                            </Grid>
                        </Border>
<Border Style="{StaticResource ParameterRow}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="126"/><ColumnDefinition Width="80"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <CheckBox Content="IMSI 号:" ToolTip="检验时读取" IsChecked="{Binding Draft.EnableImsi}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBox Grid.Column="1" x:Name="ImsiMesInput" Style="{StaticResource ParameterInput}" materialDesign:HintAssist.Hint="MES码"
                                         Text="{Binding Draft.ImsiMesCode, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Draft.EnableImsi}" Margin="0,0,12,0"/>
                            </Grid>
                        </Border>
<Border Style="{StaticResource ParameterRow}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="126"/><ColumnDefinition Width="80"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <CheckBox Content="ICCID 号:" ToolTip="检验时读取" IsChecked="{Binding Draft.EnableIccid}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBox Grid.Column="1" x:Name="IccidMesInput" Style="{StaticResource ParameterInput}" materialDesign:HintAssist.Hint="MES码"
                                         Text="{Binding Draft.IccidMesCode, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Draft.EnableIccid}" Margin="0,0,12,0"/>
                            </Grid>
                        </Border>
<Border Style="{StaticResource ParameterRow}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="126"/><ColumnDefinition Width="80"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <CheckBox Content="CSQ 值:" ToolTip="检验时读取" IsChecked="{Binding Draft.EnableCsq}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBox Grid.Column="1" x:Name="CsqMesInput" Style="{StaticResource ParameterInput}" materialDesign:HintAssist.Hint="MES码"
                                         Text="{Binding Draft.CsqMesCode, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Draft.EnableCsq}" Margin="0,0,12,0"/>
                            </Grid>
                        </Border>
<Border Style="{StaticResource ParameterRow}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="126"/><ColumnDefinition Width="80"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <CheckBox Content="表具版本:" ToolTip="检验时读取" IsChecked="{Binding Draft.EnableVersion}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBox Grid.Column="1" x:Name="VersionMesInput" Style="{StaticResource ParameterInput}" materialDesign:HintAssist.Hint="MES码"
                                         Text="{Binding Draft.VersionMesCode, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Draft.EnableVersion}" Margin="0,0,12,0"/>
                            </Grid>
                        </Border>
<Border Style="{StaticResource ParameterRow}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="126"/><ColumnDefinition Width="80"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <CheckBox Content="蓝牙/星闪MAC:" ToolTip="检验时读取" IsChecked="{Binding Draft.EnableBluetoothSnOrSparkMac}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBox Grid.Column="1" x:Name="BluetoothSnOrSparkMacMesInput" Style="{StaticResource ParameterInput}" materialDesign:HintAssist.Hint="MES码"
                                         Text="{Binding Draft.BluetoothSnOrSparkMacMesCode, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Draft.EnableBluetoothSnOrSparkMac}" Margin="0,0,12,0"/>
                            </Grid>
                        </Border>
<Border Style="{StaticResource ParameterRow}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="126"/><ColumnDefinition Width="80"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <CheckBox Content="蓝牙广播检测:" ToolTip="检验时检测" IsChecked="{Binding Draft.EnableBluetoothBroadcast}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBox Grid.Column="1" x:Name="BluetoothBroadcastMesInput" Style="{StaticResource ParameterInput}" materialDesign:HintAssist.Hint="MES码"
                                         Text="{Binding Draft.BluetoothBroadcastMesCode, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Draft.EnableBluetoothBroadcast}" Margin="0,0,12,0"/>
                            </Grid>
                        </Border>
                        </WrapPanel>

                        <WrapPanel Margin="0,8,0,4">
                            <Button Content="检查输入" Command="{Binding CheckInputCommand}" ToolTip="仅检查页面输入，不保存方案或验证设备。" Style="{StaticResource DraftActionButton}"/>
                            <Button Content="重置草稿" Command="{Binding RequestResetCommand}" Style="{StaticResource DraftActionButton}"/>
                            <TextBlock x:Name="InputCheckText" Text="{Binding InputCheckMessage}" TextWrapping="Wrap" MaxWidth="850" Margin="0,4,0,4">
                                <TextBlock.Style><Style TargetType="TextBlock">
                                    <Setter Property="FontSize" Value="11"/><Setter Property="Foreground" Value="{StaticResource ImdpMutedTextBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding InputCheckMessage}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                        <DataTrigger Binding="{Binding HasInputErrors}" Value="True"><Setter Property="Foreground" Value="{StaticResource ImdpDangerActionBrush}"/></DataTrigger>
                                    </Style.Triggers>
                                </Style></TextBlock.Style>
                            </TextBlock>
                        </WrapPanel>
                        <Border Background="#FFF6E7" Padding="8" Visibility="{Binding ResetPending, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <WrapPanel>
                                <TextBlock x:Name="ResetConfirmText" Text="清空未保存输入，工位恢复为 4。是否重置？" TextWrapping="Wrap" MaxWidth="340" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <Button Content="确认重置" Command="{Binding ConfirmResetCommand}" Style="{StaticResource DraftActionButton}"/>
                                <Button Content="取消" Command="{Binding CancelResetCommand}" Style="{StaticResource DraftActionButton}"/>
                            </WrapPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
                    </Grid>
                </Grid>
            </Border>

            <!-- 各检测项独立列，含工位、完整创建/更新信息。 -->
            <Border x:Name="ListPanel" Grid.Row="3" Style="{StaticResource ManagementSurfaceStyle}" Padding="20,16">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid>
                        <ScrollViewer x:Name="SchemeHorizontalScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" ScrollChanged="SchemeScrollChanged">
                            <DataGrid x:Name="SchemeGrid" ItemsSource="{Binding CurrentPageData}" Style="{StaticResource ManagementDataGridStyle}" RowHeight="34"
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="产品编码" Binding="{Binding ProductCode}" Width="150" MinWidth="60" ElementStyle="{StaticResource SchemeCellText}"/>
<DataGridTextColumn Header="客户编码" Binding="{Binding CustomerCode}" Width="130" MinWidth="60" ElementStyle="{StaticResource SchemeCellText}"/>
<DataGridTextColumn Header="表具编号" Binding="{Binding MeterNumber}" Width="100" MinWidth="60" ElementStyle="{StaticResource SchemeCellText}"/>
<DataGridTextColumn Header="表具时间" Binding="{Binding MeterTime}" Width="100" MinWidth="60" ElementStyle="{StaticResource SchemeCellText}"/>
<DataGridTextColumn Header="生产状态" Binding="{Binding ProductionStatus}" Width="100" MinWidth="60" ElementStyle="{StaticResource SchemeCellText}"/>
<DataGridTextColumn Header="是否带阀" Binding="{Binding HasValve}" Width="90" MinWidth="60" ElementStyle="{StaticResource SchemeCellText}"/>
<DataGridTextColumn Header="寿命时间" Binding="{Binding Lifetime}" Width="130" MinWidth="60" ElementStyle="{StaticResource SchemeCellText}"/>
<DataGridTextColumn Header="报警阈值" Binding="{Binding AlarmThreshold}" Width="100" MinWidth="60" ElementStyle="{StaticResource SchemeCellText}"/>
<DataGridTextColumn Header="恢复阈值" Binding="{Binding AlarmRecoveryThreshold}" Width="100" MinWidth="60" ElementStyle="{StaticResource SchemeCellText}"/>
<DataGridTextColumn Header="主服务器" Binding="{Binding MainServer}" Width="220" MinWidth="60" ElementStyle="{StaticResource SchemeCellText}"/>
<DataGridTextColumn Header="主卡网络" Binding="{Binding MainNetwork}" Width="180" MinWidth="60" ElementStyle="{StaticResource SchemeCellText}"/>
<DataGridTextColumn Header="主电上报" Binding="{Binding MainPowerReport}" Width="250" MinWidth="60" ElementStyle="{StaticResource SchemeCellText}"/>
<DataGridTextColumn x:Name="ImeiColumn" Header="IMEI" Binding="{Binding Imei}" Width="90" MinWidth="60" ElementStyle="{StaticResource SchemeCellText}"/>
<DataGridTextColumn x:Name="ImsiColumn" Header="IMSI" Binding="{Binding Imsi}" Width="90" MinWidth="60" ElementStyle="{StaticResource SchemeCellText}"/>
<DataGridTextColumn x:Name="IccidColumn" Header="ICCID" Binding="{Binding Iccid}" Width="90" MinWidth="60" ElementStyle="{StaticResource SchemeCellText}"/>
<DataGridTextColumn x:Name="CsqColumn" Header="CSQ" Binding="{Binding Csq}" Width="80" MinWidth="60" ElementStyle="{StaticResource SchemeCellText}"/>
<DataGridTextColumn x:Name="VersionColumn" Header="表具版本" Binding="{Binding Version}" Width="100" MinWidth="60" ElementStyle="{StaticResource SchemeCellText}"/>
<DataGridTextColumn x:Name="BluetoothSnOrSparkMacColumn" Header="蓝牙/星闪MAC" Binding="{Binding BluetoothSnOrSparkMac}" Width="140" MinWidth="60" ElementStyle="{StaticResource SchemeCellText}"/>
<DataGridTextColumn x:Name="BluetoothBroadcastColumn" Header="蓝牙广播" Binding="{Binding BluetoothBroadcast}" Width="100" MinWidth="60" ElementStyle="{StaticResource SchemeCellText}"/>
<DataGridTextColumn Header="工位数量" Binding="{Binding StationCount}" Width="85" MinWidth="60" ElementStyle="{StaticResource SchemeCellText}"/>
<DataGridTextColumn Header="创建人" Binding="{Binding CreatedBy}" Width="95" MinWidth="60" ElementStyle="{StaticResource SchemeCellText}"/>
<DataGridTextColumn Header="创建时间" Binding="{Binding CreatedTime, StringFormat=yyyy-MM-dd HH:mm}" Width="160" MinWidth="60" ElementStyle="{StaticResource SchemeCellText}"/>
<DataGridTextColumn Header="更新人" Binding="{Binding UpdatedBy}" Width="95" MinWidth="60" ElementStyle="{StaticResource SchemeCellText}"/>
<DataGridTextColumn Header="更新时间" Binding="{Binding UpdatedTime, StringFormat=yyyy-MM-dd HH:mm}" Width="160" MinWidth="60" ElementStyle="{StaticResource SchemeCellText}"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </ScrollViewer>
                        <TextBlock Text="暂无数据" IsHitTestVisible="False" TextWrapping="Wrap" Margin="12,42,12,8" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="{StaticResource ImdpMutedTextBrush}"/>
                    </Grid>
                    <WrapPanel x:Name="PaginationPanel" Grid.Row="1" Margin="0,10,0,0" HorizontalAlignment="Left">
                        <TextBlock Margin="0,0,12,4" VerticalAlignment="Center">
                            <Run Text="共 "/><Run Text="{Binding TotalCount, Mode=OneWay}"/><Run Text=" 条   "/><Run Text="{Binding TotalPages, Mode=OneWay}"/><Run Text=" 页   第 "/><Run Text="{Binding PageIndex, Mode=OneWay}"/><Run Text=" 页"/>
                        </TextBlock>
                        <Button Content="首页" Command="{Binding PageCommand}" Style="{StaticResource PaginationButtonStyle}"/>
                        <Button Content="上一页" Command="{Binding PageCommand}" Style="{StaticResource PaginationButtonStyle}"/>
                        <Button Content="下一页" Command="{Binding PageCommand}" Style="{StaticResource PaginationButtonStyle}"/>
                        <Button Content="末页" Command="{Binding PageCommand}" Style="{StaticResource PaginationButtonStyle}"/>
                        <ComboBox Width="60" Height="28" Margin="8,0,0,0" ItemsSource="{Binding PageSizeOptions}" SelectedItem="{Binding PageSize}"/>
                    </WrapPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
