<UserControl x:Class="IMDP.Products.GasDG.AlarmHost.Views.AlarmHostConfigView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:models="clr-namespace:IMDP.Products.GasDG.AlarmHost.Models"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             prism:ViewModelLocator.AutoWireViewModel="True">
    <UserControl.Resources>
        <!-- 页面操作、列表样式及无参数项模板；尺寸继续复用公共方案资源。 -->
        <Style x:Key="DraftActionButton" TargetType="Button" BasedOn="{StaticResource SemanticButtonBaseStyle}">
            <Setter Property="Width" Value="86"/><Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="0,0,8,0"/><Setter Property="FontSize" Value="12"/>
            <Setter Property="Background" Value="#EEF4FF"/><Setter Property="Foreground" Value="{StaticResource ImdpPrimaryActionBrush}"/>
        </Style>
        <Style x:Key="SchemeCellText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="ToolTip" Value="{Binding RelativeSource={RelativeSource Self}, Path=Text}"/>
        </Style>
        <DataTemplate x:Key="NoParameterItemTemplate">
            <Grid Style="{StaticResource PlanCompactGroupStyle}">
                <Border Style="{StaticResource PlanParameterRowStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="{StaticResource PlanNameColumnWidth}"/><ColumnDefinition Width="{StaticResource PlanMesColumnWidth}"/></Grid.ColumnDefinitions>
                        <CheckBox Style="{StaticResource PlanFunctionCheckBoxStyle}" Content="{Binding Name}" IsChecked="{Binding IsEnabled}"/>
                        <TextBox Grid.Column="1" x:Name="MesInput" Style="{StaticResource PlanParameterInputStyle}" materialDesign:HintAssist.Hint="MES码"
                                 Text="{Binding MesCode, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsEnabled}" Margin="0,0,12,0"/>
                    </Grid>
                </Border>
            </Grid>
        </DataTemplate>
        <!-- 普通参数只维护一份模板，直接编辑当前草稿的公共DTO值。 -->
        <DataTemplate x:Key="ParameterTextValueTemplate">
            <TextBox MinHeight="22" Padding="0,0,0,4" Style="{StaticResource PlanParameterInputStyle}"
                     Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"/>
        </DataTemplate>
        <DataTemplate x:Key="ParameterChoiceValueTemplate">
            <ComboBox MinHeight="22" Padding="0,0,0,4" Style="{StaticResource PlanParameterComboStyle}"
                      ItemsSource="{Binding Options}" SelectedValue="{Binding ByteValue}"/>
        </DataTemplate>
        <DataTemplate x:Key="ParameterBooleanValueTemplate">
            <CheckBox Content="{Binding CheckedText}" IsChecked="{Binding BooleanValue}" VerticalAlignment="Center"/>
        </DataTemplate>
        <DataTemplate x:Key="ParameterValueTemplate">
            <Grid Width="{Binding InputWidth}" MinHeight="36" Margin="{StaticResource PlanFieldSpacing}">
                <Grid.RowDefinitions><RowDefinition Height="14"/><RowDefinition Height="22"/></Grid.RowDefinitions>
                <TextBlock Text="{Binding InputHint}" FontSize="10" Foreground="{StaticResource ImdpMutedTextBrush}" VerticalAlignment="Center">
                    <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers>
                        <DataTrigger Binding="{Binding IsBoolean}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                    </Style.Triggers></Style></TextBlock.Style>
                </TextBlock>
                <!-- 与只读预览相同，每个参数只实例化当前类型的编辑控件。 -->
                <ContentPresenter Content="{Binding}">
                    <ContentPresenter.Style>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Grid.Row" Value="1"/>
                            <Setter Property="ContentTemplate" Value="{StaticResource ParameterTextValueTemplate}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsChoice}" Value="True"><Setter Property="ContentTemplate" Value="{StaticResource ParameterChoiceValueTemplate}"/></DataTrigger>
                                <DataTrigger Binding="{Binding IsBoolean}" Value="True">
                                    <Setter Property="Grid.Row" Value="0"/><Setter Property="Grid.RowSpan" Value="2"/>
                                    <Setter Property="ContentTemplate" Value="{StaticResource ParameterBooleanValueTemplate}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ContentPresenter.Style>
                </ContentPresenter>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="CommonParameterItemTemplate">
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid" BasedOn="{StaticResource PlanGroupStyle}">
                        <Style.Triggers><DataTrigger Binding="{Binding IsComplex}" Value="True"><Setter Property="Width" Value="{StaticResource PlanComplexGroupWidth}"/></DataTrigger></Style.Triggers>
                    </Style>
                </Grid.Style>
                <Border Style="{StaticResource PlanParameterRowStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="{StaticResource PlanNameColumnWidth}"/><ColumnDefinition Width="{StaticResource PlanMesColumnWidth}"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <CheckBox Style="{StaticResource PlanFunctionCheckBoxStyle}" Content="{Binding Name}" IsChecked="{Binding IsEnabled}"/>
                        <TextBox Grid.Column="1" x:Name="MesInput" Style="{StaticResource PlanParameterInputStyle}" materialDesign:HintAssist.Hint="MES码"
                                 Text="{Binding MesCode, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsEnabled}" Margin="0,0,12,0"/>
                        <ItemsControl Grid.Column="2" ItemsSource="{Binding Values.Values}" ItemTemplate="{StaticResource ParameterValueTemplate}" IsEnabled="{Binding IsEnabled}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </Grid>
                </Border>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="MainServerParameterTemplate">
            <Grid Style="{StaticResource PlanComplexGroupStyle}" DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}">
                <Border Style="{StaticResource PlanParameterRowStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="{StaticResource PlanNameColumnWidth}"/><ColumnDefinition Width="{StaticResource PlanMesColumnWidth}"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <CheckBox Style="{StaticResource PlanFunctionCheckBoxStyle}" Content="{Binding Draft.Items[MainServer].Name}" IsChecked="{Binding Draft.Items[MainServer].IsEnabled}"/>
                        <TextBox Grid.Column="1" x:Name="MainServerMesInput" Style="{StaticResource PlanParameterInputStyle}" materialDesign:HintAssist.Hint="MES码"
                                 Text="{Binding Draft.Items[MainServer].MesCode, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Draft.Items[MainServer].IsEnabled}" Margin="0,0,12,0"/>
                        <WrapPanel Grid.Column="2" IsEnabled="{Binding Draft.Items[MainServer].IsEnabled}">
                            <ComboBox Width="{Binding Draft.Items[MainServer].Values[AddressType].InputWidth}" Style="{StaticResource PlanParameterComboStyle}" ItemsSource="{Binding Draft.Items[MainServer].Values[AddressType].Options}" SelectedValue="{Binding Draft.Items[MainServer].Values[AddressType].ByteValue}" materialDesign:HintAssist.Hint="{Binding Draft.Items[MainServer].Values[AddressType].InputHint}" Margin="{StaticResource PlanFieldSpacing}"/>
                            <TextBox x:Name="ServerAddressInput" Width="{Binding Draft.Items[MainServer].Values[Address].InputWidth}" Style="{StaticResource PlanParameterInputStyle}" Text="{Binding Draft.Items[MainServer].Values[Address].Value, UpdateSourceTrigger=PropertyChanged}" ToolTip="IP 或域名" materialDesign:HintAssist.Hint="{Binding Draft.Items[MainServer].Values[Address].InputHint}" Margin="{StaticResource PlanFieldSpacing}"/>
                            <TextBox Width="{Binding Draft.Items[MainServer].Values[Port].InputWidth}" Style="{StaticResource PlanParameterInputStyle}" Text="{Binding Draft.Items[MainServer].Values[Port].Value, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="{Binding Draft.Items[MainServer].Values[Port].InputHint}" Margin="{StaticResource PlanFieldSpacing}"/>
                        </WrapPanel>
                    </Grid>
                </Border>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="MainNetworkParameterTemplate">
            <Grid Style="{StaticResource PlanComplexGroupStyle}" DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}">
                <Border Style="{StaticResource PlanParameterRowStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="{StaticResource PlanNameColumnWidth}"/><ColumnDefinition Width="{StaticResource PlanMesColumnWidth}"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <CheckBox Style="{StaticResource PlanFunctionCheckBoxStyle}" Content="{Binding Draft.Items[MainNetwork].Name}" IsChecked="{Binding Draft.Items[MainNetwork].IsEnabled}"/>
                        <TextBox Grid.Column="1" x:Name="MainNetworkMesInput" Style="{StaticResource PlanParameterInputStyle}" materialDesign:HintAssist.Hint="MES码"
                                 Text="{Binding Draft.Items[MainNetwork].MesCode, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Draft.Items[MainNetwork].IsEnabled}" Margin="0,0,12,0"/>
                        <WrapPanel Grid.Column="2" IsEnabled="{Binding Draft.Items[MainNetwork].IsEnabled}">
                            <TextBox Width="{Binding Draft.Items[MainNetwork].Values[UserName].InputWidth}" Style="{StaticResource PlanParameterInputStyle}" Text="{Binding Draft.Items[MainNetwork].Values[UserName].Value, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="{Binding Draft.Items[MainNetwork].Values[UserName].InputHint}" ToolTip="网络账号，与平台操作员和 Windows 用户名不同" Margin="{StaticResource PlanFieldSpacing}"/>
                            <PasswordBox x:Name="NetworkPasswordInput" Width="{Binding Draft.Items[MainNetwork].Values[Password].InputWidth}" PasswordChanged="NetworkPasswordChanged" Loaded="NetworkPasswordLoaded" Unloaded="NetworkPasswordUnloaded" Style="{StaticResource PlanParameterPasswordStyle}" materialDesign:HintAssist.Hint="{Binding Draft.Items[MainNetwork].Values[Password].InputHint}" Margin="{StaticResource PlanFieldSpacing}"/>
                            <TextBox Width="{Binding Draft.Items[MainNetwork].Values[Apn].InputWidth}" Style="{StaticResource PlanParameterInputStyle}" Text="{Binding Draft.Items[MainNetwork].Values[Apn].Value, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="{Binding Draft.Items[MainNetwork].Values[Apn].InputHint}" Margin="{StaticResource PlanFieldSpacing}"/>
                        </WrapPanel>
                    </Grid>
                </Border>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="MainPowerReportParameterTemplate">
            <Grid Style="{StaticResource PlanComplexGroupStyle}" DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}">
                <Border x:Name="ReportRow" Style="{StaticResource PlanParameterRowStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="{StaticResource PlanNameColumnWidth}"/><ColumnDefinition Width="{StaticResource PlanMesColumnWidth}"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <CheckBox Style="{StaticResource PlanFunctionCheckBoxStyle}" Content="{Binding Draft.Items[MainPowerReport].Name}" IsChecked="{Binding Draft.Items[MainPowerReport].IsEnabled}"/>
                        <TextBox Grid.Column="1" x:Name="MainPowerReportMesInput" Style="{StaticResource PlanParameterInputStyle}" materialDesign:HintAssist.Hint="MES码"
                                 Text="{Binding Draft.Items[MainPowerReport].MesCode, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Draft.Items[MainPowerReport].IsEnabled}" Margin="0,0,12,0"/>
                        <!-- 类型与当前分支字段共用一行，宽度不足时按字段自然换行。 -->
                        <WrapPanel x:Name="ReportFields" Grid.Column="2" IsEnabled="{Binding Draft.Items[MainPowerReport].IsEnabled}">
                            <WrapPanel.Resources>
                                <Style x:Key="OrdinaryReportInputStyle" TargetType="TextBox" BasedOn="{StaticResource PlanParameterInputStyle}">
                                    <Setter Property="Visibility" Value="{Binding Draft.UsesOrdinarySchedule, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                </Style>
                                <Style x:Key="SpecifiedReportInputStyle" TargetType="TextBox" BasedOn="{StaticResource PlanParameterInputStyle}">
                                    <Setter Property="Visibility" Value="{Binding Draft.UsesSpecifiedSchedule, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    <Setter Property="materialDesign:TextFieldAssist.CharacterCounterVisibility" Value="Collapsed"/>
                                </Style>
                            </WrapPanel.Resources>
                            <ComboBox x:Name="ReportTypeInput" Width="{Binding Draft.Items[MainPowerReport].Values[Type].InputWidth}" HorizontalAlignment="Left" Style="{StaticResource PlanParameterComboStyle}" ItemsSource="{Binding Draft.Items[MainPowerReport].Values[Type].Options}" SelectedValue="{Binding Draft.Items[MainPowerReport].Values[Type].ByteValue}" materialDesign:HintAssist.Hint="{Binding Draft.Items[MainPowerReport].Values[Type].InputHint}" ToolTip="{Binding Draft.ReportHint}" Margin="{StaticResource PlanFieldSpacing}"/>
                            <TextBox Width="{Binding Draft.Items[MainPowerReport].Values[Cycle].InputWidth}" Style="{StaticResource OrdinaryReportInputStyle}" Text="{Binding Draft.Items[MainPowerReport].Values[Cycle].Value, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="{Binding Draft.Items[MainPowerReport].Values[Cycle].InputHint}" Margin="{StaticResource PlanFieldSpacing}"/>
                            <TextBox Width="{Binding Draft.Items[MainPowerReport].Values[Day].InputWidth}" Style="{StaticResource OrdinaryReportInputStyle}" Text="{Binding Draft.Items[MainPowerReport].Values[Day].Value, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="{Binding Draft.Items[MainPowerReport].Values[Day].InputHint}" Margin="{StaticResource PlanFieldSpacing}"/>
                            <TextBox Width="{Binding Draft.Items[MainPowerReport].Values[Hour].InputWidth}" Style="{StaticResource OrdinaryReportInputStyle}" Text="{Binding Draft.Items[MainPowerReport].Values[Hour].Value, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="{Binding Draft.Items[MainPowerReport].Values[Hour].InputHint}" Margin="{StaticResource PlanFieldSpacing}"/>
                            <TextBox Width="{Binding Draft.Items[MainPowerReport].Values[Minute].InputWidth}" Style="{StaticResource OrdinaryReportInputStyle}" Text="{Binding Draft.Items[MainPowerReport].Values[Minute].Value, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="{Binding Draft.Items[MainPowerReport].Values[Minute].InputHint}" Margin="{StaticResource PlanFieldSpacing}"/>
                            <TextBox Width="{Binding Draft.Items[MainPowerReport].Values[Slot1].InputWidth}" Style="{StaticResource SpecifiedReportInputStyle}" Text="{Binding Draft.Items[MainPowerReport].Values[Slot1].Value, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="{Binding Draft.Items[MainPowerReport].Values[Slot1].InputHint}" Margin="{StaticResource PlanFieldSpacing}" MaxLength="4"/>
                            <TextBox Width="{Binding Draft.Items[MainPowerReport].Values[Slot2].InputWidth}" Style="{StaticResource SpecifiedReportInputStyle}" Text="{Binding Draft.Items[MainPowerReport].Values[Slot2].Value, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="{Binding Draft.Items[MainPowerReport].Values[Slot2].InputHint}" Margin="{StaticResource PlanFieldSpacing}" MaxLength="4"/>
                            <TextBox Width="{Binding Draft.Items[MainPowerReport].Values[Slot3].InputWidth}" Style="{StaticResource SpecifiedReportInputStyle}" Text="{Binding Draft.Items[MainPowerReport].Values[Slot3].Value, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="{Binding Draft.Items[MainPowerReport].Values[Slot3].InputHint}" Margin="{StaticResource PlanFieldSpacing}" MaxLength="4"/>
                            <TextBox Width="{Binding Draft.Items[MainPowerReport].Values[Slot4].InputWidth}" Style="{StaticResource SpecifiedReportInputStyle}" Text="{Binding Draft.Items[MainPowerReport].Values[Slot4].Value, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="{Binding Draft.Items[MainPowerReport].Values[Slot4].InputHint}" Margin="{StaticResource PlanFieldSpacing}" MaxLength="4"/>
                            <TextBox Width="{Binding Draft.Items[MainPowerReport].Values[Slot5].InputWidth}" Style="{StaticResource SpecifiedReportInputStyle}" Text="{Binding Draft.Items[MainPowerReport].Values[Slot5].Value, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="{Binding Draft.Items[MainPowerReport].Values[Slot5].InputHint}" Margin="{StaticResource PlanFieldSpacing}" MaxLength="4"/>
                        </WrapPanel>
                    </Grid>
                </Border>
            </Grid>
        </DataTemplate>
        <!-- 页面只为三个复杂交互选用专用模板，模型保持统一目录及顺序。 -->
        <DataTemplate x:Key="ParameterEditorTemplate">
            <ContentControl Content="{Binding}">
                <ContentControl.Style>
                    <Style TargetType="ContentControl">
                        <Setter Property="ContentTemplate" Value="{StaticResource CommonParameterItemTemplate}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Code}" Value="{x:Static models:AlarmHostFunctionCatalog.MainServer}">
                                <Setter Property="ContentTemplate" Value="{StaticResource MainServerParameterTemplate}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Code}" Value="{x:Static models:AlarmHostFunctionCatalog.MainNetwork}">
                                <Setter Property="ContentTemplate" Value="{StaticResource MainNetworkParameterTemplate}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Code}" Value="{x:Static models:AlarmHostFunctionCatalog.MainPowerReport}">
                                <Setter Property="ContentTemplate" Value="{StaticResource MainPowerReportParameterTemplate}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ContentControl.Style>
            </ContentControl>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Background="{StaticResource ImdpPageBackgroundBrush}">
        <Grid x:Name="PageRoot" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition x:Name="ParameterRowDefinition" Height="4*" MinHeight="130"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition x:Name="ListRowDefinition" Height="*" MinHeight="180"/>
            </Grid.RowDefinitions>

            <!-- 文档图四区之一：面包屑独立，不混入操作按钮。 -->
            <Border x:Name="HeaderPanel" Style="{StaticResource ManagementSurfaceStyle}" Padding="20,8" Height="46" Margin="0,0,0,10">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Button Content="首页" Command="{Binding GoHomeCommand}" Style="{StaticResource BreadcrumbButtonStyle}"/>
                    <TextBlock Grid.Column="1" Text=" > " Style="{StaticResource BreadcrumbSeparatorStyle}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="{Binding BreadcrumbTitle}" ToolTip="{Binding BreadcrumbTitle}" Style="{StaticResource BreadcrumbCurrentStyle}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- 查询区：两个方案定位字段靠左，三个原操作靠右；窄屏换到下一行。 -->
            <Border x:Name="QueryPanel" Grid.Row="1" Style="{StaticResource ManagementSurfaceStyle}" Padding="20,12" Margin="0,0,0,10">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid x:Name="QueryLayout" SizeChanged="QueryLayoutSizeChanged">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <WrapPanel x:Name="QueryFields" VerticalAlignment="Center" IsEnabled="{Binding CanEdit}">
                            <Grid Width="380" MaxWidth="{Binding ActualWidth, ElementName=QueryFields}" Margin="0,0,20,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="72"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="产品编码:" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" x:Name="ProductCodeInput" Style="{StaticResource PlanParameterInputStyle}" ToolTip="查询可留空或填写产品编码关键字；维护时必填" Text="{Binding Draft.ProductCode, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>
                            <Grid Width="380" MaxWidth="{Binding ActualWidth, ElementName=QueryFields}" Margin="0,0,20,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="72"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="客户编码:" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" x:Name="CustomerCodeInput" Style="{StaticResource PlanParameterInputStyle}" ToolTip="查询可留空或填写客户编码关键字；维护时必填" Text="{Binding Draft.CustomerCode, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>
                        </WrapPanel>
                        <StackPanel x:Name="QueryActions" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                            <Button x:Name="QueryButton" Command="{Binding QueryCommand}" Width="100" Height="44" Margin="0,0,10,0" Style="{StaticResource SemanticQueryButtonStyle}">
                                <StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="Magnify" Width="20" Height="20" Margin="0,0,8,0"/><TextBlock Text="查询" VerticalAlignment="Center"/></StackPanel>
                            </Button>
                            <Button x:Name="MaintainButton" Command="{Binding MaintainCommand}" Width="100" Height="44" Margin="0,0,10,0" Style="{StaticResource SemanticSuccessButtonStyle}">
                                <StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="WrenchOutline" Width="20" Height="20" Margin="0,0,8,0"/><TextBlock Text="维护" VerticalAlignment="Center"/></StackPanel>
                            </Button>
                            <Button x:Name="DeleteButton" Command="{Binding DeleteCommand}" Width="100" Height="44" Style="{StaticResource SemanticDangerButtonStyle}">
                                <StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="DeleteOutline" Width="20" Height="20" Margin="0,0,8,0"/><TextBlock Text="删除" VerticalAlignment="Center"/></StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                    <TextBlock x:Name="StageNoticeText" Grid.Row="1" Text="{Binding PersistenceNotice}" Foreground="#865D15" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0">
                        <TextBlock.Style><Style TargetType="TextBlock">
                            <Style.Triggers><DataTrigger Binding="{Binding PersistenceNotice}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
                        </Style></TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>

            <!-- 参数区：固定基准组宽、窄窗组内换行；折叠始终独立于编辑状态。 -->
            <Border x:Name="ParameterSection" Grid.Row="2" Style="{StaticResource ManagementSurfaceStyle}" Padding="20,8">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="方案参数" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        <Button x:Name="ToggleParametersButton" Grid.Column="2" Command="{Binding ToggleParametersCommand}" Width="32" Height="28" Padding="4" Background="Transparent" Foreground="{StaticResource ImdpMutedTextBrush}" Style="{StaticResource SemanticButtonBaseStyle}" ToolTip="{Binding ToggleParametersToolTip}">
                            <materialDesign:PackIcon Width="20" Height="20">
                                <materialDesign:PackIcon.Style>
                                    <Style TargetType="materialDesign:PackIcon">
                                        <Setter Property="Kind" Value="ChevronUp"/>
                                        <Style.Triggers><DataTrigger Binding="{Binding IsParametersExpanded}" Value="False"><Setter Property="Kind" Value="ChevronDown"/></DataTrigger></Style.Triggers>
                                    </Style>
                                </materialDesign:PackIcon.Style>
                            </materialDesign:PackIcon>
                        </Button>
                    </Grid>
                    <Grid x:Name="ParameterPanel" Grid.Row="1" Visibility="{Binding IsParametersExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ScrollViewer x:Name="ParameterScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="ParameterEditors" IsEnabled="{Binding CanEdit}">
                        <!-- 有参数项目按目录顺序共用换行区域，普通项与复杂项允许同排。 -->
                        <ItemsControl x:Name="ParameterRows" ItemsSource="{Binding Draft.ParameterItems}" ItemTemplate="{StaticResource ParameterEditorTemplate}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        </ItemsControl>
                        <Border x:Name="NoParameterHeader" BorderBrush="{StaticResource ImdpBorderBrush}" BorderThickness="0,1,0,0" Margin="0,8,0,8"/>
                        <ItemsControl x:Name="NoParameterRows" ItemsSource="{Binding Draft.NoParameterItems}" ItemTemplate="{StaticResource NoParameterItemTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>

                        <Border BorderBrush="{StaticResource ImdpBorderBrush}" BorderThickness="0,1,0,0" Margin="0,12,0,8"/>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="{StaticResource PlanNameColumnWidth}"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="工位数量:" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" x:Name="StationCountInput" Width="70" HorizontalAlignment="Left" Style="{StaticResource PlanParameterInputStyle}" Text="{Binding Draft.StationCount, UpdateSourceTrigger=PropertyChanged}" ToolTip="填写正整数，执行页面按此数量生成工位"/>
                        </Grid>

                        <WrapPanel Margin="0,8,0,4">
                            <Button Content="重置草稿" Command="{Binding RequestResetCommand}" Style="{StaticResource DraftActionButton}"/>
                        </WrapPanel>
                        <Border Background="#FFF6E7" Padding="8" Visibility="{Binding ResetPending, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <WrapPanel>
                                <TextBlock x:Name="ResetConfirmText" Text="清空未保存输入，工位恢复为 4。是否重置？" TextWrapping="Wrap" MaxWidth="340" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <Button Content="确认重置" Command="{Binding ConfirmResetCommand}" Style="{StaticResource DraftActionButton}"/>
                                <Button Content="取消" Command="{Binding CancelResetCommand}" Style="{StaticResource DraftActionButton}"/>
                            </WrapPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
                    </Grid>
                </Grid>
            </Border>

            <!-- 原生分界线约束上下行最小高度，参数区收起时一并隐藏。 -->
            <GridSplitter x:Name="ParameterListSplitter" Grid.Row="3" Height="6"
                          HorizontalAlignment="Stretch" VerticalAlignment="Center"
                          ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" ShowsPreview="False"
                          Cursor="SizeNS" ToolTip="上下拖动，调整参数区与方案列表高度"
                          Visibility="{Binding IsParametersExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
                <GridSplitter.Style>
                    <Style TargetType="GridSplitter">
                        <Setter Property="Background" Value="{StaticResource ImdpBorderBrush}"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource ImdpPrimaryActionBrush}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </GridSplitter.Style>
            </GridSplitter>

            <!-- 各检测项独立列，含工位、完整创建/更新信息。 -->
            <Border x:Name="ListPanel" Grid.Row="4" Style="{StaticResource ManagementSurfaceStyle}" Padding="20,16">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid>
                        <ScrollViewer x:Name="SchemeHorizontalScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" ScrollChanged="SchemeScrollChanged">
                            <DataGrid x:Name="SchemeGrid" ItemsSource="{Binding CurrentPageData}" SelectedItem="{Binding SelectedPlan, Mode=TwoWay}" SelectionMode="Single"
                                      IsEnabled="{Binding CanEdit}" Style="{StaticResource ManagementDataGridStyle}" RowHeight="34"
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <DataGrid.Columns>
