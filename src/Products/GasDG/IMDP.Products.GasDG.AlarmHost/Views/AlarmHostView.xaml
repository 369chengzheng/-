<UserControl x:Class="IMDP.Products.GasDG.AlarmHost.Views.AlarmHostView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="True"
             Background="{StaticResource ImdpPageBackgroundBrush}">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Margin="0,0,0,10" Padding="28,14"
                Style="{StaticResource ManagementSurfaceStyle}">
            <DockPanel>
                <Button Content="首页" Command="{Binding GoHomeCommand}"
                        VerticalAlignment="Center"
                        Style="{StaticResource BreadcrumbButtonStyle}"/>
                <TextBlock Text="&gt;" Margin="5,0" VerticalAlignment="Center"
                           Foreground="{StaticResource ImdpMutedTextBrush}"/>
                <TextBlock Text="{Binding BreadcrumbTitle}" TextWrapping="Wrap"
                           FontSize="14" VerticalAlignment="Center"
                           Foreground="{StaticResource ImdpTextBrush}"/>
            </DockPanel>
        </Border>

        <Border Grid.Row="1" Padding="28,24"
                Style="{StaticResource ManagementSurfaceStyle}">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock Text="{Binding PageTitle}" FontSize="22"
                               FontWeight="SemiBold" TextWrapping="Wrap"
                               Foreground="{StaticResource ImdpTextBrush}"/>
                    <TextBlock Text="{Binding Description}" Margin="0,12,0,24"
                               FontSize="14" TextWrapping="Wrap"
                               Foreground="{StaticResource ImdpMutedTextBrush}"/>

                    <TextBlock Text="软件物料号" FontSize="13"
                               Foreground="{StaticResource ImdpMutedTextBrush}"/>
                    <TextBlock Text="{Binding MaterialNumberDisplay}" Margin="0,6,0,16"
                               FontSize="16" TextWrapping="Wrap"
                               Foreground="{StaticResource ImdpTextBrush}"/>
                    <TextBlock Text="插件标识" FontSize="13"
                               Foreground="{StaticResource ImdpMutedTextBrush}"/>
                    <TextBlock Text="{Binding ProductKey}" Margin="0,6,0,24"
                               FontSize="14" TextWrapping="Wrap"
                               Foreground="{StaticResource ImdpTextBrush}"/>

                    <Border Padding="18" Background="#FFF7E6"
                            BorderBrush="#F0D59B" BorderThickness="1" CornerRadius="4">
                        <StackPanel>
                            <TextBlock Text="{Binding StatusText}" FontSize="17"
                                       FontWeight="SemiBold" Foreground="#946200"
                                       TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding StageNotice}" Margin="0,8,0,0"
                                       FontSize="14" Foreground="#72572A"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
