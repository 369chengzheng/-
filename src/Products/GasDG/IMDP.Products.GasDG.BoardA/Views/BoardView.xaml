<UserControl x:Class="IMDP.Products.GasDG.BoardA.Views.BoardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:local="clr-namespace:IMDP.Products.GasDG.BoardA.Views"
             prism:ViewModelLocator.AutoWireViewModel="True"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="1200"
             Background="{DynamicResource MaterialDesignPaper}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <local:InverseBooleanConverter x:Key="InverseBooleanConverter"/>
    </UserControl.Resources>
    <DockPanel Margin="16">
        <!-- 面包屑 + 工具栏 -->
        <Grid DockPanel.Dock="Top" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="首页" Style="{StaticResource BreadcrumbButtonStyle}"
                        Command="{Binding GoHomeCommand}"/>
                <materialDesign:PackIcon Kind="ChevronRight" Width="16" Height="16"
                                         Foreground="{DynamicResource MaterialDesignBody}" Opacity="0.5">
                    <materialDesign:PackIcon.Style>
                        <Style TargetType="materialDesign:PackIcon">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentMaterialNumber}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </materialDesign:PackIcon.Style>
                </materialDesign:PackIcon>
                <TextBlock Text="{Binding CurrentMaterialNumber}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource BreadcrumbCurrentStyle}">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentMaterialNumber}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <materialDesign:PackIcon Kind="ChevronRight" Width="16" Height="16" 
                                         Foreground="{DynamicResource MaterialDesignBody}" Opacity="0.5"/>
                <TextBlock Text="模块检测" Style="{StaticResource BreadcrumbCurrentStyle}"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock Text="产品编码:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox Text="{Binding ProductCode, UpdateSourceTrigger=PropertyChanged}"
                         Width="150" Margin="0,0,8,0"/>
                <Button Content="查询" Command="{Binding QueryCommand}" Width="60" Height="28" Margin="0,0,8,0"/>
                <Button Content="打开串口" Command="{Binding OpenPortCommand}" Width="80" Height="28" Margin="0,0,8,0"/>
                <Button Content="关闭串口" Command="{Binding ClosePortCommand}" Width="80" Height="28" Margin="0,0,8,0"/>
                <Button Content="显示/隐藏方案" Command="{Binding ToggleSchemeCommand}" Width="110" Height="28" Margin="0,0,8,0"/>
                <TextBlock Text="采样间隔(ms):" VerticalAlignment="Center" Margin="8,0,4,0"/>
                <TextBox Text="{Binding TimerInterval, UpdateSourceTrigger=PropertyChanged}"
                         Width="60" Margin="0,0,8,0" VerticalContentAlignment="Center"/>
                <Button Content="开始模拟" Command="{Binding StartSimulationCommand}" Width="80" Height="28" Margin="0,0,8,0"
                        IsEnabled="{Binding IsSimulating, Converter={StaticResource InverseBooleanConverter}}"/>
                <Button Content="停止模拟" Command="{Binding StopSimulationCommand}" Width="80" Height="28" Margin="0,0,8,0"
                        IsEnabled="{Binding IsSimulating}"/>
                <Button Command="{Binding OpenSettingsCommand}" Width="32" Height="32" Padding="0"
                        Background="Transparent" BorderThickness="0">
                    <materialDesign:PackIcon Kind="Settings" Width="24" Height="24"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- 检测方案显示区（只读） -->
        <materialDesign:Card DockPanel.Dock="Top" Padding="16" Margin="0,0,0,16"
                             Visibility="{Binding IsSchemeVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel>
                <TextBlock Text="检测方案" FontWeight="Bold" Margin="0,0,0,8"/>
                <ItemsControl ItemsSource="{Binding SchemeParameters}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{DynamicResource MaterialDesignDivider}" 
                                    BorderThickness="1" Padding="6" Margin="3">
                                <StackPanel Orientation="Horizontal">
                                    <CheckBox IsChecked="{Binding IsEnabled}" IsEnabled="False" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" Margin="6,0"/>
                                    <TextBlock Text="值:" VerticalAlignment="Center" Margin="6,0,2,0"/>
                                    <TextBlock Text="{Binding Value}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </materialDesign:Card>

        <!-- 工位列表区：包含特殊行 + 数据行 -->
        <materialDesign:Card Padding="0">
            <DockPanel>
                <!-- 数据行 DataGrid（动态工位列） -->
                <DataGrid x:Name="DetectionDataGrid" AutoGenerateColumns="False" IsReadOnly="False"
                          HeadersVisibility="Column"
                          CanUserAddRows="False"
                          ItemsSource="{Binding DetectionRows}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="序号" Binding="{Binding Order}" Width="60" IsReadOnly="True"/>
                        <DataGridTextColumn Header="参数名称" Binding="{Binding ParameterName}" Width="150" IsReadOnly="True"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </materialDesign:Card>
    </DockPanel>
</UserControl>
