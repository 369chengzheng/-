<UserControl x:Class="IMDP.Products.GasDG.BoardA.Views.BoardConfigView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="True"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="1200"
             Background="{DynamicResource MaterialDesignPaper}">
    <DockPanel Margin="16">
        <!-- 面包屑：首页 > 软件物料号 > 模块检测方案配置 -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,16">
            <Button Content="首页" Style="{StaticResource BreadcrumbButtonStyle}"
                    Command="{Binding GoHomeCommand}"/>
            <materialDesign:PackIcon Kind="ChevronRight" Width="16" Height="16"
                                     Foreground="{DynamicResource MaterialDesignBody}" Opacity="0.5">
                <materialDesign:PackIcon.Style>
                    <Style TargetType="materialDesign:PackIcon">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentMaterialNumber}" Value="">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </materialDesign:PackIcon.Style>
            </materialDesign:PackIcon>
            <TextBlock Text="{Binding CurrentMaterialNumber}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource BreadcrumbCurrentStyle}">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentMaterialNumber}" Value="">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <materialDesign:PackIcon Kind="ChevronRight" Width="16" Height="16"
                                     Foreground="{DynamicResource MaterialDesignBody}" Opacity="0.5"/>
            <TextBlock Text="模块检测方案配置" Style="{StaticResource BreadcrumbCurrentStyle}"/>
        </StackPanel>

        <!-- 顶部工具栏 -->
        <Grid DockPanel.Dock="Top" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="产品编码:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox Grid.Column="1" materialDesign:HintAssist.Hint="产品编码"
                     Text="{Binding ProductCode, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,0,16,0"/>

            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="查询" Command="{Binding QueryCommand}" Width="80" Height="32" Margin="0,0,8,0"/>
                <Button Content="维护" Command="{Binding SaveCommand}" Width="80" Height="32" Margin="0,0,8,0"/>
                <Button Content="删除" Command="{Binding DeleteCommand}" Width="80" Height="32"/>
            </StackPanel>
        </Grid>

        <!-- 参数配置区 -->
        <materialDesign:Card DockPanel.Dock="Top" Padding="16" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="参数配置区" FontWeight="Bold" Margin="0,0,0,12"/>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <TextBlock Text="工位数量:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox Text="{Binding StationCount, UpdateSourceTrigger=PropertyChanged}"
                             Width="60" Margin="0,0,16,0"/>
                </StackPanel>

                <!-- 8 个参数项 WrapPanel 布局 -->
                <ItemsControl ItemsSource="{Binding Parameters}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{DynamicResource MaterialDesignDivider}" 
                                    BorderThickness="1" Padding="8" Margin="4">
                                <StackPanel Orientation="Horizontal">
                                    <CheckBox IsChecked="{Binding IsEnabled}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" 
                                               Width="110" Margin="8,0,8,0"/>
                                    <TextBlock Text="MES代码:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <TextBox Text="{Binding MesCode, UpdateSourceTrigger=PropertyChanged}" 
                                             Width="80" Margin="0,0,8,0"
                                             ToolTip="{Binding Code, StringFormat='系统识别码: {0}'}"/>
                                    <TextBlock Text="值:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <TextBox Text="{Binding Parameters[0].Value, UpdateSourceTrigger=PropertyChanged}" Width="120"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </materialDesign:Card>

        <!-- 方案列表 -->
        <materialDesign:Card Padding="8">
            <DataGrid AutoGenerateColumns="False" IsReadOnly="True" 
                      SelectionMode="Single"
                      ItemsSource="{Binding Plans}"
                      SelectedItem="{Binding SelectedPlan}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="产品编码" Binding="{Binding ProductCode}" Width="120"/>
                    <DataGridTextColumn Header="IP地址/端口" Binding="{Binding Parameters[0].Parameters[0].Value}" Width="150"/>
                    <DataGridTextColumn Header="闲置天数" Binding="{Binding Parameters[1].Parameters[0].Value}" Width="80"/>
                    <DataGridTextColumn Header="表具规格" Binding="{Binding Parameters[2].Parameters[0].Value}" Width="80"/>
                    <DataGridTextColumn Header="域名/端口" Binding="{Binding Parameters[3].Parameters[0].Value}" Width="150"/>
                    <DataGridTextColumn Header="一级不通讯天数" Binding="{Binding Parameters[4].Parameters[0].Value}" Width="120"/>
                    <DataGridTextColumn Header="一级不用气天数" Binding="{Binding Parameters[5].Parameters[0].Value}" Width="120"/>
                    <DataGridTextColumn Header="大流阈值" Binding="{Binding Parameters[6].Parameters[0].Value}" Width="80"/>
                    <DataGridTextColumn Header="小流阈值" Binding="{Binding Parameters[7].Parameters[0].Value}" Width="80"/>
                    <DataGridTextColumn Header="工位" Binding="{Binding StationCount}" Width="60"/>
                    <DataGridTextColumn Header="创建人" Binding="{Binding CreatedBy}" Width="80"/>
                    <DataGridTextColumn Header="创建时间" Binding="{Binding CreatedTime, StringFormat=yyyy-MM-dd HH:mm}" Width="150"/>
                    <DataGridTextColumn Header="更新人" Binding="{Binding UpdatedBy}" Width="80"/>
                    <DataGridTextColumn Header="更新时间" Binding="{Binding UpdatedTime, StringFormat=yyyy-MM-dd HH:mm}" Width="150"/>
                </DataGrid.Columns>
            </DataGrid>
        </materialDesign:Card>
    </DockPanel>
</UserControl>
