<!--
    =============================================================================
    文件名：LaserDetectorConfigView.xaml
    功能描述：激光检测仪方案配置视图（原 LaserDetectorView 更名而来）。
    布局为自上而下四行分层卡片式（页面背景浅灰色）：
      Row0 面包屑导航：首页 > 物料编码(CurrentMaterialNumber，为空自动隐藏) > 当前页面名；
      Row1 操作条：左侧产品编码输入框（回车/空格/失焦加载方案），
                   右侧查询/维护/删除/折叠箭头四个操作按钮；
      Row2 产品配置：无 GroupBox 分区，统一 WrapPanel 陈列，每项一个固定宽度(420)
                   横向 StackPanel = 配置名(CheckBox) + MES代码输入框 + 可选参数区
                   （参数值/下拉框/配置区间），同一配置项的参数与 MES 代码合并陈列；
                   条目按输入控件数量由多到少排序：范围型(3输入) > 下拉型/值型(2输入)
                   > 状态型(1输入)，工位数量、最大测试时间作为全局项固定排在最后方；
                   未勾选配置项时其输入控件置灰禁用（IsEnabled 单向绑定 IsEnabled）；
      Row3 产品预览：方案列表 DataGrid + 分页栏。
    保留 Ctrl+鼠标滚轮整体缩放（0.5~3.0）与产品配置面板折叠/展开交互。
    =============================================================================
-->
<UserControl
    x:Class="IMDP.Products.GasDG.LaserDetector.Views.LaserDetectorConfigView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="clr-namespace:IMDP.Products.GasDG.LaserDetector.Views.Behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="clr-namespace:IMDP.Products.GasDG.LaserDetector.Models"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:viewmodels="clr-namespace:IMDP.Products.GasDG.LaserDetector.ViewModels"
    d:DataContext="{d:DesignInstance Type=viewmodels:LaserDetectorConfigViewModel}"
    d:DesignHeight="900"
    d:DesignWidth="1920"
    prism:ViewModelLocator.AutoWireViewModel="True"
    Background="{StaticResource ImdpPageBackgroundBrush}"
    FontFamily="{DynamicResource MaterialDesignFont}"
    mc:Ignorable="d">
    <UserControl.Resources>
        <!--  隐式样式：文本左对齐垂直居中  -->
        <Style TargetType="TextBlock">
            <Setter Property="TextAlignment" Value="Left" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
        <!--  输入框统一使用 MaterialDesign 浮动提示样式  -->
        <Style BasedOn="{StaticResource MaterialDesignFloatingHintTextBox}" TargetType="TextBox">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
        </Style>
        <!--  下拉框统一使用 MaterialDesign 浮动提示样式  -->
        <Style BasedOn="{StaticResource MaterialDesignFloatingHintComboBox}" TargetType="ComboBox">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!--  测试方式下拉选项（有源/无源共用）  -->
        <x:Array x:Key="TestModeOptions" Type="models:ConfigModeOption">
            <models:ConfigModeOption Display="01-仅测试输出功能" Value="01" />
            <models:ConfigModeOption Display="02-测试输入和输出功能" Value="02" />
        </x:Array>
    </UserControl.Resources>

    <!--
        根 Grid：面包屑与操作条固定顶部不随内容滚动（保证查询等操作按钮始终可见）；
        下方内容区（产品配置 + 产品预览）独立纵向滚动并支持 Ctrl+滚轮缩放
    -->
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Row0 面包屑导航：独立白色横条（首页 > 物料编码 > 当前页面名）  -->
        <Border
            Grid.Row="0"
            Margin="0,0,0,10"
            Padding="28,8"
            Style="{StaticResource ManagementSurfaceStyle}">
            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                <Button
                    Command="{Binding GoHomeCommand}"
                    Content="首页"
                    Style="{StaticResource BreadcrumbButtonStyle}" />
                <TextBlock Style="{StaticResource BreadcrumbSeparatorStyle}" Text="&gt;" />
                <!--  物料编码段：编码为空时整段隐藏（连同其后分隔符）  -->
                <StackPanel Orientation="Horizontal">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentMaterialNumber}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Style="{StaticResource BreadcrumbCurrentStyle}" Text="{Binding CurrentMaterialNumber}" />
                    <TextBlock Style="{StaticResource BreadcrumbSeparatorStyle}" Text="&gt;" />
                </StackPanel>
                <TextBlock Style="{StaticResource BreadcrumbCurrentStyle}" Text="激光检测仪方案配置" />
            </StackPanel>
        </Border>

        <!--  Row1 操作条：独立白色横条（左：产品编码；右：查询/维护/删除/折叠箭头）  -->
        <Border
            Grid.Row="1"
            Margin="0,0,0,10"
            Padding="28,8"
            Style="{StaticResource ManagementSurfaceStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!--  左：产品编码（回车/空格（KeyBinding）与失焦（附加行为）均触发按编码加载方案）  -->
                <StackPanel
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <TextBlock Margin="0,0,8,0" Text="产品编码:" />
                    <TextBox
                        Width="200"
                        behaviors:LostFocus.Command="{Binding LoadByCodeCommand}"
                        Text="{Binding ProductCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding LoadByCodeCommand}" />
                            <KeyBinding Key="Space" Command="{Binding LoadByCodeCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                </StackPanel>

                <!--  右：查询/维护/删除/折叠箭头  -->
                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <Button
                        Width="90"
                        Height="40"
                        Margin="5,0"
                        Command="{Binding QueryCommand}"
                        Content="查询"
                        Style="{StaticResource SemanticQueryButtonStyle}" />
                    <Button
                        Width="90"
                        Height="40"
                        Margin="5,0"
                        Command="{Binding SaveCommand}"
                        Content="维护"
                        Style="{StaticResource SemanticSuccessButtonStyle}" />
                    <Button
                        Width="90"
                        Height="40"
                        Margin="5,0"
                        Command="{Binding DeleteCommand}"
                        Content="删除"
                        Style="{StaticResource SemanticDangerButtonStyle}" />
                    <!--  折叠产品配置面板  -->
                    <Button
                        x:Name="ButtonCloseMenu"
                        Width="90"
                        Height="40"
                        Margin="5,0"
                        Click="ButtonCloseMenu_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border
                                    x:Name="Bd"
                                    Background="#05b790"
                                    CornerRadius="10">
                                    <materialDesign:PackIcon
                                        Width="25"
                                        Height="25"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Foreground="White"
                                        Kind="ArrowUp" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Opacity" Value="0.88" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <!--  展开产品配置面板（默认隐藏）  -->
                    <Button
                        x:Name="ButtonOpenMenu"
                        Width="90"
                        Height="40"
                        Margin="5,0"
                        Click="ButtonOpenMenu_Click"
                        Visibility="Collapsed">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border
                                    x:Name="Bd"
                                    Background="#05b790"
                                    CornerRadius="10">
                                    <materialDesign:PackIcon
                                        Width="25"
                                        Height="25"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Foreground="White"
                                        Kind="ArrowDown" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Opacity" Value="0.88" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer
            x:Name="RootScrollViewer"
            Grid.Row="2"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <!--
                横向滚动禁用：内容宽度始终约束为视口宽，WrapPanel 按实际可用宽度自动换行，
                任何屏幕/窗口尺寸下都不会出现横向滚动条（Ctrl+滚轮放大时自动重排换行）。
            -->
            <Grid>
                <Grid.LayoutTransform>
                    <ScaleTransform x:Name="ScaleTransform" ScaleX="1" ScaleY="1" />
                </Grid.LayoutTransform>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" MinHeight="180" />
                </Grid.RowDefinitions>

                <!--
                    Row2 产品配置：独立白色横条。
                    不再用 GroupBox 区分参数配置与 MES 代码，统一 WrapPanel 陈列；
                    每个 StackPanel 固定 Width=420（内部控件宽度亦固定），保证换行后
                    各行各列严格对齐；每项 = 配置名(CheckBox) + MES代码框 + 可选参数区
                    （范围型：下限~上限 / 下拉型：测试方式 / 值型：参数值 / 状态型：无参数区）；
                    未勾选时该配置项的输入控件整体置灰禁用（IsEnabled 单向绑定）；
                    工位数量、最大测试时间为全局项（无勾选框、无 MES 框）固定排在最后方。
                -->
                <Border
                    x:Name="GridMenu"
                    Grid.Row="0"
                    Margin="0,0,0,10"
                    Padding="20,12"
                    Style="{StaticResource ManagementSurfaceStyle}">
                    <WrapPanel>

                        <!-- ========== 范围型（索引 0~7）：配置名 + MES代码 + 下限~上限 ========== -->
                        <StackPanel
                            Width="420"
                            Margin="0,4,12,4"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                            <CheckBox
                                Width="130"
                                Margin="0,0,8,0"
                                Content="12V电压:"
                                IsChecked="{Binding Parameters[0].IsEnabled, Mode=TwoWay}" />
                            <TextBox
                                Width="110"
                                Margin="0,0,4,0"
                                IsEnabled="{Binding Parameters[0].IsEnabled, Mode=OneWay}"
                                materialDesign:HintAssist.Hint="MES代码"
                                Text="{Binding Parameters[0].MesCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBox
                                Width="60"
                                Margin="0,0,4,0"
                                IsEnabled="{Binding Parameters[0].IsEnabled, Mode=OneWay}"
                                materialDesign:HintAssist.Hint="下限"
                                Text="{Binding Parameters[0].Parameters[1].Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Margin="0,0,4,0" Text="~" />
                            <TextBox
                                Width="60"
                                IsEnabled="{Binding Parameters[0].IsEnabled, Mode=OneWay}"
                                materialDesign:HintAssist.Hint="上限"
                                Text="{Binding Parameters[0].Parameters[2].Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel
                            Width="420"
                            Margin="0,4,12,4"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                            <CheckBox
                                Width="130"
                                Margin="0,0,8,0"
                                Content="8V电压:"
                                IsChecked="{Binding Parameters[1].IsEnabled, Mode=TwoWay}" />
                            <TextBox
                                Width="110"
                                Margin="0,0,4,0"
                                IsEnabled="{Binding Parameters[1].IsEnabled, Mode=OneWay}"
                                materialDesign:HintAssist.Hint="MES代码"
                                Text="{Binding Parameters[1].MesCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBox
                                Width="60"
                                Margin="0,0,4,0"
                                IsEnabled="{Binding Parameters[1].IsEnabled, Mode=OneWay}"
                                materialDesign:HintAssist.Hint="下限"
                                Text="{Binding Parameters[1].Parameters[1].Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Margin="0,0,4,0" Text="~" />
                            <TextBox
                                Width="60"
                                IsEnabled="{Binding Parameters[1].IsEnabled, Mode=OneWay}"
                                materialDesign:HintAssist.Hint="上限"
                                Text="{Binding Parameters[1].Parameters[2].Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel
                            Width="420"
                            Margin="0,4,12,4"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                            <CheckBox
                                Width="130"
                                Margin="0,0,8,0"
                                Content="主电5V电压:"
                                IsChecked="{Binding Parameters[2].IsEnabled, Mode=TwoWay}" />
                            <TextBox
                                Width="110"
                                Margin="0,0,4,0"
                                IsEnabled="{Binding Parameters[2].IsEnabled, Mode=OneWay}"
                                materialDesign:HintAssist.Hint="MES代码"
                                Text="{Binding Parameters[2].MesCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBox
                                Width="60"
                                Margin="0,0,4,0"
                                IsEnabled="{Binding Parameters[2].IsEnabled, Mode=OneWay}"
                                materialDesign:HintAssist.Hint="下限"
                                Text="{Binding Parameters[2].Parameters[1].Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Margin="0,0,4,0" Text="~" />
                            <TextBox
                                Width="60"
                                IsEnabled="{Binding Parameters[2].IsEnabled, Mode=OneWay}"
                                materialDesign:HintAssist.Hint="上限"
                                Text="{Binding Parameters[2].Parameters[2].Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel
                            Width="420"
                            Margin="0,4,12,4"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                            <CheckBox
                                Width="130"
                                Margin="0,0,8,0"
                                Content="甲烷5V电压:"
                                IsChecked="{Binding Parameters[3].IsEnabled, Mode=TwoWay}" />
                            <TextBox
                                Width="110"
                                Margin="0,0,4,0"
                                IsEnabled="{Binding Parameters[3].IsEnabled, Mode=OneWay}"
                                materialDesign:HintAssist.Hint="MES代码"
                                Text="{Binding Parameters[3].MesCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBox
                                Width="60"
                                Margin="0,0,4,0"
                                IsEnabled="{Binding Parameters[3].IsEnabled, Mode=OneWay}"
                                materialDesign:HintAssist.Hint="下限"
                                Text="{Binding Parameters[3].Parameters[1].Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Margin="0,0,4,0" Text="~" />
                            <TextBox
                                Width="60"
                                IsEnabled="{Binding Parameters[3].IsEnabled, Mode=OneWay}"
                                materialDesign:HintAssist.Hint="上限"
                                Text="{Binding Parameters[3].Parameters[2].Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel
                            Width="420"
                            Margin="0,4,12,4"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                            <CheckBox
                                Width="130"
                                Margin="0,0,8,0"
                                Content="3.8V电压:"
                                IsChecked="{Binding Parameters[4].IsEnabled, Mode=TwoWay}" />
                            <TextBox
                                Width="110"
                                Margin="0,0,4,0"
                                IsEnabled="{Binding Parameters[4].IsEnabled, Mode=OneWay}"
                                materialDesign:HintAssist.Hint="MES代码"
                                Text="{Binding Parameters[4].MesCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBox
                                Width="60"
                                Margin="0,0,4,0"
                                IsEnabled="{Binding Parameters[4].IsEnabled, Mode=OneWay}"
                                materialDesign:HintAssist.Hint="下限"
                                Text="{Binding Parameters[4].Parameters[1].Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Margin="0,0,4,0" Text="~" />
                            <TextBox
                                Width="60"
                                IsEnabled="{Binding Parameters[4].IsEnabled, Mode=OneWay}"
                                materialDesign:HintAssist.Hint="上限"
                                Text="{Binding Parameters[4].Parameters[2].Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel
                            Width="420"
                            Margin="0,4,12,4"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                            <CheckBox
                                Width="130"
                                Margin="0,0,8,0"
                                Content="3.3V电压:"
                                IsChecked="{Binding Parameters[5].IsEnabled, Mode=TwoWay}" />
                            <TextBox
                                Width="110"
                                Margin="0,0,4,0"
                                IsEnabled="{Binding Parameters[5].IsEnabled, Mode=OneWay}"
                                materialDesign:HintAssist.Hint="MES代码"
                                Text="{Binding Parameters[5].MesCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBox
                                Width="60"
                                Margin="0,0,4,0"
                                IsEnabled="{Binding Parameters[5].IsEnabled, Mode=OneWay}"
                                materialDesign:HintAssist.Hint="下限"
                                Text="{Binding Parameters[5].Parameters[1].Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Margin="0,0,4,0" Text="~" />
                            <TextBox
                                Width="60"
                                IsEnabled="{Binding Parameters[5].IsEnabled, Mode=OneWay}"
                                materialDesign:HintAssist.Hint="上限"
                                Text="{Binding Parameters[5].Parameters[2].Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel
                            Width="420"
                            Margin="0,4,12,4"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                            <CheckBox
                                Width="130"
                                Margin="0,0,8,0"
                                Content="功耗检测:"
                                IsChecked="{Binding Parameters[6].IsEnabled, Mode=TwoWay}" />
                            <TextBox
                                Width="110"
                                Margin="0,0,4,0"
                                IsEnabled="{Binding Parameters[6].IsEnabled, Mode=OneWay}"
                                materialDesign:HintAssist.Hint="MES代码"
                                Text="{Binding Parameters[6].MesCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBox
                                Width="60"
                                Margin="0,0,4,0"
                                IsEnabled="{Binding Parameters[6].IsEnabled, Mode=OneWay}"
                                materialDesign:HintAssist.Hint="下限"
                                Text="{Binding Parameters[6].Parameters[1].Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Margin="0,0,4,0" Text="~" />
                            <TextBox
                                Width="60"
                                IsEnabled="{Binding Parameters[6].IsEnabled, Mode=OneWay}"
                                materialDesign:HintAssist.Hint="上限"
                                Text="{Binding Parameters[6].Parameters[2].Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel
                            Width="420"
                            Margin="0,4,12,4"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                            <CheckBox
                                Width="130"
                                Margin="0,0,8,0"
                                Content="信号强度:"
                                IsChecked="{Binding Parameters[7].IsEnabled, Mode=TwoWay}" />
                            <TextBox
                                Width="110"
                                Margin="0,0,4,0"
                                IsEnabled="{Binding Parameters[7].IsEnabled, Mode=OneWay}"
                                materialDesign:HintAssist.Hint="MES代码"
                                Text="{Binding Parameters[7].MesCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBox
                                Width="60"
                                Margin="0,0,4,0"
                                IsEnabled="{Binding Parameters[7].IsEnabled, Mode=OneWay}"
                                materialDesign:HintAssist.Hint="下限"
                                Text="{Binding Parameters[7].Parameters[1].Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Margin="0,0,4,0" Text="~" />
                            <TextBox
                                Width="60"
                                IsEnabled="{Binding Parameters[7].IsEnabled, Mode=OneWay}"
                                materialDesign:HintAssist.Hint="上限"
                                Text="{Binding Parameters[7].Parameters[2].Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <!-- ========== 下拉型（索引 15~16）：配置名 + MES代码 + 测试方式下拉框 ========== -->
                        <StackPanel
                            Width="420"
                            Margin="0,4,12,4"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                            <CheckBox
                                Width="130"
                                Margin="0,0,8,0"
                                Content="无源测试:"
                                IsChecked="{Binding Parameters[15].IsEnabled, Mode=TwoWay}" />
                            <TextBox
                                Width="110"
                                Margin="0,0,4,0"
                                IsEnabled="{Binding Parameters[15].IsEnabled, Mode=OneWay}"
                                materialDesign:HintAssist.Hint="MES代码"
                                Text="{Binding Parameters[15].MesCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <ComboBox
                                Width="150"
                                DisplayMemberPath="Display"
                                IsEnabled="{Binding Parameters[15].IsEnabled, Mode=OneWay}"
                                ItemsSource="{StaticResource TestModeOptions}"
                                SelectedValue="{Binding Parameters[15].Parameters[0].Value, Mode=TwoWay}"
                                SelectedValuePath="Value" />
                        </StackPanel>
                        <StackPanel
                            Width="420"
                            Margin="0,4,12,4"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                            <CheckBox
                                Width="130"
                                Margin="0,0,8,0"
                                Content="有源测试:"
                                IsChecked="{Binding Parameters[16].IsEnabled, Mode=TwoWay}" />
                            <TextBox
                                Width="110"
                                Margin="0,0,4,0"
                                IsEnabled="{Binding Parameters[16].IsEnabled, Mode=OneWay}"
                                materialDesign:HintAssist.Hint="MES代码"
                                Text="{Binding Parameters[16].MesCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <ComboBox
                                Width="150"
                                DisplayMemberPath="Display"
                                IsEnabled="{Binding Parameters[16].IsEnabled, Mode=OneWay}"
                                ItemsSource="{StaticResource TestModeOptions}"
                                SelectedValue="{Binding Parameters[16].Parameters[0].Value, Mode=TwoWay}"
                                SelectedValuePath="Value" />
                        </StackPanel>

                        <!-- ========== 值型（索引 17~18）：配置名 + MES代码 + 参数值 ========== -->
                        <StackPanel
                            Width="420"
                            Margin="0,4,12,4"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                            <CheckBox
                                Width="130"
                                Margin="0,0,8,0"
                                Content="版本号:"
                                IsChecked="{Binding Parameters[17].IsEnabled, Mode=TwoWay}" />
                            <TextBox
                                Width="110"
                                Margin="0,0,4,0"
                                IsEnabled="{Binding Parameters[17].IsEnabled, Mode=OneWay}"
                                materialDesign:HintAssist.Hint="MES代码"
                                Text="{Binding Parameters[17].MesCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBox
                                Width="140"
                                IsEnabled="{Binding Parameters[17].IsEnabled, Mode=OneWay}"
                                materialDesign:HintAssist.Hint="如 1.0.1"
                                Text="{Binding Parameters[17].Parameters[0].Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel
                            Width="420"
                            Margin="0,4,12,4"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                            <CheckBox
                                Width="130"
                                Margin="0,0,8,0"
                                Content="编译时间:"
                                IsChecked="{Binding Parameters[18].IsEnabled, Mode=TwoWay}" />
                            <TextBox
                                Width="110"
                                Margin="0,0,4,0"
                                IsEnabled="{Binding Parameters[18].IsEnabled, Mode=OneWay}"
                                materialDesign:HintAssist.Hint="MES代码"
                                Text="{Binding Parameters[18].MesCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBox
                                Width="140"
                                IsEnabled="{Binding Parameters[18].IsEnabled, Mode=OneWay}"
                                materialDesign:HintAssist.Hint="yyMMddHHmmss"
                                Text="{Binding Parameters[18].Parameters[0].Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <!-- ========== 状态型（索引 8~14）：仅配置名 + MES代码，无参数区，输入数最少排最后 ========== -->
                        <StackPanel
                            Width="420"
                            Margin="0,4,12,4"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                            <CheckBox
                                Width="130"
                                Margin="0,0,8,0"
                                Content="IMEI读取:"
                                IsChecked="{Binding Parameters[8].IsEnabled, Mode=TwoWay}" />
                            <TextBox
                                Width="110"
                                IsEnabled="{Binding Parameters[8].IsEnabled, Mode=OneWay}"
                                materialDesign:HintAssist.Hint="MES代码"
                                Text="{Binding Parameters[8].MesCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel
                            Width="420"
                            Margin="0,4,12,4"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                            <CheckBox
                                Width="130"
                                Margin="0,0,8,0"
                                Content="IMSI读取:"
                                IsChecked="{Binding Parameters[9].IsEnabled, Mode=TwoWay}" />
                            <TextBox
                                Width="110"
                                IsEnabled="{Binding Parameters[9].IsEnabled, Mode=OneWay}"
                                materialDesign:HintAssist.Hint="MES代码"
                                Text="{Binding Parameters[9].MesCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel
                            Width="420"
                            Margin="0,4,12,4"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                            <CheckBox
                                Width="130"
                                Margin="0,0,8,0"
                                Content="ICCID读取:"
                                IsChecked="{Binding Parameters[10].IsEnabled, Mode=TwoWay}" />
                            <TextBox
                                Width="110"
                                IsEnabled="{Binding Parameters[10].IsEnabled, Mode=OneWay}"
                                materialDesign:HintAssist.Hint="MES代码"
                                Text="{Binding Parameters[10].MesCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel
                            Width="420"
                            Margin="0,4,12,4"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                            <CheckBox
                                Width="130"
                                Margin="0,0,8,0"
                                Content="Flash检测:"
                                IsChecked="{Binding Parameters[11].IsEnabled, Mode=TwoWay}" />
                            <TextBox
                                Width="110"
                                IsEnabled="{Binding Parameters[11].IsEnabled, Mode=OneWay}"
                                materialDesign:HintAssist.Hint="MES代码"
                                Text="{Binding Parameters[11].MesCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel
                            Width="420"
                            Margin="0,4,12,4"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                            <CheckBox
                                Width="130"
                                Margin="0,0,8,0"
                                Content="蓝牙检测:"
                                IsChecked="{Binding Parameters[12].IsEnabled, Mode=TwoWay}" />
                            <TextBox
                                Width="110"
                                IsEnabled="{Binding Parameters[12].IsEnabled, Mode=OneWay}"
                                materialDesign:HintAssist.Hint="MES代码"
                                Text="{Binding Parameters[12].MesCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel
                            Width="420"
                            Margin="0,4,12,4"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                            <CheckBox
                                Width="130"
                                Margin="0,0,8,0"
                                Content="星闪检测:"
                                IsChecked="{Binding Parameters[13].IsEnabled, Mode=TwoWay}" />
                            <TextBox
                                Width="110"
                                IsEnabled="{Binding Parameters[13].IsEnabled, Mode=OneWay}"
                                materialDesign:HintAssist.Hint="MES代码"
                                Text="{Binding Parameters[13].MesCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel
                            Width="420"
                            Margin="0,4,12,4"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                            <CheckBox
                                Width="130"
                                Margin="0,0,8,0"
                                Content="甲烷传感器:"
                                IsChecked="{Binding Parameters[14].IsEnabled, Mode=TwoWay}" />
                            <TextBox
                                Width="110"
                                IsEnabled="{Binding Parameters[14].IsEnabled, Mode=OneWay}"
                                materialDesign:HintAssist.Hint="MES代码"
                                Text="{Binding Parameters[14].MesCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <!-- ========== 全局项：无勾选框、无 MES 框，固定排在配置项最后方 ========== -->
                        <StackPanel
                            Width="420"
                            Margin="0,4,12,4"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                            <TextBlock
                                Width="130"
                                Margin="0,0,8,0"
                                Text="工位数量:" />
                            <TextBox
                                Width="110"
                                Text="{Binding StationCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel
                            Width="420"
                            Margin="0,4,12,4"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                            <TextBlock
                                Width="130"
                                Margin="0,0,8,0"
                                Text="最大测试时间(秒):" />
                            <TextBox
                                Width="110"
                                Text="{Binding MaxTestTimeout, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </WrapPanel>
                </Border>

                <!--  Row3 产品预览（配置项预览）：独立白色横条，内含分页栏  -->
                <Border
                    Grid.Row="1"
                    Padding="10,8"
                    Style="{StaticResource ManagementSurfaceStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <DataGrid
                            Grid.Row="0"
                            AutoGenerateColumns="False"
                            CanUserAddRows="False"
                            HeadersVisibility="Column"
                            IsReadOnly="True"
                            ItemsSource="{Binding Plans}"
                            SelectedItem="{Binding SelectedPlan}"
                            Style="{StaticResource ManagementDataGridStyle}">
                            <DataGrid.Columns>
                                <DataGridTextColumn
                                    Width="110"
                                    Binding="{Binding ProductCode}"
                                    Header="产品编码" />
                                <DataGridTextColumn
                                    Width="50"
                                    Binding="{Binding StationCount}"
                                    Header="工位" />
                                <DataGridTextColumn Width="100" Header="12V电压">
                                    <DataGridTextColumn.Binding>
                                        <MultiBinding StringFormat="{}{0}~{1}">
                                            <Binding Path="Parameters[0].Parameters[1].Value" />
                                            <Binding Path="Parameters[0].Parameters[2].Value" />
                                        </MultiBinding>
                                    </DataGridTextColumn.Binding>
                                </DataGridTextColumn>
                                <DataGridTextColumn Width="100" Header="8V电压">
                                    <DataGridTextColumn.Binding>
                                        <MultiBinding StringFormat="{}{0}~{1}">
                                            <Binding Path="Parameters[1].Parameters[1].Value" />
                                            <Binding Path="Parameters[1].Parameters[2].Value" />
                                        </MultiBinding>
                                    </DataGridTextColumn.Binding>
                                </DataGridTextColumn>
                                <DataGridTextColumn Width="100" Header="主电5V电压">
                                    <DataGridTextColumn.Binding>
                                        <MultiBinding StringFormat="{}{0}~{1}">
                                            <Binding Path="Parameters[2].Parameters[1].Value" />
                                            <Binding Path="Parameters[2].Parameters[2].Value" />
                                        </MultiBinding>
                                    </DataGridTextColumn.Binding>
                                </DataGridTextColumn>
                                <DataGridTextColumn Width="100" Header="甲烷5V电压">
                                    <DataGridTextColumn.Binding>
                                        <MultiBinding StringFormat="{}{0}~{1}">
                                            <Binding Path="Parameters[3].Parameters[1].Value" />
                                            <Binding Path="Parameters[3].Parameters[2].Value" />
                                        </MultiBinding>
                                    </DataGridTextColumn.Binding>
                                </DataGridTextColumn>
                                <DataGridTextColumn Width="90" Header="3.8V电压">
                                    <DataGridTextColumn.Binding>
                                        <MultiBinding StringFormat="{}{0}~{1}">
                                            <Binding Path="Parameters[4].Parameters[1].Value" />
                                            <Binding Path="Parameters[4].Parameters[2].Value" />
                                        </MultiBinding>
                                    </DataGridTextColumn.Binding>
                                </DataGridTextColumn>
                                <DataGridTextColumn Width="90" Header="3.3V电压">
                                    <DataGridTextColumn.Binding>
                                        <MultiBinding StringFormat="{}{0}~{1}">
                                            <Binding Path="Parameters[5].Parameters[1].Value" />
                                            <Binding Path="Parameters[5].Parameters[2].Value" />
                                        </MultiBinding>
                                    </DataGridTextColumn.Binding>
                                </DataGridTextColumn>
                                <DataGridTextColumn Width="90" Header="功耗">
                                    <DataGridTextColumn.Binding>
                                        <MultiBinding StringFormat="{}{0}~{1}">
                                            <Binding Path="Parameters[6].Parameters[1].Value" />
                                            <Binding Path="Parameters[6].Parameters[2].Value" />
                                        </MultiBinding>
                                    </DataGridTextColumn.Binding>
                                </DataGridTextColumn>
                                <DataGridTextColumn Width="90" Header="信号强度">
                                    <DataGridTextColumn.Binding>
                                        <MultiBinding StringFormat="{}{0}~{1}">
                                            <Binding Path="Parameters[7].Parameters[1].Value" />
                                            <Binding Path="Parameters[7].Parameters[2].Value" />
                                        </MultiBinding>
                                    </DataGridTextColumn.Binding>
                                </DataGridTextColumn>
                                <!--  状态型配置项：仅显示 开启/关闭（绑定对应参数的 IsEnabled）  -->
                                <DataGridTemplateColumn Width="60" Header="IMEI">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="关闭" />
                                                        <Setter Property="Foreground" Value="#999999" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Parameters[8].IsEnabled}" Value="True">
                                                                <Setter Property="Text" Value="开启" />
                                                                <Setter Property="Foreground" Value="#2E9E5B" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Width="60" Header="IMSI">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="关闭" />
                                                        <Setter Property="Foreground" Value="#999999" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Parameters[9].IsEnabled}" Value="True">
                                                                <Setter Property="Text" Value="开启" />
                                                                <Setter Property="Foreground" Value="#2E9E5B" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Width="65" Header="ICCID">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="关闭" />
                                                        <Setter Property="Foreground" Value="#999999" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Parameters[10].IsEnabled}" Value="True">
                                                                <Setter Property="Text" Value="开启" />
                                                                <Setter Property="Foreground" Value="#2E9E5B" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Width="60" Header="Flash">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="关闭" />
                                                        <Setter Property="Foreground" Value="#999999" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Parameters[11].IsEnabled}" Value="True">
                                                                <Setter Property="Text" Value="开启" />
                                                                <Setter Property="Foreground" Value="#2E9E5B" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Width="60" Header="蓝牙">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="关闭" />
                                                        <Setter Property="Foreground" Value="#999999" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Parameters[12].IsEnabled}" Value="True">
                                                                <Setter Property="Text" Value="开启" />
                                                                <Setter Property="Foreground" Value="#2E9E5B" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Width="60" Header="星闪">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="关闭" />
                                                        <Setter Property="Foreground" Value="#999999" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Parameters[13].IsEnabled}" Value="True">
                                                                <Setter Property="Text" Value="开启" />
                                                                <Setter Property="Foreground" Value="#2E9E5B" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Width="85" Header="甲烷传感器">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="关闭" />
                                                        <Setter Property="Foreground" Value="#999999" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Parameters[14].IsEnabled}" Value="True">
                                                                <Setter Property="Text" Value="开启" />
                                                                <Setter Property="Foreground" Value="#2E9E5B" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn
                                    Width="70"
                                    Binding="{Binding Parameters[16].Parameters[0].Value}"
                                    Header="有源" />
                                <DataGridTextColumn
                                    Width="70"
                                    Binding="{Binding Parameters[15].Parameters[0].Value}"
                                    Header="无源" />
                                <DataGridTextColumn
                                    Width="80"
                                    Binding="{Binding Parameters[17].Parameters[0].Value}"
                                    Header="版本号" />
                                <DataGridTextColumn
                                    Width="130"
                                    Binding="{Binding Parameters[18].Parameters[0].Value}"
                                    Header="编译时间" />
                                <DataGridTextColumn
                                    Width="90"
                                    Binding="{Binding CreatedBy}"
                                    Header="创建人" />
                                <DataGridTextColumn
                                    Width="150"
                                    Binding="{Binding CreatedTime, StringFormat=yyyy-MM-dd HH:mm}"
                                    Header="创建时间" />
                                <DataGridTextColumn
                                    Width="90"
                                    Binding="{Binding UpdatedBy}"
                                    Header="更新人" />
                                <DataGridTextColumn
                                    Width="150"
                                    Binding="{Binding UpdatedTime, StringFormat=yyyy-MM-dd HH:mm}"
                                    Header="更新时间" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <!--  分页栏（置于预览卡片内，仿 UserManageView 左对齐）  -->
                        <StackPanel
                            Grid.Row="1"
                            Margin="0,12,0,4"
                            HorizontalAlignment="Left"
                            Orientation="Horizontal">
                            <TextBlock Margin="0,0,12,0" VerticalAlignment="Center">
                                <Run Text="共 " /><Run Text="{Binding TotalCount}" /><Run Text=" 条   " />
                                <Run Text="{Binding TotalPages, Mode=OneWay}" /><Run Text=" 页   第 " />
                                <Run Text="{Binding PageIndex}" /><Run Text=" 页" />
                            </TextBlock>
                            <Button
                                Command="{Binding FirstPageCommand}"
                                Content="首页"
                                Style="{StaticResource PaginationButtonStyle}" />
                            <Button
                                Command="{Binding PreviousPageCommand}"
                                Content="上一页"
                                Style="{StaticResource PaginationButtonStyle}" />
                            <Button
                                Command="{Binding NextPageCommand}"
                                Content="下一页"
                                Style="{StaticResource PaginationButtonStyle}" />
                            <Button
                                Command="{Binding LastPageCommand}"
                                Content="末页"
                                Style="{StaticResource PaginationButtonStyle}" />
                            <ComboBox
                                Width="60"
                                Height="28"
                                Margin="8,0,0,0"
                                VerticalContentAlignment="Center"
                                ItemsSource="{Binding PageSizeOptions}"
                                SelectedItem="{Binding PageSize}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
