<!--
    =============================================================================
    文件名：LaserDetectorConfigView.xaml
    功能描述：激光检测仪方案配置视图（原 LaserDetectorView 更名而来）。
    布局仿照 UserManageView 的分层卡片式：导航条、参数配置区、
    方案列表预览各自独立白色横条，页面背景为浅灰色。
    参数配置卡片内部为 Grid 三行骨架：基本信息行 + 参数配置 WrapPanel +
    MES 代码 WrapPanel（均内嵌 StackPanel），配置项与 MES 代码分开陈列，
    两处 CheckBox 绑定同一 IsEnabled，勾选自动同步。
    保留 Ctrl+鼠标滚轮整体缩放（0.5~3.0）与参数面板折叠/展开交互。
    =============================================================================
-->
<UserControl
    x:Class="IMDP.Products.GasDG.LaserDetector.Views.LaserDetectorConfigView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="clr-namespace:IMDP.Products.GasDG.LaserDetector.Views.Behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="clr-namespace:IMDP.Products.GasDG.LaserDetector.Models"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:viewmodels="clr-namespace:IMDP.Products.GasDG.LaserDetector.ViewModels"
    d:DataContext="{d:DesignInstance Type=viewmodels:LaserDetectorConfigViewModel}"
    d:DesignHeight="900"
    d:DesignWidth="1920"
    prism:ViewModelLocator.AutoWireViewModel="True"
    Background="{StaticResource ImdpPageBackgroundBrush}"
    FontFamily="{DynamicResource MaterialDesignFont}"
    mc:Ignorable="d">
    <UserControl.Resources>
        <!--  隐式样式：文本左对齐垂直居中  -->
        <Style TargetType="TextBlock">
            <Setter Property="TextAlignment" Value="Left" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
        <!--  输入框统一使用 MaterialDesign 浮动提示样式  -->
        <Style BasedOn="{StaticResource MaterialDesignFloatingHintTextBox}" TargetType="TextBox">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
        </Style>
        <!--  下拉框统一使用 MaterialDesign 浮动提示样式  -->
        <Style BasedOn="{StaticResource MaterialDesignFloatingHintComboBox}" TargetType="ComboBox">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!--  测试方式下拉选项（有源/无源共用）  -->
        <x:Array x:Key="TestModeOptions" Type="models:ConfigModeOption">
            <models:ConfigModeOption Display="01-仅测试输出功能" Value="01" />
            <models:ConfigModeOption Display="02-测试输入和输出功能" Value="02" />
        </x:Array>
        <!--  GroupBox 统一样式：参数配置区 / MES 代码区分区边框（基于 MaterialDesign 卡片风格）  -->
        <Style BasedOn="{StaticResource MaterialDesignCardGroupBox}" TargetType="GroupBox">
            <Setter Property="Padding" Value="10,4" />
        </Style>
    </UserControl.Resources>

    <!--
        根 Grid：导航条固定顶部不随内容横向滚动（保证查询等操作按钮始终可见）；
        下方内容区独立横向/纵向滚动并支持 Ctrl+滚轮缩放
    -->
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Row0 导航条：独立白色横条（面包屑 + 三色操作按钮 + 折叠/展开）  -->
        <Border
            Grid.Row="0"
            Margin="0,0,0,10"
            Padding="28,8"
            Style="{StaticResource ManagementSurfaceStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!--  左：面包屑  -->
                <StackPanel
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <Button
                        Width="90"
                        BorderThickness="0"
                        Command="{Binding GoHomeCommand}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <TextBlock
                                    x:Name="ContextText"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Foreground="Black"
                                    Text="首页-&gt;" />
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="ContextText" Property="Foreground" Value="Blue" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <TextBlock
                        Margin="-20,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="15"
                        Text="激光检测仪方案配置" />
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="15"
                        Foreground="#666666"
                        Text="{Binding CurrentMaterialNumber, StringFormat='  ({0})'}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentMaterialNumber}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>

                <!--  右：三色操作按钮 + 折叠/展开  -->
                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <Button
                        Width="90"
                        Height="40"
                        Margin="5,0"
                        Command="{Binding QueryCommand}"
                        Content="查询"
                        Style="{StaticResource SemanticQueryButtonStyle}" />
                    <Button
                        Width="90"
                        Height="40"
                        Margin="5,0"
                        Command="{Binding SaveCommand}"
                        Content="维护"
                        Style="{StaticResource SemanticSuccessButtonStyle}" />
                    <Button
                        Width="90"
                        Height="40"
                        Margin="5,0"
                        Command="{Binding DeleteCommand}"
                        Content="删除"
                        Style="{StaticResource SemanticDangerButtonStyle}" />
                    <Button
                        x:Name="ButtonCloseMenu"
                        Width="90"
                        Height="40"
                        Margin="5,0"
                        Click="ButtonCloseMenu_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border
                                    x:Name="Bd"
                                    Background="#05b790"
                                    CornerRadius="10">
                                    <materialDesign:PackIcon
                                        Width="25"
                                        Height="25"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Foreground="White"
                                        Kind="ArrowUp" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Opacity" Value="0.88" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button
                        x:Name="ButtonOpenMenu"
                        Width="90"
                        Height="40"
                        Margin="5,0"
                        Click="ButtonOpenMenu_Click"
                        Visibility="Collapsed">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border
                                    x:Name="Bd"
                                    Background="#05b790"
                                    CornerRadius="10">
                                    <materialDesign:PackIcon
                                        Width="25"
                                        Height="25"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Foreground="White"
                                        Kind="ArrowDown" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Opacity" Value="0.88" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer
            x:Name="RootScrollViewer"
            Grid.Row="1"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <!--
                横向滚动禁用：内容宽度始终约束为视口宽，WrapPanel 按实际可用宽度自动换行，
                任何屏幕/窗口尺寸下都不会出现横向滚动条（Ctrl+滚轮放大时自动重排换行）。
            -->
            <Grid>
                <Grid.LayoutTransform>
                    <ScaleTransform x:Name="ScaleTransform" ScaleX="1" ScaleY="1" />
                </Grid.LayoutTransform>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" MinHeight="180" />
                </Grid.RowDefinitions>

                <!--
                    Row1 参数配置区：独立白色横条。
                    内部 Grid 三行骨架：基本信息行 + 参数配置 WrapPanel + MES 代码 WrapPanel；
                    两个 WrapPanel 均内嵌 StackPanel（每项 = 配置名 CheckBox + 对应输入控件），
                    配置项参数与 MES 代码分开陈列，CheckBox 绑定同一 IsEnabled 双向同步。
                -->
                <Border
                    x:Name="GridMenu"
                    Grid.Row="0"
                    Margin="0,0,0,10"
                    Padding="20,12"
                    Style="{StaticResource ManagementSurfaceStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!--  Row0 基本信息：产品编码 | 工位数量  -->
                        <StackPanel
                            Grid.Row="0"
                            Margin="0,0,0,8"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                            <TextBlock Margin="0,0,8,0" Text="产品编码:" />
                            <!--  回车/空格（KeyBinding）与失焦（附加行为）均触发按编码加载方案，无需 code-behind  -->
                            <TextBox
                                Width="200"
                                behaviors:LostFocus.Command="{Binding LoadByCodeCommand}"
                                Text="{Binding ProductCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding LoadByCodeCommand}" />
                                    <KeyBinding Key="Space" Command="{Binding LoadByCodeCommand}" />
                                </TextBox.InputBindings>
                            </TextBox>
                            <TextBlock Margin="30,0,8,0" Text="工位数量:" />
                            <TextBox Width="70" Text="{Binding StationCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <!--  Row1 参数配置：GroupBox 分区，WrapPanel 内嵌 StackPanel，每项 = 配置名(CheckBox) + 对应参数配置。
                              状态型检测项（IMEI/IMSI/ICCID/Flash/蓝牙/星闪/甲烷传感器）仅有配置名勾选框，无子参数输入。
                              不设 ItemWidth：每项按实际内容宽度排列、项间以右边距分隔，
                              外层滚动禁用横向，WrapPanel 按视口实际宽度自动换行，任何屏幕均无横向滚动  -->
                        <GroupBox Grid.Row="1" Header="参数配置">
                            <WrapPanel>
                            <!--  范围型：下限~上限  -->
                            <StackPanel
                                Margin="0,4,24,4"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                                <CheckBox
                                    Margin="0,0,8,0"
                                    Content="12V电压:"
                                    IsChecked="{Binding Parameters[0].IsEnabled, Mode=TwoWay}" />
                                <TextBox
                                    Width="70"
                                    Margin="0,0,4,0"
                                    materialDesign:HintAssist.Hint="下限"
                                    Text="{Binding Parameters[0].Parameters[1].Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Margin="0,0,4,0" Text="~" />
                                <TextBox
                                    Width="70"
                                    materialDesign:HintAssist.Hint="上限"
                                    Text="{Binding Parameters[0].Parameters[2].Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel
                                Margin="0,4,24,4"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                                <CheckBox
                                    Margin="0,0,8,0"
                                    Content="8V电压:"
                                    IsChecked="{Binding Parameters[1].IsEnabled, Mode=TwoWay}" />
                                <TextBox
                                    Width="70"
                                    Margin="0,0,4,0"
                                    materialDesign:HintAssist.Hint="下限"
                                    Text="{Binding Parameters[1].Parameters[1].Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Margin="0,0,4,0" Text="~" />
                                <TextBox
                                    Width="70"
                                    materialDesign:HintAssist.Hint="上限"
                                    Text="{Binding Parameters[1].Parameters[2].Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel
                                Margin="0,4,24,4"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                                <CheckBox
                                    Margin="0,0,8,0"
                                    Content="主电5V电压:"
                                    IsChecked="{Binding Parameters[2].IsEnabled, Mode=TwoWay}" />
                                <TextBox
                                    Width="70"
                                    Margin="0,0,4,0"
                                    materialDesign:HintAssist.Hint="下限"
                                    Text="{Binding Parameters[2].Parameters[1].Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Margin="0,0,4,0" Text="~" />
                                <TextBox
                                    Width="70"
                                    materialDesign:HintAssist.Hint="上限"
                                    Text="{Binding Parameters[2].Parameters[2].Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel
                                Margin="0,4,24,4"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                                <CheckBox
                                    Margin="0,0,8,0"
                                    Content="甲烷5V电压:"
                                    IsChecked="{Binding Parameters[3].IsEnabled, Mode=TwoWay}" />
                                <TextBox
                                    Width="70"
                                    Margin="0,0,4,0"
                                    materialDesign:HintAssist.Hint="下限"
                                    Text="{Binding Parameters[3].Parameters[1].Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Margin="0,0,4,0" Text="~" />
                                <TextBox
                                    Width="70"
                                    materialDesign:HintAssist.Hint="上限"
                                    Text="{Binding Parameters[3].Parameters[2].Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel
                                Margin="0,4,24,4"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                                <CheckBox
                                    Margin="0,0,8,0"
                                    Content="3.8V电压:"
                                    IsChecked="{Binding Parameters[4].IsEnabled, Mode=TwoWay}" />
                                <TextBox
                                    Width="70"
                                    Margin="0,0,4,0"
                                    materialDesign:HintAssist.Hint="下限"
                                    Text="{Binding Parameters[4].Parameters[1].Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Margin="0,0,4,0" Text="~" />
                                <TextBox
                                    Width="70"
                                    materialDesign:HintAssist.Hint="上限"
                                    Text="{Binding Parameters[4].Parameters[2].Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel
                                Margin="0,4,24,4"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                                <CheckBox
                                    Margin="0,0,8,0"
                                    Content="3.3V电压:"
                                    IsChecked="{Binding Parameters[5].IsEnabled, Mode=TwoWay}" />
                                <TextBox
                                    Width="70"
                                    Margin="0,0,4,0"
                                    materialDesign:HintAssist.Hint="下限"
                                    Text="{Binding Parameters[5].Parameters[1].Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Margin="0,0,4,0" Text="~" />
                                <TextBox
                                    Width="70"
                                    materialDesign:HintAssist.Hint="上限"
                                    Text="{Binding Parameters[5].Parameters[2].Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel
                                Margin="0,4,24,4"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                                <CheckBox
                                    Margin="0,0,8,0"
                                    Content="功耗检测:"
                                    IsChecked="{Binding Parameters[6].IsEnabled, Mode=TwoWay}" />
                                <TextBox
                                    Width="70"
                                    Margin="0,0,4,0"
                                    materialDesign:HintAssist.Hint="下限"
                                    Text="{Binding Parameters[6].Parameters[1].Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Margin="0,0,4,0" Text="~" />
                                <TextBox
                                    Width="70"
                                    materialDesign:HintAssist.Hint="上限"
                                    Text="{Binding Parameters[6].Parameters[2].Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel
                                Margin="0,4,24,4"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                                <CheckBox
                                    Margin="0,0,8,0"
                                    Content="信号强度:"
                                    IsChecked="{Binding Parameters[7].IsEnabled, Mode=TwoWay}" />
                                <TextBox
                                    Width="70"
                                    Margin="0,0,4,0"
                                    materialDesign:HintAssist.Hint="下限"
                                    Text="{Binding Parameters[7].Parameters[1].Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Margin="0,0,4,0" Text="~" />
                                <TextBox
                                    Width="70"
                                    materialDesign:HintAssist.Hint="上限"
                                    Text="{Binding Parameters[7].Parameters[2].Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <!--  测试方式型：下拉选择  -->
                            <StackPanel
                                Margin="0,4,24,4"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                                <CheckBox
                                    Margin="0,0,8,0"
                                    Content="有源测试:"
                                    IsChecked="{Binding Parameters[16].IsEnabled, Mode=TwoWay}" />
                                <ComboBox
                                    Width="190"
                                    DisplayMemberPath="Display"
                                    ItemsSource="{StaticResource TestModeOptions}"
                                    SelectedValue="{Binding Parameters[16].Parameters[0].Value, Mode=TwoWay}"
                                    SelectedValuePath="Value" />
                            </StackPanel>
                            <StackPanel
                                Margin="0,4,24,4"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                                <CheckBox
                                    Margin="0,0,8,0"
                                    Content="无源测试:"
                                    IsChecked="{Binding Parameters[15].IsEnabled, Mode=TwoWay}" />
                                <ComboBox
                                    Width="190"
                                    DisplayMemberPath="Display"
                                    ItemsSource="{StaticResource TestModeOptions}"
                                    SelectedValue="{Binding Parameters[15].Parameters[0].Value, Mode=TwoWay}"
                                    SelectedValuePath="Value" />
                            </StackPanel>
                            <!--  值型：单文本框  -->
                            <StackPanel
                                Margin="0,4,24,4"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                                <CheckBox
                                    Margin="0,0,8,0"
                                    Content="版本号:"
                                    IsChecked="{Binding Parameters[17].IsEnabled, Mode=TwoWay}" />
                                <TextBox
                                    Width="130"
                                    materialDesign:HintAssist.Hint="如 1.0.1"
                                    Text="{Binding Parameters[17].Parameters[0].Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel
                                Margin="0,4,24,4"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                                <CheckBox
                                    Margin="0,0,8,0"
                                    Content="编译时间:"
                                    IsChecked="{Binding Parameters[18].IsEnabled, Mode=TwoWay}" />
                                <TextBox
                                    Width="140"
                                    materialDesign:HintAssist.Hint="yyMMddHHmmss"
                                    Text="{Binding Parameters[18].Parameters[0].Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <!--  状态型：仅有配置名勾选框，无子参数输入（与 MES 区同一 IsEnabled，勾选双向同步）  -->
                            <StackPanel
                                Margin="0,4,24,4"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                                <CheckBox
                                    Margin="0,0,8,0"
                                    Content="IMEI读取"
                                    IsChecked="{Binding Parameters[8].IsEnabled, Mode=TwoWay}" />
                            </StackPanel>
                            <StackPanel
                                Margin="0,4,24,4"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                                <CheckBox
                                    Margin="0,0,8,0"
                                    Content="IMSI读取"
                                    IsChecked="{Binding Parameters[9].IsEnabled, Mode=TwoWay}" />
                            </StackPanel>
                            <StackPanel
                                Margin="0,4,24,4"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                                <CheckBox
                                    Margin="0,0,8,0"
                                    Content="ICCID读取"
                                    IsChecked="{Binding Parameters[10].IsEnabled, Mode=TwoWay}" />
                            </StackPanel>
                            <StackPanel
                                Margin="0,4,24,4"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                                <CheckBox
                                    Margin="0,0,8,0"
                                    Content="Flash检测"
                                    IsChecked="{Binding Parameters[11].IsEnabled, Mode=TwoWay}" />
                            </StackPanel>
                            <StackPanel
                                Margin="0,4,24,4"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                                <CheckBox
                                    Margin="0,0,8,0"
                                    Content="蓝牙检测"
                                    IsChecked="{Binding Parameters[12].IsEnabled, Mode=TwoWay}" />
                            </StackPanel>
                            <StackPanel
                                Margin="0,4,24,4"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                                <CheckBox
                                    Margin="0,0,8,0"
                                    Content="星闪检测"
                                    IsChecked="{Binding Parameters[13].IsEnabled, Mode=TwoWay}" />
                            </StackPanel>
                            <StackPanel
                                Margin="0,4,24,4"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                                <CheckBox
                                    Margin="0,0,8,0"
                                    Content="甲烷传感器"
                                    IsChecked="{Binding Parameters[14].IsEnabled, Mode=TwoWay}" />
                            </StackPanel>
                            </WrapPanel>
                        </GroupBox>

                        <!--  Row2 MES 代码：GroupBox 分区，WrapPanel 内嵌 StackPanel，每项 = 配置名(CheckBox) + MES代码框（与参数区同一 IsEnabled，勾选双向同步）。
                              不设 ItemWidth：每项按实际内容宽度排列、项间以右边距分隔，
                              外层滚动禁用横向，WrapPanel 按视口实际宽度自动换行，任何屏幕均无横向滚动  -->
                        <GroupBox Grid.Row="2" Margin="0,10,0,0" Header="MES 代码">
                            <WrapPanel>
                            <StackPanel
                                Margin="0,4,24,4"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                                <CheckBox
                                    Margin="0,0,8,0"
                                    Content="12V电压:"
                                    IsChecked="{Binding Parameters[0].IsEnabled, Mode=TwoWay}" />
                                <TextBox
                                    Width="120"
                                    materialDesign:HintAssist.Hint="MES代码"
                                    Text="{Binding Parameters[0].MesCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel
                                Margin="0,4,24,4"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                                <CheckBox
                                    Margin="0,0,8,0"
                                    Content="8V电压:"
                                    IsChecked="{Binding Parameters[1].IsEnabled, Mode=TwoWay}" />
                                <TextBox
                                    Width="120"
                                    materialDesign:HintAssist.Hint="MES代码"
                                    Text="{Binding Parameters[1].MesCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel
                                Margin="0,4,24,4"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                                <CheckBox
                                    Margin="0,0,8,0"
                                    Content="主电5V电压:"
                                    IsChecked="{Binding Parameters[2].IsEnabled, Mode=TwoWay}" />
                                <TextBox
