<!-- =============================================================================
     文件名：LaserDetectorView.xaml
     功能描述：激光检测仪校验界面（参考 IMDS 项目移植）。按方案工位数量动态
               生成工位卡片；扫码触发自动测试 → 全部配置项只读结果展示 →
               人工测试项（LED/蜂鸣器/按键）→ 综合判定。
               分层卡片式布局：导航条（含串口工具栏与配置面板折叠/展开按钮）、
               常态化配置预览面板（与配置界面同构、只读）、工位检测卡片。
     ============================================================================= -->
<UserControl
    x:Class="IMDP.Products.GasDG.LaserDetector.Views.LaserDetectorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="clr-namespace:IMDP.Products.GasDG.LaserDetector.Models"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:viewmodels="clr-namespace:IMDP.Products.GasDG.LaserDetector.ViewModels"
    d:DataContext="{d:DesignInstance Type=viewmodels:LaserDetectorViewModel}"
    d:DesignHeight="900"
    d:DesignWidth="1920"
    prism:ViewModelLocator.AutoWireViewModel="True"
    Background="{StaticResource ImdpPageBackgroundBrush}"
    FontFamily="{DynamicResource MaterialDesignFont}"
    mc:Ignorable="d">
    <UserControl.Resources>
        <!--  测试方式下拉选项（有源/无源共用，与配置界面一致）  -->
        <x:Array x:Key="TestModeOptions" Type="models:ConfigModeOption">
            <models:ConfigModeOption Display="01-仅测试输出功能" Value="01" />
            <models:ConfigModeOption Display="02-测试输入和输出功能" Value="02" />
        </x:Array>
        <!--  工位状态头样式：按 StatusColor（Gray/Orange/Green/Red）切换背景色  -->
        <Style x:Key="StationStatusBorderStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Height" Value="60" />
            <Setter Property="Background" Value="#9E9E9E" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding StatusColor}" Value="Orange">
                    <Setter Property="Background" Value="#FF9800" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusColor}" Value="Green">
                    <Setter Property="Background" Value="#4CAF50" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusColor}" Value="Red">
                    <Setter Property="Background" Value="#F44336" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!--  自动测试结果项模板：名称 + 只读值（红绿背景）  -->
        <DataTemplate x:Key="ResultItemTemplate" DataType="{x:Type models:LaserDetectorResultDisplayItem}">
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="105" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Grid.Column="0"
                    FontWeight="SemiBold"
                    Text="{Binding Name}" />
                <TextBox
                    Grid.Column="1"
                    MinWidth="0"
                    IsReadOnly="True"
                    Text="{Binding Value, Mode=OneWay}">
                    <TextBox.Style>
                        <Style BasedOn="{StaticResource MaterialDesignFloatingHintTextBox}" TargetType="TextBox">
                            <Setter Property="Background" Value="#E8F5E9" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPassed}" Value="False">
                                    <Setter Property="Background" Value="#FFEBEE" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Row0 导航条卡片：面包屑 + 串口选择与开关 + 配置面板折叠/展开  -->
        <Border
            Grid.Row="0"
            Margin="0,0,0,10"
            Padding="28,8"
            Style="{StaticResource ManagementSurfaceStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!--  左：面包屑  -->
                <StackPanel
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <Button
                        Width="90"
                        BorderThickness="0"
                        Command="{Binding GoHomeCommand}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <TextBlock
                                    x:Name="ContextText"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Foreground="Black"
                                    Text="首页-&gt;" />
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="ContextText" Property="Foreground" Value="Blue" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <TextBlock
                        Margin="-20,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="15"
                        Text="激光检测仪模块检测" />
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="15"
                        Foreground="#666666"
                        Text="{Binding CurrentMaterialNumber, StringFormat='  ({0})'}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentMaterialNumber}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>

                <!--  右：串口选择与开关  -->
                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <TextBlock Margin="5,0" VerticalAlignment="Center" Text="串口选择:" />
                    <ComboBox
                        Width="120"
                        Margin="5,0"
                        DropDownOpened="PortComboBox_DropDownOpened"
                        ItemsSource="{Binding Ports}"
                        SelectedItem="{Binding SelectedPort}" />
                    <Button
                        Width="90"
                        Height="40"
                        Margin="5,0"
                        Command="{Binding OpenSerialCommand}"
                        Content="打开串口"
                        IsEnabled="{Binding CanOpenSerial}"
                        Style="{StaticResource SemanticSuccessButtonStyle}" />
                    <Button
                        Width="90"
                        Height="40"
                        Margin="5,0"
                        Command="{Binding CloseSerialCommand}"
                        Content="关闭串口"
                        IsEnabled="{Binding IsSerialOpen}"
                        Style="{StaticResource SemanticDangerButtonStyle}" />
                    <!--  配置面板折叠（上箭头）：收起常态化配置预览面板  -->
                    <Button
                        x:Name="ButtonCloseMenu"
                        Width="90"
                        Height="40"
                        Margin="5,0"
                        Click="ButtonCloseMenu_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border
                                    x:Name="Bd"
                                    Background="#05b790"
                                    CornerRadius="10">
                                    <materialDesign:PackIcon
                                        Width="25"
                                        Height="25"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Foreground="White"
                                        Kind="ArrowUp" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Opacity" Value="0.88" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <!--  配置面板展开（下箭头）：默认隐藏，收起后出现  -->
                    <Button
                        x:Name="ButtonOpenMenu"
                        Width="90"
                        Height="40"
                        Margin="5,0"
                        Click="ButtonOpenMenu_Click"
                        Visibility="Collapsed">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border
                                    x:Name="Bd"
                                    Background="#05b790"
                                    CornerRadius="10">
                                    <materialDesign:PackIcon
                                        Width="25"
                                        Height="25"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Foreground="White"
                                        Kind="ArrowDown" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Opacity" Value="0.88" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!--  Row1 配置预览面板：与配置界面同构的 3 列×8 行布局，全部只读常态化显示；
              行高 Auto 随启停自动收起（未配置整行不占位），面板高度随内容自适应；
              可通过导航条上箭头按钮折叠收起（动画过渡），下箭头重新展开  -->
        <Border
            x:Name="GridMenu"
            Grid.Row="1"
            Margin="0,0,0,10"
            Padding="10,0"
            Style="{StaticResource ManagementSurfaceStyle}">
            <Grid ShowGridLines="False">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="1*" MinWidth="330" />
                    <ColumnDefinition Width="30" />
                    <ColumnDefinition Width="1*" MinWidth="330" />
                    <ColumnDefinition Width="30" />
                    <ColumnDefinition Width="1*" MinWidth="330" />
                    <ColumnDefinition Width="20" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--  Row0：产品编码（可编辑，失焦加载方案） | 工位数量（只读）  -->
                <StackPanel
                    Grid.Row="0"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Margin="0,11,0,11"
                    Orientation="Horizontal">
                    <TextBlock Margin="0,0,8,0" Text="产品编码:" />
                    <TextBox
                        Width="200"
                        KeyDown="ProductCodeTextBox_KeyDown"
                        LostFocus="ProductCodeTextBox_LostFocus"
                        Text="{Binding ProductCode, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel
                    Grid.Row="0"
                    Grid.Column="3"
                    VerticalAlignment="Center"
                    Margin="0,11,0,11"
                    Orientation="Horizontal">
                    <TextBlock Margin="0,0,8,0" Text="工位数量:" />
                    <TextBox
                        Width="70"
                        IsReadOnly="True"
                        Text="{Binding StationCount, Mode=OneWay}" />
                </StackPanel>

                <!--  Row1：12V电压 | 8V电压 | 3.8V电压（只读复选框 + MES码 + 下限~上限）  -->
                <StackPanel
                    Grid.Row="1"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Margin="0,11,0,11"
                    Visibility="{Binding Config.Items[0].IsEnabled, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <CheckBox
                        Margin="0,0,8,0"
                        Content="{Binding Config.Items[0].Name}"
                        IsChecked="{Binding Config.Items[0].IsEnabled, Mode=OneWay}"
                        IsHitTestVisible="False" />
                    <TextBox
                        Width="80"
                        Margin="0,0,8,0"
                        IsReadOnly="True"
                        Text="{Binding Config.Items[0].MesCode, Mode=OneWay}" />
                    <TextBox
                        Width="70"
                        Margin="0,0,4,0"
                        IsReadOnly="True"
                        Text="{Binding Config.Items[0].LowerLimit, Mode=OneWay}" />
                    <TextBlock Margin="0,0,4,0" Text="~" />
                    <TextBox
                        Width="70"
                        IsReadOnly="True"
                        Text="{Binding Config.Items[0].UpperLimit, Mode=OneWay}" />
                </StackPanel>
                <StackPanel
                    Grid.Row="1"
                    Grid.Column="3"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Margin="0,11,0,11"
                    Visibility="{Binding Config.Items[1].IsEnabled, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <CheckBox
                        Margin="0,0,8,0"
                        Content="{Binding Config.Items[1].Name}"
                        IsChecked="{Binding Config.Items[1].IsEnabled, Mode=OneWay}"
                        IsHitTestVisible="False" />
                    <TextBox
                        Width="80"
                        Margin="0,0,8,0"
                        IsReadOnly="True"
                        Text="{Binding Config.Items[1].MesCode, Mode=OneWay}" />
                    <TextBox
                        Width="70"
                        Margin="0,0,4,0"
                        IsReadOnly="True"
                        Text="{Binding Config.Items[1].LowerLimit, Mode=OneWay}" />
                    <TextBlock Margin="0,0,4,0" Text="~" />
                    <TextBox
                        Width="70"
                        IsReadOnly="True"
                        Text="{Binding Config.Items[1].UpperLimit, Mode=OneWay}" />
                </StackPanel>
                <StackPanel
                    Grid.Row="1"
                    Grid.Column="5"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Margin="0,11,0,11"
                    Visibility="{Binding Config.Items[4].IsEnabled, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <CheckBox
                        Margin="0,0,8,0"
                        Content="{Binding Config.Items[4].Name}"
                        IsChecked="{Binding Config.Items[4].IsEnabled, Mode=OneWay}"
                        IsHitTestVisible="False" />
                    <TextBox
                        Width="80"
                        Margin="0,0,8,0"
                        IsReadOnly="True"
                        Text="{Binding Config.Items[4].MesCode, Mode=OneWay}" />
                    <TextBox
                        Width="70"
                        Margin="0,0,4,0"
                        IsReadOnly="True"
                        Text="{Binding Config.Items[4].LowerLimit, Mode=OneWay}" />
                    <TextBlock Margin="0,0,4,0" Text="~" />
                    <TextBox
                        Width="70"
                        IsReadOnly="True"
                        Text="{Binding Config.Items[4].UpperLimit, Mode=OneWay}" />
                </StackPanel>

                <!--  Row2：主电5V | 甲烷5V | 3.3V电压  -->
                <StackPanel
                    Grid.Row="2"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Margin="0,11,0,11"
                    Visibility="{Binding Config.Items[2].IsEnabled, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <CheckBox
                        Margin="0,0,8,0"
                        Content="{Binding Config.Items[2].Name}"
                        IsChecked="{Binding Config.Items[2].IsEnabled, Mode=OneWay}"
                        IsHitTestVisible="False" />
                    <TextBox
                        Width="80"
                        Margin="0,0,8,0"
                        IsReadOnly="True"
                        Text="{Binding Config.Items[2].MesCode, Mode=OneWay}" />
                    <TextBox
                        Width="70"
                        Margin="0,0,4,0"
                        IsReadOnly="True"
                        Text="{Binding Config.Items[2].LowerLimit, Mode=OneWay}" />
                    <TextBlock Margin="0,0,4,0" Text="~" />
                    <TextBox
                        Width="70"
                        IsReadOnly="True"
                        Text="{Binding Config.Items[2].UpperLimit, Mode=OneWay}" />
                </StackPanel>
                <StackPanel
                    Grid.Row="2"
                    Grid.Column="3"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Margin="0,11,0,11"
                    Visibility="{Binding Config.Items[3].IsEnabled, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <CheckBox
                        Margin="0,0,8,0"
                        Content="{Binding Config.Items[3].Name}"
                        IsChecked="{Binding Config.Items[3].IsEnabled, Mode=OneWay}"
                        IsHitTestVisible="False" />
                    <TextBox
                        Width="80"
                        Margin="0,0,8,0"
                        IsReadOnly="True"
                        Text="{Binding Config.Items[3].MesCode, Mode=OneWay}" />
                    <TextBox
                        Width="70"
                        Margin="0,0,4,0"
                        IsReadOnly="True"
                        Text="{Binding Config.Items[3].LowerLimit, Mode=OneWay}" />
                    <TextBlock Margin="0,0,4,0" Text="~" />
                    <TextBox
                        Width="70"
                        IsReadOnly="True"
                        Text="{Binding Config.Items[3].UpperLimit, Mode=OneWay}" />
                </StackPanel>
                <StackPanel
                    Grid.Row="2"
                    Grid.Column="5"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Margin="0,11,0,11"
                    Visibility="{Binding Config.Items[5].IsEnabled, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <CheckBox
                        Margin="0,0,8,0"
                        Content="{Binding Config.Items[5].Name}"
                        IsChecked="{Binding Config.Items[5].IsEnabled, Mode=OneWay}"
                        IsHitTestVisible="False" />
                    <TextBox
                        Width="80"
                        Margin="0,0,8,0"
                        IsReadOnly="True"
                        Text="{Binding Config.Items[5].MesCode, Mode=OneWay}" />
                    <TextBox
                        Width="70"
                        Margin="0,0,4,0"
                        IsReadOnly="True"
                        Text="{Binding Config.Items[5].LowerLimit, Mode=OneWay}" />
                    <TextBlock Margin="0,0,4,0" Text="~" />
                    <TextBox
                        Width="70"
                        IsReadOnly="True"
                        Text="{Binding Config.Items[5].UpperLimit, Mode=OneWay}" />
                </StackPanel>

                <!--  Row3：功耗 | 信号强度 | 有源测试（下拉只读展示测试方式）  -->
                <StackPanel
                    Grid.Row="3"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Margin="0,11,0,11"
                    Visibility="{Binding Config.Items[6].IsEnabled, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <CheckBox
                        Margin="0,0,8,0"
                        Content="{Binding Config.Items[6].Name}"
                        IsChecked="{Binding Config.Items[6].IsEnabled, Mode=OneWay}"
                        IsHitTestVisible="False" />
                    <TextBox
                        Width="80"
                        Margin="0,0,8,0"
                        IsReadOnly="True"
                        Text="{Binding Config.Items[6].MesCode, Mode=OneWay}" />
                    <TextBox
                        Width="70"
                        Margin="0,0,4,0"
                        IsReadOnly="True"
                        Text="{Binding Config.Items[6].LowerLimit, Mode=OneWay}" />
                    <TextBlock Margin="0,0,4,0" Text="~" />
                    <TextBox
                        Width="70"
                        IsReadOnly="True"
                        Text="{Binding Config.Items[6].UpperLimit, Mode=OneWay}" />
                </StackPanel>
                <StackPanel
                    Grid.Row="3"
                    Grid.Column="3"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Margin="0,11,0,11"
                    Visibility="{Binding Config.Items[7].IsEnabled, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <CheckBox
                        Margin="0,0,8,0"
                        Content="{Binding Config.Items[7].Name}"
                        IsChecked="{Binding Config.Items[7].IsEnabled, Mode=OneWay}"
                        IsHitTestVisible="False" />
                    <TextBox
                        Width="80"
                        Margin="0,0,8,0"
                        IsReadOnly="True"
                        Text="{Binding Config.Items[7].MesCode, Mode=OneWay}" />
                    <TextBox
                        Width="70"
                        Margin="0,0,4,0"
                        IsReadOnly="True"
                        Text="{Binding Config.Items[7].LowerLimit, Mode=OneWay}" />
                    <TextBlock Margin="0,0,4,0" Text="~" />
                    <TextBox
                        Width="70"
                        IsReadOnly="True"
                        Text="{Binding Config.Items[7].UpperLimit, Mode=OneWay}" />
                </StackPanel>
                <StackPanel
                    Grid.Row="3"
                    Grid.Column="5"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Margin="0,11,0,11"
                    Visibility="{Binding Config.Items[16].IsEnabled, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <CheckBox
                        Margin="0,0,8,0"
                        Content="{Binding Config.Items[16].Name}"
                        IsChecked="{Binding Config.Items[16].IsEnabled, Mode=OneWay}"
                        IsHitTestVisible="False" />
                    <TextBox
                        Width="80"
                        Margin="0,0,8,0"
                        IsReadOnly="True"
                        Text="{Binding Config.Items[16].MesCode, Mode=OneWay}" />
                    <ComboBox
                        Width="190"
                        DisplayMemberPath="Display"
                        IsHitTestVisible="False"
                        ItemsSource="{StaticResource TestModeOptions}"
                        SelectedValue="{Binding Config.Items[16].TestMode, Mode=OneWay}"
                        SelectedValuePath="Value" />
                </StackPanel>

                <!--  Row4：无源测试 | 版本号 | 编译时间  -->
                <StackPanel
                    Grid.Row="4"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Margin="0,11,0,11"
                    Visibility="{Binding Config.Items[15].IsEnabled, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <CheckBox
                        Margin="0,0,8,0"
                        Content="{Binding Config.Items[15].Name}"
                        IsChecked="{Binding Config.Items[15].IsEnabled, Mode=OneWay}"
                        IsHitTestVisible="False" />
                    <TextBox
                        Width="80"
                        Margin="0,0,8,0"
                        IsReadOnly="True"
                        Text="{Binding Config.Items[15].MesCode, Mode=OneWay}" />
                    <ComboBox
                        Width="190"
                        DisplayMemberPath="Display"
                        IsHitTestVisible="False"
                        ItemsSource="{StaticResource TestModeOptions}"
                        SelectedValue="{Binding Config.Items[15].TestMode, Mode=OneWay}"
                        SelectedValuePath="Value" />
                </StackPanel>
                <StackPanel
                    Grid.Row="4"
                    Grid.Column="3"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Margin="0,11,0,11"
                    Visibility="{Binding Config.Items[17].IsEnabled, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <CheckBox
                        Margin="0,0,8,0"
                        Content="{Binding Config.Items[17].Name}"
                        IsChecked="{Binding Config.Items[17].IsEnabled, Mode=OneWay}"
                        IsHitTestVisible="False" />
                    <TextBox
                        Width="80"
                        Margin="0,0,8,0"
                        IsReadOnly="True"
                        Text="{Binding Config.Items[17].MesCode, Mode=OneWay}" />
                    <TextBox
                        Width="130"
                        IsReadOnly="True"
                        Text="{Binding Config.Items[17].Value, Mode=OneWay}" />
                </StackPanel>
                <StackPanel
                    Grid.Row="4"
                    Grid.Column="5"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Margin="0,11,0,11"
                    Visibility="{Binding Config.Items[18].IsEnabled, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <CheckBox
                        Margin="0,0,8,0"
                        Content="{Binding Config.Items[18].Name}"
                        IsChecked="{Binding Config.Items[18].IsEnabled, Mode=OneWay}"
                        IsHitTestVisible="False" />
                    <TextBox
                        Width="80"
                        Margin="0,0,8,0"
                        IsReadOnly="True"
                        Text="{Binding Config.Items[18].MesCode, Mode=OneWay}" />
                    <TextBox
                        Width="140"
                        IsReadOnly="True"
                        Text="{Binding Config.Items[18].Value, Mode=OneWay}" />
                </StackPanel>

                <!--  Row5：IMEI | IMSI | ICCID（状态项：名称 + MES码）  -->
                <StackPanel
                    Grid.Row="5"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Margin="0,11,0,11"
                    Visibility="{Binding Config.Items[8].IsEnabled, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <CheckBox
                        Margin="0,0,8,0"
                        Content="{Binding Config.Items[8].Name}"
                        IsChecked="{Binding Config.Items[8].IsEnabled, Mode=OneWay}"
                        IsHitTestVisible="False" />
                    <TextBox
                        Width="110"
                        IsReadOnly="True"
                        Text="{Binding Config.Items[8].MesCode, Mode=OneWay}" />
                </StackPanel>
                <StackPanel
                    Grid.Row="5"
                    Grid.Column="3"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Margin="0,11,0,11"
                    Visibility="{Binding Config.Items[9].IsEnabled, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <CheckBox
                        Margin="0,0,8,0"
                        Content="{Binding Config.Items[9].Name}"
                        IsChecked="{Binding Config.Items[9].IsEnabled, Mode=OneWay}"
                        IsHitTestVisible="False" />
                    <TextBox
                        Width="110"
                        IsReadOnly="True"
                        Text="{Binding Config.Items[9].MesCode, Mode=OneWay}" />
                </StackPanel>
                <StackPanel
                    Grid.Row="5"
                    Grid.Column="5"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Margin="0,11,0,11"
                    Visibility="{Binding Config.Items[10].IsEnabled, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <CheckBox
                        Margin="0,0,8,0"
                        Content="{Binding Config.Items[10].Name}"
                        IsChecked="{Binding Config.Items[10].IsEnabled, Mode=OneWay}"
                        IsHitTestVisible="False" />
                    <TextBox
                        Width="110"
                        IsReadOnly="True"
                        Text="{Binding Config.Items[10].MesCode, Mode=OneWay}" />
                </StackPanel>

                <!--  Row6：Flash | 蓝牙 | 星闪  -->
                <StackPanel
                    Grid.Row="6"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Margin="0,11,0,11"
                    Visibility="{Binding Config.Items[11].IsEnabled, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <CheckBox
                        Margin="0,0,8,0"
                        Content="{Binding Config.Items[11].Name}"
                        IsChecked="{Binding Config.Items[11].IsEnabled, Mode=OneWay}"
                        IsHitTestVisible="False" />
                    <TextBox
                        Width="110"
                        IsReadOnly="True"
                        Text="{Binding Config.Items[11].MesCode, Mode=OneWay}" />
                </StackPanel>
                <StackPanel
                    Grid.Row="6"
                    Grid.Column="3"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Margin="0,11,0,11"
                    Visibility="{Binding Config.Items[12].IsEnabled, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <CheckBox
                        Margin="0,0,8,0"
                        Content="{Binding Config.Items[12].Name}"
                        IsChecked="{Binding Config.Items[12].IsEnabled, Mode=OneWay}"
                        IsHitTestVisible="False" />
                    <TextBox
                        Width="110"
                        IsReadOnly="True"
                        Text="{Binding Config.Items[12].MesCode, Mode=OneWay}" />
                </StackPanel>
                <StackPanel
                    Grid.Row="6"
                    Grid.Column="5"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Margin="0,11,0,11"
                    Visibility="{Binding Config.Items[13].IsEnabled, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <CheckBox
                        Margin="0,0,8,0"
                        Content="{Binding Config.Items[13].Name}"
                        IsChecked="{Binding Config.Items[13].IsEnabled, Mode=OneWay}"
                        IsHitTestVisible="False" />
                    <TextBox
                        Width="110"
                        IsReadOnly="True"
                        Text="{Binding Config.Items[13].MesCode, Mode=OneWay}" />
                </StackPanel>

                <!--  Row7：甲烷传感器  -->
                <StackPanel
                    Grid.Row="7"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Margin="0,11,0,11"
                    Visibility="{Binding Config.Items[14].IsEnabled, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <CheckBox
                        Margin="0,0,8,0"
                        Content="{Binding Config.Items[14].Name}"
                        IsChecked="{Binding Config.Items[14].IsEnabled, Mode=OneWay}"
                        IsHitTestVisible="False" />
                    <TextBox
                        Width="110"
                        IsReadOnly="True"
                        Text="{Binding Config.Items[14].MesCode, Mode=OneWay}" />
                </StackPanel>
            </Grid>
        </Border>

        <!--  Row2 工位检测区：数量随方案工位数动态生成  -->
        <Border
            Grid.Row="2"
            Padding="10"
            Style="{StaticResource ManagementSurfaceStyle}">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Stations}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <!--  列数随工位数量动态变化：1 个工位占满整行  -->
                            <UniformGrid Columns="{Binding Stations.Count, FallbackValue=3}" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:LaserDetectorStationState}">
                            <Border
                                Margin="10,5"
                                BorderBrush="#44409EFE"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="15">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <!--  工位头状态（背景色随检测状态切换）  -->
                                    <Border Grid.Row="0" Style="{StaticResource StationStatusBorderStyle}">
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                FontSize="16"
                                                FontWeight="Bold"
                                                Foreground="White"
                                                Text="{Binding Station, StringFormat={}{0}号工位}" />
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                FontSize="18"
                                                Foreground="White"
                                                Text="{Binding StatusText}" />
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                FontSize="14"
                                                Foreground="White"
                                                Text="{Binding TestDuration}" />
                                        </StackPanel>
                                    </Border>

                                    <!--  表具条码扫码（失焦或回车触发该工位自动检测）  -->
                                    <StackPanel Grid.Row="1" Margin="0,15,0,0">
                                        <TextBlock FontWeight="SemiBold" Text="表具条码:" />
                                        <TextBox
                                            MinWidth="200"
                                            VerticalAlignment="Center"
                                            KeyDown="BarcodeTextBox_KeyDown"
                                            LostFocus="BarcodeTextBox_LostFocus"
                                            materialDesign:HintAssist.Hint="扫码后自动开始检测"
                                            Text="{Binding EquipmentCode, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>

                                    <!--  人工测试项（LED/蜂鸣器/按键）  -->
                                    <StackPanel Grid.Row="2" Margin="0,15,0,0">
                                        <TextBlock FontWeight="SemiBold" Text="人工测试项:" />
                                        <Grid Margin="5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="80" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBlock
                                                Grid.Row="0"
                                                Grid.Column="0"
                                                VerticalAlignment="Center"
                                                Text="LED:" />
                                            <ComboBox
                                                Grid.Row="0"
                                                Grid.Column="1"
                                                ItemsSource="{x:Static models:LaserDetectorStationState.ManualOptions}"
                                                SelectedItem="{Binding LedResult, Mode=TwoWay}" />
                                            <TextBlock
                                                Grid.Row="1"
                                                Grid.Column="0"
                                                VerticalAlignment="Center"
                                                Text="蜂鸣器:" />
                                            <ComboBox
                                                Grid.Row="1"
                                                Grid.Column="1"
                                                ItemsSource="{x:Static models:LaserDetectorStationState.ManualOptions}"
                                                SelectedItem="{Binding BuzzerResult, Mode=TwoWay}" />
                                            <TextBlock
                                                Grid.Row="2"
                                                Grid.Column="0"
                                                VerticalAlignment="Center"
                                                Text="按键:" />
                                            <ComboBox
                                                Grid.Row="2"
                                                Grid.Column="1"
                                                ItemsSource="{x:Static models:LaserDetectorStationState.ManualOptions}"
                                                SelectedItem="{Binding ButtonResult, Mode=TwoWay}" />
                                        </Grid>
                                    </StackPanel>

                                    <!--  自动测试结果（全部启用配置项，只读红绿展示）  -->
                                    <Expander
                                        Grid.Row="3"
                                        Margin="0,10,0,0"
                                        Header="自动测试结果"
                                        IsExpanded="True">
                                        <ScrollViewer
                                            MaxHeight="300"
                                            HorizontalScrollBarVisibility="Disabled"
                                            VerticalScrollBarVisibility="Auto">
                                            <ItemsControl
                                                ItemTemplate="{StaticResource ResultItemTemplate}"
                                                ItemsSource="{Binding PropertyItems}" />
                                        </ScrollViewer>
                                    </Expander>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
