                                IsReadOnly="True"
                                Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                Text="{Binding Config.Items[3].UpperLimit, Mode=OneWay}"
                                materialDesign:HintAssist.Hint="上限" />
                        </StackPanel>
                        <StackPanel
                            Width="420"
                            Margin="0,4,12,4"
