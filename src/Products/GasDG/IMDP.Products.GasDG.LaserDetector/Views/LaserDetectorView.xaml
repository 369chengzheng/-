                                Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                Text="{Binding Config.Items[3].LowerLimit, Mode=OneWay}"
                                materialDesign:HintAssist.Hint="下限" />
                            <TextBlock Margin="0,0,4,0" Text="~" />
                            <TextBox
