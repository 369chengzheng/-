                                DisplayMemberPath="Display"
                                IsHitTestVisible="False"
                                ItemsSource="{StaticResource TestModeOptions}"
                                SelectedValue="{Binding Config.Items[15].TestMode, Mode=OneWay}"
                                SelectedValuePath="Value" />
                        </StackPanel>

                        <!--  值型（2 输入：单参数值，只读）  -->
                        <StackPanel
                            Width="420"
                            Margin="0,4,12,4"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Visibility="{Binding Config.Items[17].IsEnabled, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <CheckBox
                                Width="130"
                                Margin="0,0,8,0"
                                Content="{Binding Config.Items[17].Name}"
                                IsChecked="{Binding Config.Items[17].IsEnabled, Mode=OneWay}"
                                IsHitTestVisible="False" />
                            <TextBox
                                Width="110"
                                Margin="0,0,4,0"
                                IsReadOnly="True"
                                Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                Text="{Binding Config.Items[17].MesCode, Mode=OneWay}"
                                materialDesign:HintAssist.Hint="MES代码" />
                            <TextBox
                                Width="140"
                                IsReadOnly="True"
                                Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                Text="{Binding Config.Items[17].Value, Mode=OneWay}" />
                        </StackPanel>
                        <StackPanel
                            Width="420"
                            Margin="0,4,12,4"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Visibility="{Binding Config.Items[18].IsEnabled, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <CheckBox
                                Width="130"
                                Margin="0,0,8,0"
                                Content="{Binding Config.Items[18].Name}"
                                IsChecked="{Binding Config.Items[18].IsEnabled, Mode=OneWay}"
                                IsHitTestVisible="False" />
                            <TextBox
                                Width="110"
                                Margin="0,0,4,0"
                                IsReadOnly="True"
                                Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                Text="{Binding Config.Items[18].MesCode, Mode=OneWay}"
                                materialDesign:HintAssist.Hint="MES代码" />
                            <TextBox
                                Width="140"
                                IsReadOnly="True"
                                Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                Text="{Binding Config.Items[18].Value, Mode=OneWay}" />
                        </StackPanel>

                        <!--  状态型（1 输入：仅 MES 代码框，只读）  -->
                        <StackPanel
                            Width="420"
                            Margin="0,4,12,4"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Visibility="{Binding Config.Items[8].IsEnabled, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <CheckBox
                                Width="130"
                                Margin="0,0,8,0"
                                Content="{Binding Config.Items[8].Name}"
                                IsChecked="{Binding Config.Items[8].IsEnabled, Mode=OneWay}"
                                IsHitTestVisible="False" />
                            <TextBox
                                Width="110"
                                IsReadOnly="True"
                                Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                Text="{Binding Config.Items[8].MesCode, Mode=OneWay}"
                                materialDesign:HintAssist.Hint="MES代码" />
                        </StackPanel>
                        <StackPanel
                            Width="420"
                            Margin="0,4,12,4"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Visibility="{Binding Config.Items[9].IsEnabled, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <CheckBox
                                Width="130"
                                Margin="0,0,8,0"
                                Content="{Binding Config.Items[9].Name}"
                                IsChecked="{Binding Config.Items[9].IsEnabled, Mode=OneWay}"
                                IsHitTestVisible="False" />
                            <TextBox
                                Width="110"
                                IsReadOnly="True"
                                Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                Text="{Binding Config.Items[9].MesCode, Mode=OneWay}"
                                materialDesign:HintAssist.Hint="MES代码" />
                        </StackPanel>
                        <StackPanel
                            Width="420"
                            Margin="0,4,12,4"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Visibility="{Binding Config.Items[10].IsEnabled, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <CheckBox
                                Width="130"
                                Margin="0,0,8,0"
                                Content="{Binding Config.Items[10].Name}"
                                IsChecked="{Binding Config.Items[10].IsEnabled, Mode=OneWay}"
                                IsHitTestVisible="False" />
                            <TextBox
                                Width="110"
                                IsReadOnly="True"
                                Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                Text="{Binding Config.Items[10].MesCode, Mode=OneWay}"
                                materialDesign:HintAssist.Hint="MES代码" />
                        </StackPanel>
                        <StackPanel
                            Width="420"
                            Margin="0,4,12,4"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Visibility="{Binding Config.Items[11].IsEnabled, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <CheckBox
                                Width="130"
                                Margin="0,0,8,0"
                                Content="{Binding Config.Items[11].Name}"
                                IsChecked="{Binding Config.Items[11].IsEnabled, Mode=OneWay}"
                                IsHitTestVisible="False" />
                            <TextBox
                                Width="110"
                                IsReadOnly="True"
                                Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                Text="{Binding Config.Items[11].MesCode, Mode=OneWay}"
                                materialDesign:HintAssist.Hint="MES代码" />
                        </StackPanel>
                        <StackPanel
                            Width="420"
                            Margin="0,4,12,4"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Visibility="{Binding Config.Items[12].IsEnabled, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <CheckBox
                                Width="130"
                                Margin="0,0,8,0"
                                Content="{Binding Config.Items[12].Name}"
                                IsChecked="{Binding Config.Items[12].IsEnabled, Mode=OneWay}"
                                IsHitTestVisible="False" />
                            <TextBox
                                Width="110"
                                IsReadOnly="True"
                                Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                Text="{Binding Config.Items[12].MesCode, Mode=OneWay}"
                                materialDesign:HintAssist.Hint="MES代码" />
                        </StackPanel>
                        <StackPanel
                            Width="420"
                            Margin="0,4,12,4"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Visibility="{Binding Config.Items[13].IsEnabled, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <CheckBox
                                Width="130"
                                Margin="0,0,8,0"
                                Content="{Binding Config.Items[13].Name}"
                                IsChecked="{Binding Config.Items[13].IsEnabled, Mode=OneWay}"
                                IsHitTestVisible="False" />
                            <TextBox
                                Width="110"
                                IsReadOnly="True"
                                Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                Text="{Binding Config.Items[13].MesCode, Mode=OneWay}"
                                materialDesign:HintAssist.Hint="MES代码" />
                        </StackPanel>
                        <StackPanel
                            Width="420"
                            Margin="0,4,12,4"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Visibility="{Binding Config.Items[14].IsEnabled, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <CheckBox
                                Width="130"
                                Margin="0,0,8,0"
                                Content="{Binding Config.Items[14].Name}"
                                IsChecked="{Binding Config.Items[14].IsEnabled, Mode=OneWay}"
                                IsHitTestVisible="False" />
                            <TextBox
                                Width="110"
                                IsReadOnly="True"
                                Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                Text="{Binding Config.Items[14].MesCode, Mode=OneWay}"
                                materialDesign:HintAssist.Hint="MES代码" />
                        </StackPanel>

                        <!--  全局项（无勾选框、无 MES 框，只读），固定排在配置项最后方，与配置界面一致  -->
                        <StackPanel
                            Width="420"
                            Margin="0,4,12,4"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                            <TextBlock
                                Width="130"
                                Margin="0,0,8,0"
                                Text="工位数量:" />
                            <TextBox
                                Width="110"
                                IsReadOnly="True"
                                Text="{Binding StationCount, Mode=OneWay}" />
                        </StackPanel>
                        <StackPanel
                            Width="420"
                            Margin="0,4,12,4"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                            <TextBlock
                                Width="130"
                                Margin="0,0,8,0"
                                Text="最大测试时间(秒):" />
                            <TextBox
                                Width="110"
                                IsReadOnly="True"
                                Text="{Binding MaxTestTimeout, Mode=OneWay}" />
                        </StackPanel>
                    </WrapPanel>
                </Border>

                <!--
                    工位检测区（表格化，与检测平台截图一致）：
                    表头行（工位号+串口名）→ 统一结果表格（行=序号+项目名，列=工位）：
                    1 红外串口 → 2 检测状态 → 3 LED → 4 蜂鸣器 → 5 按键
                    （人工下拉，默认"正常"，不加底色）→ 6 表具条码（扫码+自动跳下一工位）
                    → 7..n 配置的检测项（自动结果红绿单元格）；
                    行模板按 Kind 分派：Auto 文本 / Manual 下拉 / Barcode 扫码框
                -->
                <Border
                    Grid.Row="1"
                    Padding="10"
                    Style="{StaticResource ManagementSurfaceStyle}">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <StackPanel>

                            <!--  表头行：序号 | 检测项目 | 工位01..n（工位名 + 已打开串口名）  -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="45" />
                                    <ColumnDefinition Width="95" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <!--  序号列表头（第 1 列，与下方各行序号格对齐）  -->
                                <Border
                                    Grid.Column="0"
                                    Margin="0,0,2,2"
                                    Padding="4"
                                    Background="#3F51B5">
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontWeight="Bold"
                                        Foreground="White"
                                        Text="序号"
                                        TextAlignment="Center" />
                                </Border>
                                <!--  检测项目列表头（第 2 列，与下方各行项目名格对齐）  -->
                                <Border
                                    Grid.Column="1"
                                    Margin="0,0,2,2"
                                    Padding="4"
                                    Background="#3F51B5">
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontWeight="Bold"
                                        Foreground="White"
                                        Text="检测项目"
                                        TextAlignment="Center" />
                                </Border>
                                <!--  工位列表头（UniformGrid 均分，与下方各行工位列对齐）  -->
                                <ItemsControl Grid.Column="2" ItemsSource="{Binding Stations}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="{Binding DataContext.StationCount, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border
                                                Margin="2,0,0,2"
                                                Padding="4"
                                                Background="#3F51B5">
                                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock
                                                        FontSize="14"
                                                        FontWeight="Bold"
                                                        Foreground="White"
                                                        Text="{Binding Station, StringFormat='工位{0:D2}'}"
                                                        TextAlignment="Center" />
                                                    <TextBlock
                                                        FontSize="11"
                                                        Foreground="#E8EAF6"
                                                        Text="{Binding DataContext.OpenedPortName, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        TextAlignment="Center" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>

                            <!--  统一结果表格：行 = 固定行（1-6）+ 配置项行（7..n），列 = 工位  -->
                            <ItemsControl ItemsSource="{Binding ResultRows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="45" />
                                                <ColumnDefinition Width="95" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border
                                                Grid.Column="0"
                                                Margin="0,0,2,2"
                                                Padding="4"
                                                Background="#F5F5F5"
                                                BorderBrush="#DDDDDD"
                                                BorderThickness="0,0,2,2">
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    Text="{Binding Index}"
                                                    TextAlignment="Center" />
                                            </Border>
                                            <Border
                                                Grid.Column="1"
                                                Margin="0,0,2,2"
                                                Padding="4"
                                                Background="#F5F5F5"
                                                BorderBrush="#DDDDDD"
                                                BorderThickness="0,0,2,2">
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    Text="{Binding Name}"
                                                    TextAlignment="Center"
                                                    TextWrapping="Wrap" />
                                            </Border>
                                            <ItemsControl Grid.Column="2" ItemsSource="{Binding Cells}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <UniformGrid Columns="{Binding DataContext.StationCount, FallbackValue=3, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border
                                                            MinHeight="34"
                                                            Margin="2,0,0,2"
                                                            Padding="4"
                                                            CornerRadius="2">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <!--  默认中性底色（条码行/待检测占位）  -->
                                                                    <Setter Property="Background" Value="#FAFAFA" />
                                                                    <Style.Triggers>
                                                                        <!--  底色模式：ViewModel 按行语义写入（绿=通过/正常，红=未过/异常，橙=进行中）  -->
                                                                        <DataTrigger Binding="{Binding ColorMode}" Value="green">
                                                                            <Setter Property="Background" Value="#4CAF50" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding ColorMode}" Value="red">
                                                                            <Setter Property="Background" Value="#F44336" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding ColorMode}" Value="orange">
                                                                            <Setter Property="Background" Value="#FF9800" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <Grid>
                                                                <Grid.Resources>
                                                                    <!--  配色单元格内文本：有底色时白字（条码行/中性行黑字）  -->
                                                                    <Style x:Key="CellTextStyle" TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="#212121" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding ColorMode}" Value="green">
                                                                                <Setter Property="Foreground" Value="White" />
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding ColorMode}" Value="red">
                                                                                <Setter Property="Foreground" Value="White" />
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding ColorMode}" Value="orange">
                                                                                <Setter Property="Foreground" Value="White" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Grid.Resources>
                                                                <!--  条码行：扫码输入框（回车触发检测 + 自动跳下一工位）  -->
                                                                <TextBox
                                                                    MinWidth="120"
                                                                    VerticalAlignment="Center"
                                                                    HorizontalContentAlignment="Center"
                                                                    behaviors:FocusNext.TargetKey="{Binding Station}"
                                                                    behaviors:LostFocus.Command="{Binding DataContext.StationScanCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    behaviors:LostFocus.CommandParameter="{Binding Station}"
                                                                    Text="{Binding EquipmentCode, UpdateSourceTrigger=PropertyChanged}"
                                                                    Visibility="{Binding DataContext.Kind, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource RowKindToBarcodeVisibilityConverter}}">
                                                                    <TextBox.InputBindings>
                                                                        <KeyBinding
                                                                            Key="Enter"
                                                                            Command="{Binding DataContext.StationScanCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                            CommandParameter="{Binding Station}" />
                                                                    </TextBox.InputBindings>
                                                                </TextBox>
                                                                <!--  人工行：正常/异常下拉（默认正常，选异常红底）  -->
                                                                <ComboBox
                                                                    MinWidth="90"
                                                                    VerticalAlignment="Center"
                                                                    HorizontalContentAlignment="Center"
                                                                    ItemsSource="{x:Static models:LaserDetectorStationState.ManualOptions}"
                                                                    SelectedItem="{Binding ManualResult, Mode=TwoWay}"
                                                                    Visibility="{Binding DataContext.Kind, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource RowKindToManualVisibilityConverter}}" />
                                                                <!--  自动行：实测值文本（红绿底白字，中性底黑字）  -->
                                                                <TextBlock
                                                                    VerticalAlignment="Center"
                                                                    Style="{StaticResource CellTextStyle}"
                                                                    Text="{Binding Value}"
                                                                    TextAlignment="Center"
                                                                    TextTrimming="CharacterEllipsis"
                                                                    Visibility="{Binding DataContext.Kind, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource RowKindToAutoVisibilityConverter}}" />
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
