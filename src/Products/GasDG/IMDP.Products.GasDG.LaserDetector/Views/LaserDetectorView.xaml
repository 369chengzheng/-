<!--
    =============================================================================
    文件名：LaserDetectorView.xaml
    功能描述：激光检测仪校验界面（参考 IMDS 项目移植）。按方案工位数量动态
    生成工位卡片；扫码触发自动测试 → 全部配置项只读结果展示 →
    人工测试项（LED/蜂鸣器/按键）→ 综合判定。
    分层卡片式布局（与 LaserDetectorConfigView 配置界面同风格）：
      Row0 面包屑导航：首页 > 物料编码(CurrentMaterialNumber，为空自动隐藏) > 当前页面名；
      Row1 操作条：左侧产品编码输入框（回车/空格/失焦加载方案），
                   右侧串口选择与打开/关闭串口按钮 + 配置面板折叠/展开箭头；
      Row2 配置预览面板：无 GroupBox 分区，统一 WrapPanel 陈列（只读、仅显示已启用项），
                   每项一个固定宽度(420)横向 StackPanel = 配置名 + MES代码框 + 可选参数区，
                   按输入控件数量由多到少排序：范围型(3输入) > 下拉型/值型(2输入)
                   > 状态型(1输入)，未启用项整项收起不占位；
                   工位数量、最大测试时间作为全局项（只读）固定排在配置项最后方；
      Row3 工位检测区：表格化布局（表头行 + 统一结果表格）。
    保留 Ctrl+鼠标滚轮整体缩放（0.5~3.0）与配置面板折叠/展开交互。
    =============================================================================
-->
<UserControl
    x:Class="IMDP.Products.GasDG.LaserDetector.Views.LaserDetectorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="clr-namespace:IMDP.Products.GasDG.LaserDetector.Views.Behaviors"
    xmlns:converters="clr-namespace:IMDP.Products.GasDG.LaserDetector.Views.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="clr-namespace:IMDP.Products.GasDG.LaserDetector.Models"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:viewmodels="clr-namespace:IMDP.Products.GasDG.LaserDetector.ViewModels"
    d:DataContext="{d:DesignInstance Type=viewmodels:LaserDetectorViewModel}"
    d:DesignHeight="900"
    d:DesignWidth="1920"
    prism:ViewModelLocator.AutoWireViewModel="True"
    Background="{StaticResource ImdpPageBackgroundBrush}"
    FontFamily="{DynamicResource MaterialDesignFont}"
    mc:Ignorable="d">
    <UserControl.Resources>
        <!--  行类型可见性转换器：Auto=实测值文本 / Manual=人工下拉 / Barcode=扫码框  -->
        <converters:AutoRowToVisibilityConverter x:Key="RowKindToAutoVisibilityConverter" />
        <converters:ManualRowToVisibilityConverter x:Key="RowKindToManualVisibilityConverter" />
        <converters:BarcodeRowToVisibilityConverter x:Key="RowKindToBarcodeVisibilityConverter" />
        <!--  测试方式下拉选项（有源/无源共用，与配置界面一致）  -->
        <x:Array x:Key="TestModeOptions" Type="models:ConfigModeOption">
            <models:ConfigModeOption Display="01-仅测试输出功能" Value="01" />
            <models:ConfigModeOption Display="02-测试输入和输出功能" Value="02" />
        </x:Array>
        <!--  只读文本统一隐式样式：左对齐垂直居中  -->
        <Style TargetType="TextBlock">
            <Setter Property="TextAlignment" Value="Left" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Row0 面包屑导航：独立白色横条（首页 > 物料编码 > 当前页面名）  -->
        <Border
            Grid.Row="0"
            Margin="0,0,0,10"
            Padding="28,8"
            Style="{StaticResource ManagementSurfaceStyle}">
            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                <Button
                    Command="{Binding GoHomeCommand}"
                    Content="首页"
                    Style="{StaticResource BreadcrumbButtonStyle}" />
                <TextBlock Style="{StaticResource BreadcrumbSeparatorStyle}" Text="&gt;" />
                <!--  物料编码段：编码为空时整段隐藏（连同其后分隔符）  -->
                <StackPanel Orientation="Horizontal">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentMaterialNumber}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Style="{StaticResource BreadcrumbCurrentStyle}" Text="{Binding CurrentMaterialNumber}" />
                    <TextBlock Style="{StaticResource BreadcrumbSeparatorStyle}" Text="&gt;" />
                </StackPanel>
                <TextBlock Style="{StaticResource BreadcrumbCurrentStyle}" Text="激光检测仪模块检测" />
            </StackPanel>
        </Border>

        <!--  Row1 操作条：独立白色横条（左：产品编码+工位数量；右：串口选择/开关 + 折叠箭头）  -->
        <Border
            Grid.Row="1"
            Margin="0,0,0,10"
            Padding="28,8"
            Style="{StaticResource ManagementSurfaceStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!--  左：产品编码（回车/空格（KeyBinding）与失焦（附加行为）均触发加载方案）；
                      工位数量、最大测试时间已移至下方配置预览面板最后方  -->
                <StackPanel
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <TextBlock Margin="0,0,8,0" Text="产品编码:" />
                    <TextBox
                        Width="200"
                        behaviors:LostFocus.Command="{Binding ProductLostFocusCommand}"
                        Text="{Binding ProductCode, UpdateSourceTrigger=PropertyChanged}">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding ProductLostFocusCommand}" />
                            <KeyBinding Key="Space" Command="{Binding ProductLostFocusCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                </StackPanel>

                <!--  右：串口选择与打开/关闭 + 配置面板折叠/展开箭头  -->
                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <TextBlock
                        Margin="5,0"
                        VerticalAlignment="Center"
                        Text="串口选择:" />
                    <ComboBox
                        Width="120"
                        Margin="5,0"
                        behaviors:DropDownOpened.Command="{Binding RefreshPortsCommand}"
                        ItemsSource="{Binding Ports}"
                        SelectedItem="{Binding SelectedPort}" />
                    <Button
                        Width="90"
                        Height="40"
                        Margin="5,0"
                        Command="{Binding OpenSerialCommand}"
                        Content="打开串口"
                        IsEnabled="{Binding CanOpenSerial}"
                        Style="{StaticResource SemanticSuccessButtonStyle}" />
                    <Button
                        Width="90"
                        Height="40"
                        Margin="5,0"
                        Command="{Binding CloseSerialCommand}"
                        Content="关闭串口"
                        IsEnabled="{Binding IsSerialOpen}"
                        Style="{StaticResource SemanticDangerButtonStyle}" />
                    <!--  配置面板折叠（上箭头）：收起常态化配置预览面板  -->
                    <Button
                        x:Name="ButtonCloseMenu"
                        Width="90"
                        Height="40"
                        Margin="5,0"
                        Click="ButtonCloseMenu_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border
                                    x:Name="Bd"
                                    Background="#05b790"
                                    CornerRadius="10">
                                    <materialDesign:PackIcon
                                        Width="25"
                                        Height="25"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Foreground="White"
                                        Kind="ArrowUp" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Opacity" Value="0.88" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <!--  配置面板展开（下箭头）：默认隐藏，收起后出现  -->
                    <Button
                        x:Name="ButtonOpenMenu"
                        Width="90"
                        Height="40"
                        Margin="5,0"
                        Click="ButtonOpenMenu_Click"
                        Visibility="Collapsed">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border
                                    x:Name="Bd"
                                    Background="#05b790"
                                    CornerRadius="10">
                                    <materialDesign:PackIcon
                                        Width="25"
                                        Height="25"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Foreground="White"
                                        Kind="ArrowDown" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Opacity" Value="0.88" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!--
            Row2 可缩放内容区：Ctrl+滚轮整体缩放（0.5~3.0），配置预览面板与工位区统一由
            外层 ScrollViewer 滚动（工位区不再嵌套内层滚动）
        -->
        <ScrollViewer
            Grid.Row="2"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.LayoutTransform>
                    <ScaleTransform x:Name="ScaleTransform" ScaleX="1" ScaleY="1" />
                </Grid.LayoutTransform>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--
                    Row2 配置预览面板：与配置界面同风格的统一 WrapPanel 布局（只读、常态化显示）。
                    仅显示已启用的配置项（未启用项整项收起不占位，后续项连续向前靠拢补位）；
                    每 StackPanel 固定 Width=420（内部控件宽度亦固定），隐藏项收起后其余项
                    仍按固定槽位对齐；按输入控件数量由多到少排序：
                    范围型(3输入) > 下拉型/值型(2输入) > 状态型(1输入)；
                    可通过操作条上箭头折叠收起（动画过渡），下箭头重新展开
                -->
                <Border
                    x:Name="GridMenu"
                    Grid.Row="0"
                    Margin="0,0,0,10"
                    Padding="20,12"
                    Style="{StaticResource ManagementSurfaceStyle}">
                    <WrapPanel>
                        <!--  范围型（3 输入：下限~上限）：只读  -->
                        <StackPanel
                            Width="420"
                            Margin="0,4,12,4"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Visibility="{Binding Config.Items[0].IsEnabled, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <CheckBox
                                Width="130"
                                Margin="0,0,8,0"
                                Content="{Binding Config.Items[0].Name}"
                                IsChecked="{Binding Config.Items[0].IsEnabled, Mode=OneWay}"
                                IsHitTestVisible="False" />
                            <TextBox
                                Width="110"
                                Margin="0,0,4,0"
                                IsReadOnly="True"
                                Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                Text="{Binding Config.Items[0].MesCode, Mode=OneWay}"
                                materialDesign:HintAssist.Hint="MES代码" />
                            <TextBox
                                Width="60"
                                Margin="0,0,4,0"
                                IsReadOnly="True"
                                Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                Text="{Binding Config.Items[0].LowerLimit, Mode=OneWay}"
                                materialDesign:HintAssist.Hint="下限" />
                            <TextBlock Margin="0,0,4,0" Text="~" />
                            <TextBox
                                Width="60"
                                IsReadOnly="True"
                                Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                Text="{Binding Config.Items[0].UpperLimit, Mode=OneWay}"
                                materialDesign:HintAssist.Hint="上限" />
                        </StackPanel>
                        <StackPanel
                            Width="420"
                            Margin="0,4,12,4"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Visibility="{Binding Config.Items[1].IsEnabled, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <CheckBox
                                Width="130"
                                Margin="0,0,8,0"
                                Content="{Binding Config.Items[1].Name}"
                                IsChecked="{Binding Config.Items[1].IsEnabled, Mode=OneWay}"
                                IsHitTestVisible="False" />
                            <TextBox
                                Width="110"
                                Margin="0,0,4,0"
                                IsReadOnly="True"
                                Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                Text="{Binding Config.Items[1].MesCode, Mode=OneWay}"
                                materialDesign:HintAssist.Hint="MES代码" />
                            <TextBox
                                Width="60"
                                Margin="0,0,4,0"
                                IsReadOnly="True"
                                Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                Text="{Binding Config.Items[1].LowerLimit, Mode=OneWay}"
                                materialDesign:HintAssist.Hint="下限" />
                            <TextBlock Margin="0,0,4,0" Text="~" />
                            <TextBox
